 \"base\": \"b6099c6eddd51c8d6ce0c75f100d129038a8aa22\"\n        },\n        {\n          \"branch\": \"codex/prove-payment-account-attachment-serialization\",\n          \"head\": \"6a312acb5736c2cf662e01b807c2d368583f236e\",\n          \"base\": \"342050c95eaa0912bd49534a845d7f9d23abe8b0\"\n        },\n        {\n          \"branch\": \"codex/add-private-payment-account-setup-route\",\n          \"head\": \"b7103b24de0d5fb1733c3c36440f7a46f3680010\",\n          \"base\": \"6a312acb5736c2cf662e01b807c2d368583f236e\"\n        },\n        {\n          \"branch\": \"codex/refresh-default-application-theme\",\n          \"head\": \"01f03d2218f329162a450fa956377e6c15d877f5\",\n          \"base\": \"b7103b24de0d5fb1733c3c36440f7a46f3680010\"\n        },\n        {\n          \"branch\": \"codex/report-client-failures-safely\",\n          \"head\": \"d9c13061eabc8fa975add4a64a004b8660dab43a\",\n          \"base\": \"01f03d2218f329162a450fa956377e6c15d877f5\"\n        },\n        {\n          \"branch\": \"codex/simplify-shared-form-controls\",\n          \"head\": \"f1f6957837e18c4b6e63f208f4d501eb004494fa\",\n          \"base\": \"d9c13061eabc8fa975add4a64a004b8660dab43a\"\n        },\n        {\n          \"branch\": \"codex/clarify-application-access-boundaries\",\n          \"head\": \"352dce1140aa627e5bdc194615c99b8de93e1cc5\",\n          \"base\": \"f1f6957837e18c4b6e63f208f4d501eb004494fa\"\n        },\n        {\n          \"branch\": \"codex/serialize-and-bound-ticket-check-in\",\n          \"head\": \"278fc0975d71c9704cdf456323acff24e3c70d62\",\n          \"base\": \"352dce1140aa627e5bdc194615c99b8de93e1cc5\"\n        },\n        {\n          \"branch\": \"codex/make-scanner-recovery-explicit\",\n          \"head\": \"21aa5e53ef81f69843a9514abd1283eb864f4ab8\",\n          \"base\": \"278fc0975d71c9704cdf456323acff24e3c70d62\"\n        },\n        {\n          \"branch\": \"codex/use-plain-scanner-and-addon-language\",\n          \"head\": \"89c48356e0153246a7994
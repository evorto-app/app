{"timestamp":"2026-08-06T04:33:21.149Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1708755049,"cached_input_tokens":1679373824,"cache_write_input_tokens":0,"output_tokens":2559837,"reasoning_output_tokens":911699,"total_tokens":1711314886},"last_token_usage":{"input_tokens":45346,"cached_input_tokens":41728,"cache_write_input_tokens":0,"output_tokens":312,"reasoning_output_tokens":211,"total_tokens":45658},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":null,"secondary":null,"credits":{"has_credits":true,"unlimited":true,"balance":null},"individual_limit":null,"spend_control_reached":null,"plan_type":"business","rate_limit_reached_type":null}}}

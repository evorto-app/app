{"timestamp":"2026-08-06T04:33:37.885Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd559-285d-7b70-be81-86cc796c3076","call_id":"call_vGQaaFobip3m6APTkEsllPDD","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"d9c13061eab fix: report client failures safely\n .changeset/simplify-shared-client-foundations.md   |  5 +-\n src/app/app.config.spec.ts                         | 42 ++++++++++\n src/app/app.config.ts                              | 14 +++-\n src/app/core/browser-error-handler.ts              |  6 +-\n src/app/core/effect-rpc-angular-client.spec.ts     | 49 ++++++-----\n src/app/core/effect-rpc-angular-client.ts          | 64 +++++++--------\n src/app/core/error-message.spec.ts                 | 96 ++++++++++++++++++++++\n src/app/core/error-message.ts                      | 52 +++++-------\n src/app/core/error/error.component.ts              | 13 ++-\n .../event-active-registration.component.spec.ts    |  7 +-\n .../tenant-form/tenant-form.model.spec.ts          |  2 +-\n .../tenant-list/tenant-list.rows.spec.ts           |  4 +-\n .../category-list/category-list.component.spec.ts  |  1 +\n .../category-list/category-list.component.ts       |  4 +-\n .../template-create-event.component.spec.ts        |  6 +-\n .../browser-error-telemetry.web-handler.spec.ts    | 89 +++++++++++++++++---\n .../http/browser-error-telemetry.web-handler.ts    | 71 ++++++++++------\n src/shared/browser-error-telemetry.spec.ts         | 34 ++++++++\n src/shared/browser-error-telemetry.ts              | 55 +++++++++++++\n 19 files changed, 471 insertions(+), 143 deletions(-)\ncommit d9c13061eabc8fa975add4a64a004b8660dab43a\nAuthor:     Lukas heddendorp <lu.heddendorp@gmail.com>\nAuthorDate: Wed Aug 5 21:07:20 2026 +0200\nCommit:     Lukas heddendorp <lu.heddendorp@gmail.com>\nCommitDate: Thu Aug 6 02:49:46 2026 +0200\n\n    fix: report client failures safely\n\ndiff --git a/src/app/app.config.spec.ts b/src/app/app.config.spec.ts\nnew file mode 100644\nindex 00000000000..b6f6a1f6ace\n--- /dev/null\n+++ b/src/app/app.config.spec.ts\n@@ -0,0 +1,42 @@\n+import { TestBed } from '@angular/core/testing';\n+import { IS_DISCOVERING_ROUTES } from '@angular/ssr';\n+import { afterEach, describe, expect, it, vi } from 'vitest';\n+\n+import { initializeApplicationConfig } from './app.config';\n+import { ConfigService } from './core/config.service';\n+\n+describe('application configuration initialization', () => {\n+  afterEach(() => {\n+    TestBed.resetTestingModule();\n+  });\n+\n+  it('does not construct ConfigService during route discovery', async () => {\n+    const configFactory = vi.fn(() => ({\n+      initialize: vi.fn(),\n+    }));\n+    TestBed.configureTestingModule({\n+      providers: [\n+        { provide: IS_DISCOVERING_ROUTES, useValue: true },\n+        { provide: ConfigService, useFactory: configFactory },\n+      ],\n+    });\n+\n+    await TestBed.runInInjectionContext(initializeApplicationConfig);\n+\n+    expect(configFactory).not.toHaveBeenCalled();\n+  });\n+\n+  it('initializes ConfigService outside route discovery', async () => {\n+    const initialize = vi.fn();\n+    TestBed.configureTestingModule({\n+      providers: [\n+        { provide: IS_DISCOVERING_ROUTES, useValue: false },\n+        { provide: ConfigService, useValue: { initialize } },\n+      ],\n+    });\n+\n+    await TestBed.runInInjectionContext(initializeApplicationConfig);\n+\n+    expect(initialize).toHaveBeenCalledOnce();\n+  });\n+});\ndiff --git a/src/app/app.config.ts b/src/app/app.config.ts\nindex 1b200f6244f..4fc26a62523 100644\n--- a/src/app/app.config.ts\n+++ b/src/app/app.config.ts\n@@ -28,6 +28,7 @@ import {\n   withRouterConfig,\n   withViewTransitions,\n } from '@angular/router';\n+import { IS_DISCOVERING_ROUTES } from '@angular/ssr';\n import {\n   provideEffectHttpClient,\n   provideEffectRpcProtocolHttpLayer,\n@@ -47,6 +48,14 @@ import {\n   t
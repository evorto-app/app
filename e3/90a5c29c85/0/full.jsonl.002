{"timestamp":"2026-08-06T08:36:40.325Z","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1751357138,"cached_input_tokens":1721091328,"cache_write_input_tokens":0,"output_tokens":2609712,"reasoning_output_tokens":927949,"total_tokens":1753966850},"last_token_usage":{"input_tokens":73743,"cached_input_tokens":70400,"cache_write_input_tokens":0,"output_tokens":162,"reasoning_output_tokens":139,"total_tokens":73905},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":null,"secondary":null,"credits":{"has_credits":true,"unlimited":true,"balance":null},"individual_limit":null,"spend_control_reached":null,"plan_type":"business","rate_limit_reached_type":null}}}

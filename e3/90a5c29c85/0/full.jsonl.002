d_parent=\"$previous_head\"\n  fi\n  if [ \"$base\" != \"$expected_parent\" ] || [ \"$actual_parent\" != \"$expected_parent\" ]; then\n    printf 'position %s parent mismatch: stack_base=%s actual_parent=%s expected=%s\\n' \\\n      \"$position\" \"$base\" \"$actual_parent\" \"$expected_parent\" >&2\n    exit 1\n  fi\n\n  tree=$(git -C \"$clone_repo\" show -s --format=%T \"$head\")\n  subject=$(git -C \"$clone_repo\" show -s --format=%s \"$head\" | tr '\\t\\r\\n' '   ')\n  printf '%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n' \\\n    \"$position\" \"$branch\" \"$head\" \"$gh_head\" \"$base\" \"$actual_parent\" \"$tree\" \"$subject\" >>\"$manifest_tsv\"\n  jq -cn \\\n    --argjson position \"$position\" \\\n    --arg branch \"$branch\" \\\n    --arg head \"$head\" \\\n    --arg gh_head \"$gh_head\" \\\n    --arg stack_base \"$base\" \\\n    --arg actual_parent \"$actual_parent\" \\\n    --arg tree \"$tree\" \\\n    --arg subject \"$subject\" \\\n    '{position:$position,branch:$branch,head:$head,gh_head:$gh_head,stack_base:$stack_base,actual_parent:$actual_parent,tree:$tree,subject:$subject}' >>\"$manifest_jsonl\"\n\n  previous_head=\"$head\"\n  position=$((position + 1))\ndone\n\njq -s \\\n  --arg captured_at \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n  --arg source_repo \"$source_repo\" \\\n  --arg clone_repo \"$clone_repo\" \\\n  --argjson stack_count \"$stack_count\" \\\n  '{captured_at:$captured_at,source_repo:$source_repo,clone_repo:$clone_repo,stack_count:$stack_count,positions:.}' \\\n  \"$manifest_jsonl\" >\"$manifest_json\"\n\ntest \"$(jq '.positions | length' \"$manifest_json\")\" -eq 27\ntest \"$(jq -r '.positions[22].head' \"$manifest_json\")\" = \"67b875cf10e6bf7fd67ddde35c788e3e1a15acb6\"\ntest -z \"$(git -C \"$clone_repo\" remote)\"\n\nprintf 'manifest_ok positions=27 head1=%s head23=%s\\n' \\\n  \"$(jq -r '.positions[0].head' \"$manifest_json\")\" \\\n  \"$(jq -r '.positions[22].head' \"$manifest_json\")\"\n"}],"internal_chat_message_metadata_passthrough":{"
{"timestamp":"2026-08-06T11:03:59.342Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd6be-8a6e-7130-a254-d2e33cb280bf","call_id":"call_ltGkGm0vqEmjbMPafM8RsKUY","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"View the current stack as a list showing branches and PR status.\n\nStatus icons:\n  ✓  PR merged\n  ◎  PR queued\n  ○  PR open\n  ⚠  Needs rebase\n\nThe current branch is highlighted. Use --short for a compact one-line-per-branch\nview, or --json for machine-readable output.\n\nUsage:\n  gh stack view [flags]\n\nExamples:\n  # Show the stack (default interactive view)\n  $ gh stack view\n\n  # Show compact output\n  $ gh stack view --short\n\n  # Output as JSON\n  $ gh stack view --json\n\nFlags:\n  -h, --help    help for view\n      --json    Output stack data as JSON\n  -s, --short   Show compact output\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

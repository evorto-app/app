{"timestamp":"2026-08-06T09:59:56.874Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd683-e8c9-7973-a625-f28631176caf","call_id":"call_dEwWmNTbFjdzPOuCzwROruvA","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":"services:\n  db:\n    image: postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193\n    restart: unless-stopped\n    environment:\n      POSTGRES_DB: \"${POSTGRES_DB:-appdb}\"\n      POSTGRES_PASSWORD: \"${POSTGRES_PASSWORD:-evorto-local}\"\n      POSTGRES_USER: \"${POSTGRES_USER:-evorto}\"\n    volumes:\n      - postgres-data:/var/lib/postgresql/data\n    ports:\n      - \"127.0.0.1:${POSTGRES_HOST_PORT:-55432}:5432\"\n    healthcheck:\n      test:\n        [\n          \"CMD-SHELL\",\n          \"pg_isready -h 127.0.0.1 -p 5432 -U ${POSTGRES_USER:-evorto} -d ${POSTGRES_DB:-appdb}\",\n        ]\n      interval: 5s\n      timeout: 5s\n      retries: 20\n      start_period: 10s\n\n  db-setup:\n    build:\n      context: .\n      target: build\n      secrets:\n        - FONT_AWESOME_TOKEN\n    depends_on:\n      db:\n        condition: service_healthy\n    environment:\n      DATABASE_URL: postgresql://${POSTGRES_USER:-evorto}:${POSTGRES_PASSWORD:-evorto-local}@db:5432/${POSTGRES_DB:-appdb}?sslmode=disable\n      E2E_NOW_ISO:\n      E2E_SEED_KEY:\n      LOCAL_DATABASE: \"true\"\n      LOCAL_DATABASE_CONFIRM_RESET: evorto-local-reset\n      STRIPE_TEST_ACCOUNT_ID:\n    command:\n      - /bin/sh\n      - -lc\n      - bun helpers/reset-database-schema.ts && bun ./node_modules/drizzle-kit/bin.cjs push --force && bun helpers/database.ts\n    restart: \"no\"\n\n  mailpit:\n    image: axllent/mailpit:v1.28.2@sha256:28a161f4a39c70671d0fb771a6e7a3abe6d2144c0e2a595ff72767ab63cd14f6\n    restart: unless-stopped\n    environment:\n      MP_DATABASE: /data/mailpit.db\n      MP_MAX_MESSAGES: \"500\"\n      MP_SEND_API_AUTH_ACCEPT_ANY: \"true\"\n    ports:\n      - \"127.0.0.1:${MAILPIT_HOST_PORT:-8025}:8025\"\n    volumes:\n      - mailpit-data:/data\n\n  minio:\n    image: minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e\n    command: server /data --console-address \":9001\"\n    environment:\n      MINIO_API_CORS_ALLOW_ORIGIN: \"http://localhost:${APP_HOST_PORT:-4200}\"\n      MINIO_ROOT_PASSWORD: \"${MINIO_ROOT_PASSWORD:-minioadmin}\"\n      MINIO_ROOT_USER: \"${MINIO_ROOT_USER:-minioadmin}\"\n    ports:\n      - \"127.0.0.1:${MINIO_HOST_PORT:-9000}:9000\"\n      - \"127.0.0.1:${MINIO_CONSOLE_HOST_PORT:-9001}:9001\"\n    healthcheck:\n      test: [\"CMD\", \"curl\", \"-f\", \"http://127.0.0.1:9000/minio/health/live\"]\n      interval: 5s\n      timeout: 5s\n      retries: 20\n      start_period: 10s\n\n  minio-init:\n    image: minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727\n    depends_on:\n      minio:\n        condition: service_healthy\n    environment:\n      MINIO_ROOT_PASSWORD: \"${MINIO_ROOT_PASSWORD:-minioadmin}\"\n      MINIO_ROOT_USER: \"${MINIO_ROOT_USER:-minioadmin}\"\n      S3_BUCKET: \"${S3_BUCKET:-evorto-testing}\"\n    entrypoint: /bin/sh\n    command:\n      - -c\n      - |\n        mc alias set local http://minio:9000 \"$${MINIO_ROOT_USER}\" \"$${MINIO_ROOT_PASSWORD}\"\n        mc mb --ignore-existing \"local/$${S3_BUCKET}\"\n    restart: \"no\"\n\n  evorto:\n    build:\n      context: .\n      secrets:\n        - FONT_AWESOME_TOKEN\n    depends_on:\n      db:\n        condition: service_healthy\n      db-setup:\n        condition: service_completed_successfully\n      minio:\n        condition: service_healthy\n      minio-init:\n        condition: service_completed_successfully\n      stripe:\n        condition: service_healthy\n    develop:\n      watch:\n        - action: rebuild\n          path: ./src\n        - action: rebuild\n          path: package.json\n    environment:\n      APP_ENVIRONMENT: local\n      APP_ROLE: web\n      BASE_URL: http://localhost:${APP_HOST_PORT:-4200}\n      CLIENT_ID:\n      CLIENT_SECRET:\n      DATABASE_POOL_MAX: \"20\"\n      DATABASE_URL: postgresql://${POSTGRES_USER:-evorto}:${POSTGRES_PASSWORD:-evorto-local}@db:5432/${POSTGRES_DB:-appdb}?sslmode=disable\n      E2E_GLOBAL_ADMIN_AUTH0_IDS:\n      E2E_NOW_ISO:\n      E2E_RUNTIME_MODE:\n      E2E_SEED_KEY:\n      ISSUER_BASE_URL:\n      LOCAL_DATABASE: \"true\"\n      NODE_ENV: \"development\"\n      PORT: \"4200\"\n      PUBLIC_GOOGLE_MAPS_API_KEY:\n      S3_ACCESS_KEY_ID: \"${MINIO_ROOT_USER:-minioadmin}\"\n      S3_BUCKET: \"${S3_BUCKET:-evorto-testing}\"\n      S3_ENDPOINT: http://minio:9000\n      S3_PUBLIC_ENDPOINT: \"http://localhost:${MINIO_HOST_PORT:-9000}\"\n      S3_REGION: \"${S3_REGION:-us-east-1}\"\n      S3_SECRET_ACCESS_KEY: \"${MINIO_ROOT_PASSWORD:-minioadmin}\"\n      SECRET:\n      SSR_RPC_ORIGIN: http://localhost:4200\n      STRIPE_API_KEY:\n      STRIPE_TEST_ACCOUNT_ID:\n      STRIPE_WEBHOOK_SECRET:\n      STRIPE_WEBHOOK_SECRET_FILE: /run/stripe-webhook/signing-secret\n    ports:\n      - \"127.0.0.1:${APP_HOST_PORT:-4200}:4200\"\n    volumes:\n      - stripe-webhook:/run/stripe-webhook:ro\n\n  worker:\n    build:\n      context: .\n      secrets:\n        - FONT_AWESOME_TOKEN\n    depends_on:\n      db:\n        condition: service_healthy\n      db-setup:\n        condition: service_completed_successfully\n      mailpit:\n        condition: service_started\n      minio:\n        condition: service_healthy\n      minio-init:\n        condition: service_completed_successfully\n      stripe:\n        condition: service_healthy\n    environment:\n      APP_ENVIRONMENT: local\n      APP_ROLE: worker\n      DATABASE_POOL_MAX: \"5\"\n      DATABASE_URL: postgresql://${POSTGRES_USER:-evorto}:${POSTGRES_PASSWORD:-evorto-local}@db:5432/${POSTGRES_DB:-appdb}?sslmode=disable\n      E2E_NOW_ISO:\n      E2E_RUNTIME_MODE:\n      EMAIL_DELIVERY_PROVIDER: mailpit\n      LOCAL_DATABASE: \"true\"\n      MAILPIT_API_URL: http://mailpit:8025/api/v1/send\n      NODE_ENV: development\n      S3_ACCESS_KEY_ID: \"${MINIO_ROOT_USER:-minioadmin}\"\n      S3_BUCKET: \"${S3_BUCKET:-evorto-testing}\"\n      S3_ENDPOINT: http://minio:9000\n      S3_PUBLIC_ENDPOINT: \"http://localhost:${MINIO_HOST_PORT:-9000}\"\nsed: ops/local-postgres-init.sql: No such file or directory\n15:POSTGRES_DB=<redacted>\n16:POSTGRES_HOST_PORT=<redacted>\n17:POSTGRES_INTEGRATION_DATABASE_URL=<redacted>\n18:POSTGRES_PASSWORD=<redacted>\n19:POSTGRES_USER=<redacted>\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

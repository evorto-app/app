{"timestamp":"2026-08-06T08:14:27.437Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd623-546d-7b90-a505-225bb12a2bbc","call_id":"call_l4sI3K4rVfwEbXvPCdyNYks8","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"name: E2E Baseline\n\non:\n  workflow_dispatch:\n  push:\n    branches: [main]\n\nconcurrency:\n  group: e2e-${{ github.ref }}\n  cancel-in-progress: true\n\npermissions:\n  contents: read\n\njobs:\n  validate-protected-ref:\n    name: Require protected main E2E source\n    runs-on: ubuntu-latest\n    timeout-minutes: 2\n    steps:\n      - name: Reject unprotected E2E refs\n        env:\n          E2E_REF: ${{ github.ref }}\n          E2E_REF_PROTECTED: ${{ github.ref_protected }}\n        run: |\n          if [ \"${E2E_REF}\" != \"refs/heads/main\" ]; then\n            echo \"::error::Credential-backed E2E may run only from refs/heads/main\"\n            exit 1\n          fi\n          if [ \"${E2E_REF_PROTECTED}\" != \"true\" ]; then\n            echo \"::error::Credential-backed E2E requires a protected main ref\"\n            exit 1\n          fi\n\n  e2e:\n    name: Playwright E2E (functional + docs)\n    needs: validate-protected-ref\n    runs-on: ubuntu-latest\n    timeout-minutes: 60\n    environment: esncard-release-certification\n    env:\n      CI: true\n      APP_HOST_PORT: 4200\n      BASE_URL: http://localhost:4200\n      APP_READY_PATH: /readyz\n      COMPOSE_PROJECT_NAME: evorto-ci\n      POSTGRES_DB: appdb\n      POSTGRES_HOST_PORT: 55432\n      POSTGRES_PASSWORD: evorto-ci-local\n      POSTGRES_USER: evorto\n      MAILPIT_HOST_PORT: 8025\n      MINIO_HOST_PORT: 9000\n      NO_WEBSERVER: true\n      DATABASE_URL: postgresql://evorto:evorto-ci-local@localhost:55432/appdb?sslmode=disable\n      E2E_NOW_ISO: \"2026-09-15T12:00:00.000Z\"\n      E2E_RUNTIME_MODE: playwright\n      E2E_SEED_KEY: evorto-e2e-default-v1\n      ISSUER_BASE_URL: ${{ vars.ISSUER_BASE_URL }}\n      STRIPE_TEST_ACCOUNT_ID: ${{ vars.STRIPE_TEST_ACCOUNT_ID }}\n      S3_ACCESS_KEY_ID: minioadmin\n      S3_BUCKET: evorto-ci\n      S3_ENDPOINT: http://minio:9000\n      S3_REGION: us-east-1\n      S3_SECRET_ACCESS_KEY: minioadmin\n    steps:\n      - name: Validate required configuration\n        env:\n          CLIENT_ID: ${{ secrets.CLIENT_ID }}\n          CLIENT_SECRET: ${{ secrets.CLIENT_SECRET }}\n          E2E_ADMIN_USER_PASSWORD: ${{ secrets.E2E_ADMIN_USER_PASSWORD }}\n          E2E_DEFAULT_USER_PASSWORD: ${{ secrets.E2E_DEFAULT_USER_PASSWORD }}\n          E2E_EMPTY_USER_PASSWORD: ${{ secrets.E2E_EMPTY_USER_PASSWORD }}\n          E2E_GLOBAL_ADMIN_USER_PASSWORD: ${{ secrets.E2E_GLOBAL_ADMIN_USER_PASSWORD }}\n          E2E_ORGANIZER_USER_PASSWORD: ${{ secrets.E2E_ORGANIZER_USER_PASSWORD }}\n          E2E_REGULAR_USER_PASSWORD: ${{ secrets.E2E_REGULAR_USER_PASSWORD }}\n          FONT_AWESOME_TOKEN: ${{ secrets.FONT_AWESOME_TOKEN }}\n          SECRET: ${{ secrets.SECRET }}\n          STRIPE_TEST_API_KEY: ${{ secrets.STRIPE_TEST_API_KEY }}\n          STRIPE_WEBHOOK_SECRET: ${{ secrets.STRIPE_WEBHOOK_SECRET }}\n        run: |\nname: Production Provider Certification\n\non:\n  workflow_call:\n    secrets:\n      AUTH0_MANAGEMENT_CLIENT_ID:\n        description: Auth0 Management client used by credential-backed integration journeys\n        required: true\n      AUTH0_MANAGEMENT_CLIENT_SECRET:\n        description: Auth0 Management secret used by credential-backed integration journeys\n        required: true\n      CLIENT_ID:\n        description: Auth0 application client id used by the certification stack\n        required: true\n      CLIENT_SECRET:\n        description: Auth0 application secret used by the certification stack\n        required: true\n      E2E_ADMIN_USER_PASSWORD:\n        description: Rotated password for the admin Playwright account\n        required: true\n      E2E_DEFAULT_USER_PASSWORD:\n        description: Rotated password for the default Playwright account\n        required: true\n      E2E_EMPTY_USER_PASSWORD:\n        description: Rotated password for the no-permissions Playwright account\n        required: true\n      E2E_GLOBAL_ADMIN_USER_PASSWORD:\n        description: Rotated password for the global-admin Playwright account\n        required: true\n      E2E_ORGANIZER_USER_PASSWORD:\n        description: Rotated password for the organizer Playwright account\n        required: true\n      E2E_REGULAR_USER_PASSWORD:\n        description: Rotated password for the regular Playwright account\n        required: true\n      E2E_LIVE_ESN_CARD_EXPIRED_IDENTIFIER:\n        description: Approved permanently expired non-production ESNcard identity\n        required: true\n      E2E_LIVE_ESN_CARD_IDENTIFIER:\n        description: Approved active non-production ESNcard identity\n        required: true\n      FONT_AWESOME_TOKEN:\n        description: Font Awesome package registry token\n        required: true\n      PUBLIC_GOOGLE_MAPS_API_KEY:\n        description: Browser-restricted Google Maps integration key\n        required: true\n      SECRET:\n        description: Application session signing secret\n        required: true\n      STRIPE_TEST_API_KEY:\n        description: Stripe test API key used by the certification stack\n        required: true\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: provider-certification\n  cancel-in-progress: false\n\njobs:\n  validate-protected-ref:\n    name: Require protected main certification source\n    runs-on: ubuntu-latest\n    timeout-minutes: 2\n    steps:\n      - name: Reject unprotected certification refs\n        env:\n          CERTIFICATION_REF: ${{ github.ref }}\n          CERTIFICATION_REF_PROTECTED: ${{ github.ref_protected }}\n        run: |\n          if [ \"${CERTIFICATION_REF}\" != \"refs/heads/main\" ]; then\n            echo \"::error::Provider certification may run only from refs/heads/main\"\n            exit 1\n          fi\n          if [ \"${CERTIFICATION_REF_PROTECTED}\" != \"true\" ]; then\n            echo \"::error::Provider certification requires a protected main ref\"\n            exit 1\n          fi\n\n  certify:\n    name: Required Auth0, Google Maps, and ESNcard certification\n    needs: validate-protected-ref\n    runs-on: ubuntu-latest\n    timeout-minutes: 45\n    environment: esncard-release-certification\n    env:\n      APP_HOST_PORT: 4200\n      APP_READY_PATH: /readyz\n      BASE_URL: http://localhost:4200\n      CI: true\n      COMPOSE_PROJECT_NAME: evorto-esncard-release\n      DATABASE_URL: postgresql://evorto:evorto-certification-local@localhost:55432/appdb?sslmode=disable\n      E2E_NOW_ISO: \"2026-09-15T12:00:00.000Z\"\n      E2E_RUNTIME_MODE: playwright\n      E2E_SEED_KEY: evorto-e2e-default-v1\n      ISSUER_BASE_URL: ${{ vars.ISSUER_BASE_URL }}\n      POSTGRES_DB: appdb\n      POSTGRES_HOST_PORT: 55432\n      POSTGRES_PASSWORD: evorto-certification-local\n      POSTGRES_USER: evorto\n      MAILPIT_HOST_PORT: 8025\n      NO_WEBSERVER: true\n      S3_ACCESS_KEY_ID: minioadmin\n      S3_BUCKET: evorto-esncard-release\n      S3_ENDPOINT: http://minio:9000\n      S3_REGION: us-east-1\n      S3_SECRET_ACCESS_KEY: minioadmin\n      STRIPE_TEST_ACCOUNT_ID: ${{ vars.STRIPE_TEST_ACCOUNT_ID }}\n      STRIPE_WEBHOOK_SECRET: whsec_esncard_release_not_used\n    steps:\n      - name: Validate required provider certification configuration\n        shell: bash\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

{"timestamp":"2026-08-06T10:01:07.243Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd684-fbaa-7752-b0d9-b2c621e14401","call_id":"call_9AGue2nHAOMnGAbKvv7NG9wH","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":"import { resetPublicSchema } from './testing/reset-public-schema';\nimport { ensureLocalPostgresIntegrationDatabase } from './testing/postgres-integration-database';\nimport { resolveLocalDatabaseEnvironment } from './local-database-preflight';\n\nconst confirmation = process.env['LOCAL_DATABASE_CONFIRM_RESET']?.trim();\nif (confirmation !== 'evorto-local-reset') {\n  throw new Error(\n    'Set REDACTED to confirm a destructive local schema reset',\n  );\n}\n\nconst { databaseUrl } = resolveLocalDatabaseEnvironment();\n\nawait ensureLocalPostgresIntegrationDatabase({ databaseUrl });\nawait resetPublicSchema({ databaseUrl });\nimport { Pool } from 'pg';\n\nimport { createNodePgPoolConfig } from '../../src/db/pg-connection-config';\nimport { postgresIntegrationDatabaseName } from './postgres-integration-environment';\n\nservices:\n  db:\n    image: postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193\n    restart: unless-stopped\n    environment:\n      POSTGRES_DB: \"${POSTGRES_DB:-appdb}\"\n      POSTGRES_PASSWORD: \"${POSTGRES_PASSWORD:-evorto-local}\"\n      POSTGRES_USER: \"${POSTGRES_USER:-evorto}\"\n    volumes:\n      - postgres-data:/var/lib/postgresql/data\n    ports:\n      - \"${POSTGRES_HOST_PORT:-55432}:5432\"\n    healthcheck:\n      test:\n        [\n          \"CMD-SHELL\",\n          \"pg_isready -h 127.0.0.1 -p 5432 -U ${POSTGRES_USER:-evorto} -d ${POSTGRES_DB:-appdb}\",\n        ]\n      interval: 5s\n      timeout: 5s\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

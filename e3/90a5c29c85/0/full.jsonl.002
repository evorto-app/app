ATABASE: /data/mailpit.db\n      MP_MAX_MESSAGES: \"500\"\n      MP_SEND_API_AUTH_ACCEPT_ANY: \"true\"\n    ports:\n      - \"${MAILPIT_HOST_PORT:-8025}:8025\"\n    volumes:\n      - mailpit-data:/data\n\n  minio:\n    image: minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e\n    command: server /data --console-address \":9001\"\n    environment:\n      MINIO_API_CORS_ALLOW_ORIGIN: \"http://localhost:${APP_HOST_PORT:-4200}\"\n      MINIO_ROOT_PASSWORD: \"${MINIO_ROOT_PASSWORD:-minioadmin}\"\n      MINIO_ROOT_USER: \"${MINIO_ROOT_USER:-minioadmin}\"\n    ports:\n      - \"${MINIO_HOST_PORT:-9000}:9000\"\n      - \"${MINIO_CONSOLE_HOST_PORT:-9001}:9001\"\n    healthcheck:\n      test: [\"CMD\", \"curl\", \"-f\", \"http://127.0.0.1:9000/minio/health/live\"]\n      interval: 5s\n      timeout: 5s\n      retries: 20\n      start_period: 10s\n\nimport { resetPublicSchema } from './testing/reset-public-schema';\n\nconst databaseUrlValue = process.env['DATABASE_URL']?.trim();\nconst confirmation = process.env['LOCAL_DATABASE_CONFIRM_RESET']?.trim();\nconst localHosts = new Set(['127.0.0.1', '::1', 'db', 'localhost']);\n\nif (!databaseUrlValue) {\n  throw new Error('DATABASE_URL must be configured for schema reset');\n}\nif (confirmation !== 'evorto-local-reset') {\n  throw new Error(\n    'Set REDACTED to confirm a destructive local schema reset',\n  );\n}\n\nconst databaseUrl = new URL(databaseUrlValue);\nconst host = databaseUrl.hostname.replace(/^\\[(.*)\\]$/u, '$1');\nif (!localHosts.has(host)) {\n  throw new Error(\n    `Refusing to reset a non-local database host (${host || 'missing'})`,\n  );\n}\n\nawait resetPublicSchema({ databaseUrl: databaseUrl.toString() });\nbun run env:runtime && dotenv -c dev -- sh -c 'bun helpers/reset-database-schema.ts && bun ./node_modules/drizzle-kit/bin.cjs push --force && bun helpers/database.ts'\nbun run docker:check && dotenv -c dev -- docker compose down --timeout 60 --remove-orphans && dotenv -c dev -- docker compose up --build -d\nbun run env:runtime && dotenv -c dev -- docker compose down --timeout 60 --remove-orphans\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

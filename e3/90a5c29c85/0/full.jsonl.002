{"timestamp":"2026-08-06T12:23:29.942Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd707-5596-7cd2-a126-ce7282dc2b06","call_id":"call_z49XiB5WtkMrSuacZlb3DtQk","output":[{"type":"input_text","text":"Script completed\nWall time 0.7 seconds\nOutput:\n"},{"type":"input_text","text":" .../rpc/handlers/global-admin.handlers.spec.ts     | 59 +++++++++++++++++-----\n .../effect/rpc/handlers/global-admin.handlers.ts   |  1 +\n 2 files changed, 46 insertions(+), 14 deletions(-)\ndiff --git a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\nindex ea168d1d09c..14f15377657 100644\n--- a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n+++ b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n@@ -1,4 +1,7 @@\n+import type { SQL } from 'drizzle-orm';\n+\n import { describe, expect, it, vi } from '@effect/vitest';\n+import { PgDialect } from 'drizzle-orm/pg-core';\n import { Effect, Layer } from 'effect';\n import Stripe from 'stripe';\n \n@@ -433,15 +436,17 @@ describe('globalAdminHandlers', () => {\n   );\n \n   it.effect(\n-    'summarizes single-dispatch state and bounds an incident-first detail page',\n+    'returns bounded incident-first details including complete and incomplete sent records',\n     () =>\n       Effect.gen(function* () {\n         let itemLimit: number | undefined;\n-        let itemOrderByExpressions: readonly unknown[] = [];\n+        let itemOrderByExpressions: readonly SQL[] = [];\n+        let itemWhere: SQL | undefined;\n         const selectResults = [\n           [\n             { status: 'failed', total: 2 },\n             { status: 'queued', total: 1 },\n+            { status: 'sent', total: 2 },\n           ],\n           [{ total: 1 }],\n           [\n@@ -498,17 +503,20 @@ describe('globalAdminHandlers', () => {\n             from: () => ({\n               groupBy: () => Effect.succeed(result),\n               innerJoin: () => ({\n-                where: () => ({\n-                  orderBy: (...expressions: readonly unknown[]) => {\n-                    itemOrderByExpressions = expressions;\n-                    return {\n-                      limit: (limit: number) => {\n-                        itemLimit = limit;\n-                        return Effect.succeed(result);\n-                      },\n-                    };\n-                  },\n-                }),\n+                where: (condition: SQL) => {\n+                  itemWhere = condition;\n+                  return {\n+                    orderBy: (...expressions: SQL[]) => {\n+                      itemOrderByExpressions = expressions;\n+                      return {\n+                        limit: (limit: number) => {\n+                          itemLimit = limit;\n+                          return Effect.succeed(result);\n+                        },\n+                      };\n+                    },\n+                  };\n+                },\n               }),\n               where: () => Effect.succeed(result),\n             }),\n@@ -527,7 +535,7 @@ describe('globalAdminHandlers', () => {\n           failed: 2,\n           queued: 1,\n           sending: 0,\n-          sent: 0,\n+          sent: 2,\n           staleSending: 1,\n           suppressed: 0,\n         });\n@@ -537,6 +545,29 @@ describe('globalAdminHandlers', () => {\n         );\n         expect(itemOrderByExpressions).toHaveLength(3);\n         expect(itemLimit).toBe(100);\n+        const [incidentOrder] = itemOrderByExpressions;\n+        if (!incidentOrder) {\n+          throw new Error('Expected the email overview incident ordering');\n+        }\n+        const incidentOrderQuery = new PgDialect().sqlToQuery(incidentOrder);\n+        expect(incidentOrderQuery.sql).toContain(\n+          '\"email_outbox\".\"status\" in (\\'failed\\', \\'deliveryUnknown\\')',\n+        );\n+        expect(incidentOrderQuery.sql).toContain(\n+          '\"email_outbox\".\"status\" = \\'sending\\'',\n+        );\n+        if (!itemWhere) {\n+          throw new Error('Expected the email overview item predicate');\n+        }\n+        const itemWhereQuery = new PgDialect().sqlToQuery(itemWhere);\n+        expect(itemWhereQuery.params).toEqual([\n+          'queued',\n+          'sending',\n+          'sent',\n+          'failed',\n+          'deliveryUnknown',\n+          'suppressed',\n+        ]);\n         expect(overview.items).toEqual([\n           expect.objectContaining({\n             id: 'email-1',\ndiff --git a/src/server/effect/rpc/handlers/global-admin.handlers.ts b/src/server/effect/rpc/handlers/global-admin.handlers.ts\nindex 3a8c5ac4023..2f082e92044 100644\n--- a/src/server/effect/rpc/handlers/global-admin.handlers.ts\n+++ b/src/server/effect/rpc/handlers/global-admin.handlers.ts\n@@ -550,6 +550,7 @@ export const globalAdminHandlers = {\n                 inArray(emailOutbox.status, [\n                   'queued',\n                   'sending',\n+                  'sent',\n                   'failed',\n                   'deliveryUnknown',\n                   'suppressed',\n M src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n M src/server/effect/rpc/handlers/global-admin.handlers.ts\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

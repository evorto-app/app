ncy thresholds remain provisional or report-only until accepted evidence activates them.\\n```\\n\\n## Exact submission sequence\\n\\nRun only after every required local branch-head and integrated gate is green.\\n\\n### 1. Shape and lease checks\\n\\n```zsh\\nset -euo pipefail\\ncd /Users/hedde/.codex/worktrees/17cb/evorto\\n\\ngit diff --quiet --ignore-submodules --\\ngit diff --cached --quiet --ignore-submodules --\\ntest -z \\\"$(git ls-files --others --exclude-standard)\\\"\\ntest \\\"$(git branch --show-current)\\\" = \\\"codex/staging-latency-runbooks\\\"\\n\\ngit fetch --no-tags origin \\\\\\n  '+refs/heads/main:refs/remotes/origin/main' \\\\\\n  '+refs/heads/codex/full-application-simplification-review:refs/remotes/origin/codex/full-application-simplification-review' \\\\\\n  '+refs/heads/codex/staging-latency-runbooks:refs/remotes/origin/codex/staging-latency-runbooks'\\n\\ntest \\\"$(git rev-parse main)\\\" = \\\"d117229d3d7d357af9f9fc61fdad8d348d6809ea\\\"\\ntest \\\"$(git rev-parse refs/remotes/origin/main)\\\" = \\\"d117229d3d7d357af9f9fc61fdad8d348d6809ea\\\"\\ntest \\\"$(git rev-parse refs/remotes/origin/codex/full-application-simplification-review)\\\" = \\\"951cb9da6f51a785b1f41b1e73279aec3d0c882f\\\"\\ntest \\\"$(git rev-parse refs/remotes/origin/codex/staging-latency-runbooks)\\\" = \\\"d3688389a91075041786fe001aba10e15847abc9\\\"\\n\\ngh stack view --json | jq -e '\\n  .trunk == \\\"main\\\"\\n  and .currentBranch == \\\"codex/staging-latency-runbooks\\\"\\n  and ((.branches | length) == 99)\\n  and all(.branches[]; (.needsRebase | not) and (.isMerged | not) and (.isQueued | not))\\n  and .branches[94].name == \\\"codex/full-application-simplification-review\\\"\\n  and .branches[98].name == \\\"codex/staging-latency-runbooks\\\"\\n  and ([.branches[] | select(.pr != null) | .pr.number] == [123, 124])\\n' >/dev/null\\n\\nevorto_stack_parent=main\\nwhile IFS= read -r evorto_stack_branch; do\\n  git merge-base --is-ancestor \\\"$evorto_stack_parent\\\" \\\"$evorto_stack_branch\\\"\\n  test \\\"$(git rev-list --count \\\"${evorto_stack_parent}..${evorto_stack_branch}\\\")\\\" -eq 1\\n  evorto_layer_files=\\\"$(\\n    git diff --name-only \\\"${evorto_stack_parent}..${evorto_stack_branch}\\\" -- |\\n      awk 'NF { count++ } END { print count + 0 }'\\n  )\\\"\\n  test \\\"$evorto_layer_files\\\" -gt 0\\n  test \\\"$evorto_layer_files\\\" -lt 100\\n  evorto_stack_parent=\\\"$evorto_stack_branch\\\"\\ndone < <(gh stack view --json | jq -r '.branches[].name')\\n\\nevorto_stack_remote_overlap=\\\"$(\\n  comm -12 \\\\\\n    <(gh stack view --json | jq -r '.branches[].name' | LC_ALL=C sort) \\\\\\n    <(git ls-remote --heads origin 'refs/heads/*' |\\n        awk '{ sub(\\\"^refs/heads/\\\", \\\"\\\", $2); print $2 }' |\\n        LC_ALL=C sort)\\n)\\\"\\ntest \\\"$evorto_stack_remote_overlap\\\" = $'codex/full-application-simplification-review\\\\ncodex/staging-latency-runbooks'\\n\\ntest \\\"$(\\n  git ls-remote --heads origin refs/heads/codex/full-application-simplification-review |\\n    awk '{ print $1 }'\\n)\\\" = \\\"951cb9da6f51a785b1f41b1e73279aec3d0c882f\\\"\\n\\ntest \\\"$(\\n  git ls-remote --heads origin refs/heads/codex/staging-latency-runbooks |\\n    awk '{ print $1 }'\\n)\\\" = \\\"d3688389a91075041786fe001aba10e15847abc9\\\"\\n\\njq -e -s '\\n  . as $docs\\n  | ($docs[0].branches | map(.name)) as $names\\n  | ($docs[1] | map(select(.headRefName as $head | $names | index($head)))) as $prs\\n  | (($prs | length) == 2)\\n    and (($prs | map(.number) | sort) == [123, 124])\\n    and all($prs[]; .state == \\\"OPEN\\\" and (.isDraft | not))\\n    and any($prs[];\\n      .number == 123\\n      and .headRefName == \\\"codex/full-application-simplification-review\\\"\\n      and .headRefOid == \\\"951cb9da6f51a785b1f41b1e73279aec3d0c882f\\\"\\n      and .baseRefName == \\\"main\\\"\\n    )\\n    and any($prs[];\\n      .number == 124\\n      and .headRefName == \\\"codex/staging-latency-runbooks\\\"\\n      and .headRefOid == \\\"d3688389a91075041786fe001aba10e15847abc9\\\"\\n      and .baseRefName == \\\"main\\\"\\n    )\\n' \\\\\\n  <(gh stack view --json) \\\\\\n  <(gh pr list --repo evorto-app/app --state all --limit 1000 \\\\\\n      --json number,headRefName,headRefOid,baseRefName,state,isDraft) \\\\\\n  >/dev/null\\n```\\n\\n### 2. Convert the two existing PRs to drafts\\n\\n```zsh\\ngh pr ready 123 --undo --repo evorto-app/app\\ngh pr ready 124 --undo --repo evorto-app/app\\n\\ngh pr view 123 --repo evorto-app/app \\\\\\n  --json state,isDraft,headRefName,headRefOid |\\n  jq -e '\\n    .state == \\\"OPEN\\\"\\n    and .isDraft\\n    and .headRefName == \\\"codex/full-application-simplification-review\\\"\\n    and .headRefOid == \\\"951cb9da6f51a785b1f41b1e73279aec3d0c882f\\\"\\n  ' >/dev/null\\n\\ngh pr view 124 --repo evorto-app/app \\\\\\n  --json state,isDraft,headRefName,headRefOid |\\n  jq -e '\\n    .state == \\\"OPEN\\\"\\n    and .isDraft\\n    and .headRefName == \\\"codex/staging-latency-runbooks\\\"\\n    and .headRefOid == \\\"d3688389a91075041786fe001aba10e15847abc9\\\"\\n  ' >/dev/null\\n\\ntest \\\"$(\\n  git ls-remote --heads origin refs/heads/codex/full-application-simplification-review |\\n    awk '{ print $1 }'\\n)\\\" = \\\"951cb9da6f51a785b1f41b1e73279aec3d0c882f\\\"\\n\\ntest \\\"$(\\n  git ls-remote --heads origin refs/heads/codex/staging-latency-runbooks |\\n    awk '{ print $1 }'\\n)\\\" = \\\"d3688389a91075041786fe001aba10e15847abc9\\\"\\n```\\n\\n### 3. Submit noninteractively\\n\\n```zsh\\ngh stack submit --auto --remote origin\\n```\\n\\n`submit` is not atomic. If a lease rejects a branch, keep the partial remote result visible, re-run the lease checks, resolve only the rejected branch, and rerun the same command.\\n\\n### 4. Replace #123 and #124 text\\n\\n```zsh\\ngh pr edit 123 --repo evorto-app/app \\\\\\n  --title \\\"docs: record application review checkpoint\\\" \\\\\\n  --body-file - <<'EOF'\\n## Purpose\\n\\nPersist the application-wide manual review checkpoint so findings, simplification decisions, and remaining proof are reviewable in the repository rather than held in chat history.\\n\\n## This layer\\n\\n- Adds `APPLICATION_REVIEW_QUEUE.md` only: 1 file, 1,305 added lines.\\n- Records all 157 finding outcomes, including 155 resolved findings and 2 explicitly accepted boundaries.\\n- Preserves all 41 simplification candidates and product decisions D-001 through D-008.\\n- Separates the reconstructed source-review checkpoint from historical evidence and the final-stack evidence that still has to be recorded.\\n- Adds no application code.\\n\\n## Stack context\\n\\nThis is layer 95 of 99. It depends on the preceding 94 implementation layers; the four staging-latency layers follow it.\\n\\n## Verification status\\n\\nThis PR does not claim completion of the 99-head or integrated environment gates. Those requirements remain explicit in the review queue until their actual final-stack evidence is recorded.\\nEOF\\n\\ngh pr edit 124 --repo evorto-app/app \\\\\\n  --title \\\"docs: add staging latency improvement and monitoring runbooks\\\" \\\\\\n  --body-file - <<'EOF'\\n## Purpose\\n\\nTurn the dated staging-latency evidence into an explicit improvement and incident-response playbook.\\n\\n## This layer\\n\\n- Adds `LATENCY_IMPROVEMENT.md` with the dated baseline, provisional budgets, ordered improvement plan, and evidence record.\\n- Adds `infrastructure/scaleway/LATENCY_MONITORING.md` with warm-candidate sampling, trace and dashboard guidance, report-only thresholds, and incident response.\\n- Links those runbooks from `QUALITY.md` and the Scaleway README.\\n- Adds one documentation contract proving that the planned `config.bootstrap` trace signal is not presented as active.\\n- Changes 5 files with 608 added lines and no runtime behavior.\\n\\n## Stack context\\n\\nThis is layer 99 of 99. It documents how to operate and continue the tracing, bounded probe, and CI evidence introduced in layers 96–98. It does not implement the planned bootstrap endpoint or activate its metric.\\n\\n## Evidence boundary\\n\\nNo current performance claim is made here. The recorded baseline is explicitly dated 2026-07-27, and the proposed latency thresholds remain provisional or report-only until accepted evidence activates them.\\nEOF\\n```\\n\\n### 5. Verify the submitted stack\\n\\n```zsh\\njq -e -s '\\n  . as $docs\\n  | ($docs[0].branches | map(.name)) as $branches\\n  | ($docs[1] | map(select(.headRefName as $head | $branches | index($head)))) as $prs\\n  | (($docs[0].branches | length) == 99)\\n    and all($docs[0].branches[];\\n      ((.pr.number // 0) > 0)\\n      and .pr.state == \\\"OPEN\\\"\\n      and (.needsRebase | not)\\n      and (.isMerged | not)\\n      and (.isQueued | not)\\n    )\\n    and (($prs | length) == 99)\\n    and all($prs[]; .state == \\\"OPEN\\\" and .isDraft)\\n    and (\\n      [range(0; 99) as $position\\n        | ($branches[$position]) as $head\\n        | ($prs | map(select(.headRefName == $head))) as $matches\\n        | (($matches | length) == 1)\\n          and (\\n            $matches[0].baseRefName ==\\n            (if $position == 0 then \\\"main\\\" else $branches[$position - 1] end)\\n          )\\n      ] | all\\n    )\\n    and any($prs[];\\n      .number == 123\\n      and .headRefName == $branches[94]\\n      and .headRefOid == \\\"0fdcf9d080e5d61d4e415e03474ef1bb2980ba9a\\\"\\n      and .baseRefName == $branches[93]\\n    )\\n    and any($prs[];\\n      .number == 124\\n      and .headRefName == $branches[98]\\n      and .headRefOid == \\\"e2569f73ba142ec1c395dcf375600a806f798820\\\"\\n      and .baseRefName == $branches[97]\\n    )\\n' \\\\\\n  <(gh stack view --json) \\\\\\n  <(gh pr list --repo evorto-app/app --state open --limit 1000 \\\\\\n      --json number,headRefName,headRefOid,baseRefName,state,isDraft,title,url) \\\\\\n  >/dev/null\\n\\ndiff -u \\\\\\n  <(\\n    gh stack view --json |\\n      jq -r '.branches[].name' |\\n      while IFS= read -r evorto_stack_branch; do\\n        printf '%s\\\\t%s\\\\n' \\\\\\n          \\\"$evorto_stack_branch\\\" \\\\\\n          \\\"$(git rev-parse \\\"$evorto_stack_branch\\\")\\\"\\n      done |\\n      LC_ALL=C sort\\n  ) \\\\\\n  <(\\n    gh stack view --json |\\n      jq -r '.branches[] | \\\"refs/heads/\\\" + .name' |\\n      xargs git ls-remote --heads origin |\\n      awk '{\\n        sub(\\\"^refs/heads/\\\", \\\"\\\", $2)\\n        print $2 \\\"\\\\t\\\" $1\\n      }' |\\n      LC_ALL=C sort\\n  )\\n\\ngh pr view 123 --repo evorto-app/app \\\\\\n  --json state,isDraft,title,body,baseRefName,headRefOid |\\n  jq -e '\\n    .state == \\\"OPEN\\\"\\n    and .isDraft\\n    and .title == \\\"docs: record application review checkpoint\\\"\\n    and .baseRefName == \\\"codex/bound-local-docker-lifecycle\\\"\\n    and .headRefOid == \\\"0fdcf9d080e5d61d4e415e03474ef1bb2980ba9a\\\"\\n    and (.body | contains(\\\"This is layer 95 of 99\\\"))\\n    and (.body | contains(\\\"does not claim completion\\\"))\\n  ' >/dev/null\\n\\ngh pr view 124 --repo evorto-app/app \\\\\\n  --json state,isDraft,title,body,baseRefName,headRefOid |\\n  jq -e '\\n    .state == \\\"OPEN\\\"\\n    and .isDraft\\n    and .title == \\\"docs: add staging latency improvement and monitoring runbooks\\\"\\n    and .baseRefName == \\\"codex/automate-staging-latency-evidence\\\"\\n    and .headRefOid == \\\"e2569f73ba142ec1c395dcf375600a806f798820\\\"\\n    and (.body | contains(\\\"This is layer 99 of 99\\\"))\\n    and (.body | contains(\\\"No current performance claim is made\\\"))\\n  ' >/dev/null\\n\\ngh stack view --json |\\n  jq -r '\\n    .branches\\n    | to_entries[]\\n    | \\\"\\\\(.key + 1)\\\\t\\\\(.value.name)\\\\t#\\\\(.value.pr.number)\\\\t\\\\(.value.pr.url)\\\"\\n  '\\n```\"}},{\"agent_name\":\"/root/queue_closure_map\",\"agent_status\":{\"completed\":\"Closure map sent to the coordinator. No files, refs, remotes, or Docker state were changed. Work is complete and not continuing.\\n\\nKey note: position 95 cannot embed its own final SHA or descendant SHAs because amending it rewrites those identifiers.\\n\\n\"}}]}","internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

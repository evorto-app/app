ding docs page-backed and explicit about versioned consent', () => {\n1269:  it('keeps receipt-submission cleanup deterministic and database-only', () => {\n1315:  it('keeps finance receipt docs aligned with email notification and reimbursement scope', () => {\n1347:  it('keeps finance overview docs aligned with permission-scoped navigation', () => {\n1383:  it('keeps tax-rate documentation backed by account-scoped import and saved template/event assignments', () => {\n1446:  it('keeps template docs aligned with simple and advanced registration setup', () => {\n1537:  it('keeps template category docs backed by deterministic persistence checks', () => {\n1563:  it('keeps registration docs aligned with unavailable states, participant add-ons, and the current transfer flow', () => {\n2057:  it('publishes both event-discovery models in the relevant guides', () => {\n2096:  it('keeps manual approval docs beginner-readable and behavior-backed', () => {\n2161:  it('keeps organizer and helper signup docs role-aware and behavior-backed', () => {\n2226:  it('keeps event approval docs backed by deterministic lifecycle persistence checks', () => {\n2268:  it('keeps event-management docs aligned with scanner and organizer scope', () => {\n2388:  it('keeps dedicated check-in docs beginner-readable and behavior-backed', () => {\n2419:  it('keeps role docs aligned with generated permission reference semantics', () => {\n2491:  it('keeps ESN discount docs aligned with provider-error and write-guard behavior', () => {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

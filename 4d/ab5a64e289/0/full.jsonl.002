ditSnapshotRows({\n-        resourceId: 'event-1',\n-        resourceType: 'event',\n-        state: {\n-          announcementRoleCount: 2,\n-        },\n-      }),\n-    ).toEqual([{ label: 'Announcement Role Count', value: '2' }]);\n+  it('shows distinct announcement role changes without exposing identifiers', () => {\n+    const before = platformAuditSnapshotRows({\n+      resourceId: 'event-1',\n+      resourceType: 'event',\n+      state: {\n+        announcementRoles: ['Members'],\n+      },\n+    });\n+    const after = platformAuditSnapshotRows({\n+      resourceId: 'event-1',\n+      resourceType: 'event',\n+      state: {\n+        announcementRoles: ['Helpers'],\n+      },\n+    });\n+\n+    expect(before).toEqual([{ label: 'Announcement Roles', value: 'Members' }]);\n+    expect(after).toEqual([{ label: 'Announcement Roles', value: 'Helpers' }]);\n+    expect(after).not.toEqual(before);\n   });\n });\ndiff --git a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\nindex 1d08a140e08..38b72035c9e 100644\n--- a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n+++ b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n@@ -621,6 +621,15 @@ describe('globalAdminHandlers', () => {\n                       state: null,\n                       stripeTaxRateId: 'txr_added',\n                     },\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Super reduced',\n+                      inclusive: true,\n+                      percentage: '5',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_unchanged',\n+                    },\n                   ],\n                 },\n               },\n@@ -638,6 +647,15 @@ describe('globalAdminHandlers', () => {\n                       state: null,\n                       stripeTaxRateId: 'txr_existing',\n                     },\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Super reduced',\n+                      inclusive: true,\n+                      percentage: '5',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_unchanged',\n+                    },\n                   ],\n                 },\n               },\n@@ -672,7 +690,8 @@ describe('globalAdminHandlers', () => {\n           after: expect.objectContaining({\n             state: {\n               taxRateAddedCount: 1,\n-              taxRateCount: 2,\n+              taxRateCount: 3,\n+              taxRateUnchangedCount: 1,\n               taxRateUpdatedCount: 1,\n             },\n           }),\ndiff --git a/src/server/effect/rpc/handlers/global-admin.handlers.ts b/src/server/effect/rpc/handlers/global-admin.handlers.ts\nindex a478bf207e9..a932cbe30f8 100644\n--- a/src/server/effect/rpc/handlers/global-admin.handlers.ts\n+++ b/src/server/effect/rpc/handlers/global-admin.handlers.ts\n@@ -168,13 +168,16 @@ const PersistedGlobalAdminTaxRateAuditState = Schema.Struct({\n \n const PersistedGlobalAdminPlatformAuditState = Schema.Struct({\n   addOns: Schema.optional(Schema.Array(Schema.Unknown)),\n-  announcementRoles: Schema.optional(Schema.Array(Schema.Unknown)),\n+  alcoholAmount: GlobalAdminPlatformAuditState.fields.alcoholAmount,\n+  amount: GlobalAdminPlatformAuditState.fields.amount,\n+  announcementRoles: GlobalAdminPlatformAuditState.fields.announcementRoles,\n   attendeeCheckedIn: GlobalAdminPlatformAuditState.fields.attendeeCheckedIn,\n   checkedInGuestCount: GlobalAdminPlatformAuditState.fields.checkedInGuestCount,\n   currency: GlobalAdminPlatformAuditState.fields.currency,\n   defaultOrganizerRole:\n     GlobalAdminPlatformAuditState.fields.defaultOrganizerRole,\n   defaultUserRole: GlobalAdminPlatformAuditState.fields.defaultUserRole,\n+  depositAmount: GlobalAdminPlatformAuditState.fields.depositAmount,\n   description: GlobalAdminPlatformAuditState.fields.description,\n   displayInHub: GlobalAdminPlatformAuditState.fields.displayInHub,\n   domain: GlobalAdminPlatformAuditState.fields.domain,\n@@ -193,9 +196,11 @@ const PersistedGlobalAdminPlatformAuditState = Schema.Struct({\n   sortOrder: GlobalAdminPlatformAuditState.fields.sortOrder,\n   status: GlobalAdminPlatformAuditState.fields.status,\n   stripeConnected: Schema.optional(Schema.Boolean),\n+  taxAmount: GlobalAdminPlatformAuditState.fields.taxAmount,\n   theme: GlobalAdminPlatformAuditState.fields.theme,\n   timezone: GlobalAdminPlatformAuditState.fields.timezone,\n   title: GlobalAdminPlatformAuditState.fields.title,\n+  totalAmount: GlobalAdminPlatformAuditState.fields.totalAmount,\n   transferStatus: GlobalAdminPlatformAuditState.fields.transferStatus,\n });\n \n@@ -218,12 +223,15 @@ const toGlobalAdminPlatformAuditSnapshot = (\n     resourceType: snapshot.resourceType,\n     state: {\n       addOnCount: state.addOns?.length,\n-      announcementRoleCount: state.announcementRoles?.length,\n+      alcoholAmount: state.alcoholAmount,\n+      amount: state.amount,\n+      announcementRoles: state.announcementRoles,\n       attendeeCheckedIn: state.attendeeCheckedIn,\n       checkedInGuestCount: state.checkedInGuestCount,\n       currency: state.currency,\n       defaultOrganizerRole: state.defaultOrganizerRole,\n       defaultUserRole: state.defaultUserRole,\n+      depositAmount: state.depositAmount,\n       description: state.description,\n       displayInHub: state.displayInHub,\n       domain: state.domain,\n@@ -241,10 +249,12 @@ const toGlobalAdminPlatformAuditSnapshot = (\n       sortOrder: state.sortOrder,\n       status: state.status,\n       ...taxRateSummary,\n+      taxAmount: state.taxAmount,\n       taxRateCount: state.rates?.length,\n       theme: state.theme,\n       timezone: state.timezone,\n       title: state.title,\n+      totalAmount: state.totalAmount,\n       transferStatus: state.transferStatus,\n     },\n   });\n@@ -282,22 +292,22 @@ const taxRateImportAuditSummary = (\n     beforeRates.map((rate) => [rate.stripeTaxRateId, rate]),\n   );\n   let addedCount = 0;\n+  let unchangedCount = 0;\n   let updatedCount = 0;\n   for (const rate of afterRates) {\n     const previousRate = beforeRatesById.get(rate.stripeTaxRateId);\n     if (!previousRate) {\n       addedCount += 1;\n-    } else if (!taxRateMetadataMatches(previousRate, rate)) {\n+    } else if (taxRateMetadataMatches(previousRate, rate)) {\n+      unchangedCount += 1;\n+    } else {\n       updatedCount += 1;\n     }\n   }\n \n-  if (addedCount === 0 && updatedCount === 0) {\n-    return { taxRateUnchangedCount: afterRates.length };\n-  }\n-\n   return {\n     ...(addedCount > 0 && { taxRateAddedCount: addedCount }),\n+    ...(unchangedCount > 0 && { taxRateUnchangedCount: unchangedCount }),\n     ...(updatedCount > 0 && { taxRateUpdatedCount: updatedCount }),\n   };\n };\ndiff --git a/src/shared/rpc-contracts/app-rpcs/global-admin.rpcs.ts b/src/shared/rpc-contracts/app-rpcs/global-admin.rpcs.ts\nindex e55d8e70627..b04f08de8af 100644\n--- a/src/shared/rpc-contracts/app-rpcs/global-admin.rpcs.ts\n+++ b/src/shared/rpc-contracts/app-rpcs/global-admin.rpcs.ts\n@@ -39,12 +39,15 @@ export type GlobalAdminTenantUpdateError = Schema.Schema.Type<\n \n export const GlobalAdminPlatformAuditState = Schema.Struct({\n   addOnCount: Schema.optional(Schema.Number),\n-  announcementRoleCount: Schema.optional(Schema.Number),\n+  alcoholAmount: Schema.optional(Schema.Number),\n+  amount: Schema.optional(Schema.Number),\n+  announcementRoles: Schema.optional(Schema.Array(Schema.NonEmptyString)),\n   attendeeCheckedIn: Schema.optional(Schema.Boolean),\n   checkedInGuestCount: Schema.optional(Schema.Number),\n   currency: Schema.optional(PlatformTenantAuditSnapshot.fields.currency),\n   defaultOrganizerRole: Schema.optional(Schema.Boolean),\n   defaultUserRole: Schema.optional(Sche
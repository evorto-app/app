false,\n      \"isQueued\": false,\n      \"needsRebase\": false\n    },\n    {\n      \"name\": \"codex/remove-event-migration-steps\",\n      \"head\": \"070bc64979373d37824876652cb2a0482b969cb8\",\n      \"base\": \"b019239b48041e7258a8154ffbb2321f6898c04d\",\n      \"isCurrent\": false,\n      \"isMerged\": false,\n      \"isQueued\": false,\n      \"needsRebase\": false\n    },\n    {\n      \"name\": \"codex/remove-legacy-event-mapping-rules\",\n      \"head\": \"7ec7b7f832a21faa544459932a3da3400280a238\",\n      \"base\": \"070bc64979373d37824876652cb2a0482b969cb8\",\n      \"isCurrent\": false,\n      \"isMerged\": false,\n      \"isQueued\": false,\n      \"needsRebase\": false\n    },\n    {\n      \"name\": \"codex/remove-migration-support-utilities\",\n      \"head\": \"aa68eafd30be93834c3c1c688405f6e736e036fc\",\n      \"base\": \"7ec7b7f832a21faa544459932a3da3400280a238\",\n      \"isCurrent\": false,\n      \"isMerged\": false,\n      \"isQueued\": false,\n      \"needsRebase\": false\n    },\n    {\n      \"name\": \"codex/remove-migration-repository-wiring\",\n      \"head\": \"fada8ab8cf428e7eda8715aec7f71efb4a41a3c9\",\n      \"base\": \"aa68eafd30be93834c3c1c688405f6e736e036fc\",\n/tmp/evorto-pr124-source-replay-final/0001-perf-trace-staging-request-latency.patch\n/tmp/evorto-pr124-source-replay-final/0002-feat-add-bounded-staging-latency-probe.patch\n/tmp/evorto-pr124-source-replay-final/0003-ci-automate-staging-latency-evidence.patch\n/tmp/evorto-pr124-source-replay-final/0004-docs-explain-staging-latency-response.patch\n/tmp/evorto-pr124-source-replay-final/MANIFEST.md\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

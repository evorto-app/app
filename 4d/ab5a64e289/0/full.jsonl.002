: GlobalAdminPlatformAuditState.fields.guestCount,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:182:  locationName: GlobalAdminPlatformAuditState.fields.locationName,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:183:  name: GlobalAdminPlatformAuditState.fields.name,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:184:  paymentsConfigured: GlobalAdminPlatformAuditState.fields.paymentsConfigured,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:185:  permissions: GlobalAdminPlatformAuditState.fields.permissions,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:188:  receiptCount: GlobalAdminPlatformAuditState.fields.receiptCount,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:190:  remainingGuestCount: GlobalAdminPlatformAuditState.fields.remainingGuestCount,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:192:  simpleModeEnabled: GlobalAdminPlatformAuditState.fields.simpleModeEnabled,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:193:  sortOrder: GlobalAdminPlatformAuditState.fields.sortOrder,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:194:  status: GlobalAdminPlatformAuditState.fields.status,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:196:  theme: GlobalAdminPlatformAuditState.fields.theme,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:197:  timezone: GlobalAdminPlatformAuditState.fields.timezone,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:198:  title: GlobalAdminPlatformAuditState.fields.title,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:199:  transferStatus: GlobalAdminPlatformAuditState.fields.transferStatus,\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:204:  readonly taxRateUnchangedCount?: number;\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:208:const toGlobalAdminPlatformAuditSnapshot = (\nsrc/server/effect/rpc/handlers/global-admin.handlers.ts:213:    PersistedGlobalAdminPlatformAuditState,\ns
               resourceType: 'taxRateBatch' as const,\n+                state: {\n+                  rates: [\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Standard',\n+                      inclusive: true,\n+                      percentage: '19',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_existing',\n+                    },\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Reduced',\n+                      inclusive: true,\n+                      percentage: '7',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_added',\n+                    },\n+                  ],\n+                },\n+              },\n+              before: {\n+                resourceId: 'tax-import-1',\n+                resourceType: 'taxRateBatch' as const,\n+                state: {\n+                  rates: [\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Old standard',\n+                      inclusive: true,\n+                      percentage: '19',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_existing',\n+                    },\n+                  ],\n+                },\n+              },\n+              createdAt,\n+              id: 'audit-2',\n+              reason: 'Refresh tax rates',\n+              targetTenantId: 'tenant-1',\n+              targetTenantName: 'Section',\n+            },\n           ]),\n         orderBy: () => selectQuery,\n       };\n@@ -614,7 +667,21 @@ describe('globalAdminHandlers', () => {\n           targetTenantId: 'tenant-1',\n           targetTenantName: 'Section',\n         }),\n+        expect.objectContaining({\n+          action: 'taxRates.import',\n+          after:
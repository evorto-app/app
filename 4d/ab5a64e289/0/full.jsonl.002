   },\n         targetTenantName: 'Example Organization',\n       }),\n@@ -90,31 +90,27 @@ describe('platformAuditSnapshotRows', () => {\n         resourceId: 'refund-1',\n         resourceType: 'refundClaim',\n         state: {\n-          amount: 1250,\n           currency: 'EUR',\n-          generation: 2,\n-          refundClaimId: 'refund-1',\n+          receiptCount: 2,\n           status: 'needs_attention',\n-          transferId: 'transfer-1',\n         },\n       }),\n     ).toEqual([\n-      { label: 'Amount', value: '12,50 €' },\n       { label: 'Currency', value: 'EUR' },\n+      { label: 'Receipt Count', value: '2' },\n       { label: 'Status', value: 'needs attention' },\n     ]);\n   });\n \n-  it('shows announcement role names while keeping their identifiers hidden', () => {\n+  it('shows the announcement audience size without exposing role identifiers', () => {\n     expect(\n       platformAuditSnapshotRows({\n         resourceId: 'event-1',\n         resourceType: 'event',\n         state: {\n-          announcementRoleIds: ['role-1', 'role-2'],\n-          announcementRoles: ['Members', 'Helpers'],\n+          announcementRoleCount: 2,\n         },\n       }),\n-    ).toEqual([{ label: 'Announcement Roles', value: 'Members, Helpers' }]);\n+    ).toEqual([{ label: 'Announcement Role Count', value: '2' }]);\n   });\n });\ndiff --git a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\nindex 06280ba16c8..1d08a140e08 100644\n--- a/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n+++ b/src/server/effect/rpc/handlers/global-admin.handlers.spec.ts\n@@ -594,6 +594,59 @@ describe('globalAdminHandlers', () => {\n               targetTenantId: 'tenant-1',\n               targetTenantName: 'Section',\n             },\n+            {\n+              action: 'taxRates.import' as const,\n+              actorEmail: 'platform@example.org',\n+              actorId: 'auth0|platform-admin',\n+              after: {\n+                resourceId: 'tax-import-1',\n+                resourceType: 'taxRateBatch' as const,\n+                state: {\n+                  rates: [\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Standard',\n+                      inclusive: true,\n+                      percentage: '19',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_existing',\n+                    },\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Reduced',\n+                      inclusive: true,\n+                      percentage: '7',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_added',\n+                    },\n+                  ],\n+                },\n+              },\n+              before: {\n+                resourceId: 'tax-import-1',\n+                resourceType: 'taxRateBatch' as const,\n+                state: {\n+                  rates: [\n+                    {\n+                      active: true,\n+                      country: 'DE',\n+                      displayName: 'Old standard',\n+                      inclusive: true,\n+                      percentage: '19',\n+                      state: null,\n+                      stripeTaxRateId: 'txr_existing',\n+                    },\n+                  ],\n+                },\n+              },\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd2d8-aa27-7b33-9da1-34e7e79b653d"}}}

item in value} == set(descriptor[\"rootNames\"]), \"Tooling root set mismatch\")\n            require(all(all(item[key] == 0 for key in (\"errorCount\", \"warningCount\", \"fatalErrorCount\")) for item in value), \"Tooling warnings/errors present\")\n            results[name] = {\"files\": len(value), \"errors\": 0, \"warnings\": 0}\n\n    def postgres(self, descriptor, cleanup_descriptor):\n        rec, cleanup = self.document(descriptor), self.document(cleanup_descriptor)\n        self.identity(rec)\n        for key in (\"sourceBefore\", \"sourceAfter\"):\n            self.identity(rec[key], clean=True)\n        require(rec[\"status\"] == \"passed\" and rec[\"exitCode\"] == 0 and rec[\"command\"] == [\"bun\", \"run\", \"test:integration:postgres\"], \"PostgreSQL gate failed or selected\")\n        result = unit_summary(self.read(rec[\"log\"], rec[\"sha256\"]).decode())\n        require(cleanup[\"containerId\"] == rec[\"databaseContainerId\"], \"PostgreSQL cleanup owner mismatch\")\n        counts = cleanup[\"readback\"]\n        require(set(counts) >= {\"urlRaceTenants\", \"concurrencyTenants\", \"idleInTransaction\", \"activeClientQueries\"}\n                and all(type(value) is int and value == 0 for value in counts.values()), \"PostgreSQL cleanup readback is not zero\")\n        result[\"cleanupReadback\"] = counts\n        result[\"processGroupEvidence\"] = \"Not recorded by this standalone PostgreSQL receipt; not independently certified\"\n        self.results[\"postgres\"] = result\n\n    def image(self):\n        cfg = self.spec[\"image\"]\n        inv, rec = self.document(cfg[\"invocation\"]), self.document(cfg[\"receipt\"])\n        self.envelope(rec, inv)\n        require(rec[\"status\"] == \"passed\" and rec[\"invocationSha256\"] == cfg[\"invocation\"][\"sha256\"], \"Image receipt/invocation failed\")\n{\n  \"reviewRoot\": \"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review\",\n  \"gitRepository\": \"/Users/hedde/.codex/worktrees/aa9e/evorto-stac
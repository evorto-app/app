d-tenant.spec.ts\\\",\\n    \\\"helpers/seed-tenant.ts\\\",\\n    \\\"helpers/testing/container-image-pinning-source.spec.ts\\\",\\n    \\\"helpers/testing/docker-lifecycle.spec.ts\\\",\\n    \\\"helpers/testing/docker-project-lease.spec.ts\\\",\\n    \\\"helpers/testing/docker-resume.sh\\\",\\n    \\\"helpers/testing/docker-stack.sh\\\",\\n    \\\"helpers/testing/docker-stack.spec.ts\\\",\\n    \\\"helpers/testing/docker-webserver.sh\\\",\\n    \\\"helpers/testing/fail-loud-database-source.spec.ts\\\",\\n    \\\"helpers/testing/postgres-integration-database.spec.ts\\\",\\n    \\\"helpers/testing/postgres-integration-database.ts\\\",\\n    \\\"helpers/testing/postgres-integration-environment.spec.ts\\\",\\n    \\\"helpers/testing/postgres-integration-environment.ts\\\",\\n    \\\"helpers/testing/run-postgres-integration.ts\\\",\\n    \\\"helpers/testing/run-with-wall-clock-timeout.ts\\\",\\n    \\\"helpers/testing/runtime-environment.spec.ts\\\",\\n    \\\"helpers/testing/runtime-environment.ts\\\",\\n    \\\"helpers/testing/runtime-preflight.spec.ts\\\",\\n    \\\"helpers/testing/stripe-listener.Dockerfile\\\",\\n    \\\"helpers/testing/with-docker-project-lease.sh\\\",\\n    \\\"ops/local-postgres-init.sql\\\",\\n    \\\"package.json\\\",\\n    \\\"src/db/setup-database.ts\\\",\\n    \\\"src/db/staging-database-initialization.spec.ts\\\",\\n    \\\"src/db/staging-database-initialization.ts\\\",\\n    \\\"tests/README.md\\\",\\n    \\\"tests/setup/database.setup.ts\\\",\\n    \\\"tests/specs/permissions/tenant-isolation-tax-rates.spec.ts\\\",\\n    \\\"tests/support/fixtures/parallel-test.ts\\\"\\n  ],\\n  \\\"title_file\\\": \\\"02-local-runtime.title.txt\\\",\\n  \\\"body_file\\\": \\\"02-local-runtime.body.md\\\",\\n  \\\"validation_status\\\": \\\"Fresh changed-tree verification required\\\",\\n  \\\"title\\\": \\\"fix: prevent partial seeds and conflicting local setup\\\",\\n  \\\"body_sha256\\\": \\\"535682a3dee7c8fa6589e8a5e8f2eff9104045da067e61fafb0ba5a0cba5fac2\\\",\\n  \\\"sources\\\": [\\n    \\\"../strict-policy-rebased-stack.json\\\",\\n    \\\"actual parent diff\\\",\\n    \\\"../layer-02-local-runtime.md\\\",\\n    \\\"../layer02-f58a-verification.md\\\",\\n    \\\"../layer02-f58a-verification-evidence.json\\\",\\n    \\\"../current-local-stack.json\\\",\\n    \\\"../prefix-runtime-verification/reader-replay-execution/root-review.json\\\"\\n  ],\\n  \\\"historical_pre_reader_replay_head\\\": \\\"f58a50b3b2766914d99319369c9fa6b1e6a41d5c\\\"\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"0a0465\",\"wall_time_seconds\":0.000003625,\"exit_code\":0,\"original_token_count\":319,\"output\":\"Make the sample-data reset and all tenant seed writes commit in one transaction, so a late failure restores prior data and cannot mark a partial seed complete. Require complete tenant, role and registration context, and reject non-local database targets before local schema operations connect.\\n\\nLocal database and Docker mutations acquire a lease for their Compose project, preventing concurrent resets or service changes. Ordinary Docker operations have watchdogs and report failures; setup ensures the disposable integration database exists, packages the pinned Stripe listener script, and assigns Mailpit a worktree-specific loopback port. Application schema shapes are unchanged.\\n\\nValidation at `f58a50b3`: frozen install, release checks, lint/format, full server (1,394 tests), app (802 tests), PostgreSQL 17 (55 tests), Terraform validation/config scanning, and the production image build/runtime/maps/SBOM/current strict scan all pass. The image has zero HIGH/CRITICAL findings, including unfixed vulnerabilities. Authenticated E2E and documentation acceptance are tracked separately.\\n\\nThe validation above belongs to historical head `f58a50b3`. Current head `08806f0b` has a changed Stripe test helper and requires fresh ordinary, functional and documentation checks.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788572018.44345}}}

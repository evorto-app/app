dev -- bun helpers/testing/runtime-preflight.ts playwright\\\",\\n        \\\"docker:webserver\\\": \\\"bun run env:runtime && dotenv -c dev -- bash helpers/testing/with-docker-project-lease.sh docker-webserver -- sh -c 'bun helpers/testing/runtime-preflight.ts docker && bash helpers/testing/docker-webserver.sh'\\\",\\n        \\\"test:e2e\\\": \\\"bun run test:e2e:check && E2E_SELECTED_PROJECTS=local-chrome-baseline REDACTED DOCS_OUT_DIR=test-results/docs DOCS_IMG_OUT_DIR=test-results/docs/images dotenv -c dev -- playwright test --project=local-chrome-baseline\\\",\\n        \\\"test:e2e:docs\\\": \\\"bun run test:e2e:check && E2E_SELECTED_PROJECTS=docs-baseline REDACTED DOCS_OUT_DIR=test-results/docs DOCS_IMG_OUT_DIR=test-results/docs/images dotenv -c dev -- playwright test --project=docs-baseline\\\"\\n      }\\n    },\\n    {\\n      \\\"layer\\\": \\\"8\\\",\\n      \\\"branch\\\": \\\"codex/relaunch/08-roles-members-audit\\\",\\n      \\\"head\\\": \\\"f46c903e0c320a50d5fe69cf5f14676474014d34\\\",\\n      \\\"tree\\\": \\\"17ceddbed8b31622b0389a0431d96634935e4b60\\\",\\n      \\\"canonicalScripts\\\": {\\n        \\\"env:runtime\\\": \\\"bun helpers/testing/runtime-environment.ts\\\",\\n        \\\"test:e2e:check\\\": \\\"bun run env:runtime && dotenv -c dev -- bun helpers/testing/runtime-preflight.ts playwright\\\",\\n        \\\"docker:webserver\\\": \\\"bun run env:runtime && dotenv -c dev -- bash helpers/testing/with-docker-project-lease.sh docker-webserver -- sh -c 'bun helpers/testing/runtime-preflight.ts docker && bash helpers/testing/docker-webserver.sh'\\\",\\n        \\\"test:e2e\\\": \\\"bun run test:e2e:check && E2E_SELECTED_PROJECTS=local-chrome-baseline REDACTED DOCS_OUT_DIR=test-results/docs DOCS_IMG_OUT_DIR=test-results/docs/images dotenv -c dev -- playwright test --project=local-chrome-baseline\\\",\\n        \\\"test:e2e:…4663 tokens truncated…   \\\"POSTGRES_HOST_PORT\\\": 55821,\\n        \\\"MINIO_HOST_PORT\\\": 9201,\\n        \\\"MINIO_CONSOLE_HOST_PORT\\\": 9701,\\n        \\\"MAILPIT_HOST_PORT\\\": 14221\\n      },\\n      \\\"ordinaryReceipt\\\": \\\"prefix-runtime-verification/ordinary-runs/01-3ad029b3-a1/combined-evidence.json\\\",\\n      \\\"receiptSha256\\\": \\\"e65aa7437e496a44ace905f4d762af3d3eb6da3ceefbada62e6c1defa1190678\\\",\\n      \\\"readinessApproval\\\": \\\"prefix-runtime-verification/readiness-01.json\\\",\\n      \\\"readinessApprovalSha256\\\": \\\"1960b776ba7fde168b75ad92edf0b62ec23bed216e62e5ed567946f41727de70\\\"\\n    }\\n  ],\\n  \\\"runnerSha256\\\": \\\"b12d86b81a1e66ad8b3777deb5c62a74a8606ec39d925b66a6ab41ab5c3f65c2\\\",\\n  \\\"completedPrefixEvidence\\\": [\\n    {\\n      \\\"head\\\": \\\"9acc1f36719341e9517e65a9ff2a56538398d3a8\\\",\\n      \\\"path\\\": \\\"prefix-runtime-verification/runs/00-9acc1f36-a1/root-acceptance-and-cleanup.json\\\",\\n      \\\"sha256\\\": \\\"db785c9feb27eb94022c2d1e29784bfc247b2e60d5eab653f1e3c0796cfa0776\\\"\\n    }\\n  ]\\n}\\n\"}}\n{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"f8365c\",\"wall_time_seconds\":0.00001125,\"exit_code\":0,\"original_token_count\":1515,\"output\":\"# Final-parent16R source projection\\n\\nThis snapshot composes the original45-path stored-random retirement onto the accepted85-path16S source projection. The complete first-party parent is captured in `before/`; `repository/` contains the complete composed source for the next layer. Existing files were composed through owning hunks and narrow overlap replacements.\\n\\n- Parent final15 commit: `2a1283ab0ca5ac3a84442037f89384f4150594c9`; tree `54694b4d5b39611a068fe794a2fed4fc11c2d31e`.\\n- Accepted16S manifest: `53aa8a4e0408fb662d187127ccbb78c5e51262d7dfcf362c33aef6888dbe2013`.\\n- Parent source projection: `fca80901e38cc244336247946e240d82a4967dde4def0a18cd3b38ffd4cb4cf3`.\\n- Output source projection: `5eff9a0284391ba4ef45e21969106b02095ffe2edda5c7418485a90fabb0e59d`.\\n- Owning manifest: `c26f2f8d8e898842283a9f3ff542b3b40ca358d844be58bb2e6f06b9c6e1778f`.\\n- Patch: `ed2b1f57bdaba1bac2055975702aec131c5a3dbe6c007eafd62109f7510406c5`.\\n- Measured scope: **45 paths**, +618/-1311; **no new caller paths**. 1255 existing context files are byte- and mode-identical.\\n\\n`candidate-manifest.json` records every before/after hash and mode. `output-projection.json` records all 1300 output files. `preservation-receipt.json` binds current F228/F231/ESN, role, cap, payment, category, template-default and event unlisted/discovery preservation. The syntax-only test inventory has367 before and356 after case declarations, with336 retained callbacks byte-identical and7 narrowly adapted; only original16R retirements and replacements occurred.\\n\\nThe original45 snapshot and accepted16S85 inputs remain unchanged. Both actual16S and16R commit identities are pending. This source seal is suitable for downstream source composition; it is not compiler, test, runtime, database, Browser or deployment acceptance. Root owns actual-head materialization and gates.\\n# Layer 17A source rebind\\n\\nThis is the complete 24-path event-list/review candidate on the frozen final16R source projection. Its 1,300 first-party input files match16R output projection `5eff9a0284391ba4ef45e21969106b02095ffe2edda5c7418485a90fabb0e59d`, derived from final15 tree54694b4d plus the accepted85-path16S and45-path16R packets. Actual16S/16R commits remain pending; this receipt does not claim an actual-head run.\\n\\nThe candidate composes the immutable original22-path17A packet, paused-conflict feedback follow-up, three-path schedule/location follow-up, two-path router scrolling predecessor, and its same-file cleanup companion. The original seals remain unchanged. The only five drifted original preimages are the generated-docs source guard, event-query handler/spec, event RPC schema spec and shared event RPC contract. Their three-way deltas are limited to review wording guards, deterministic list order and bounded list input fields/tests; all newer parent additions remain.\\n\\nEvent lists keep the existing role and unlisted predicates, add deterministic start/ID ordering and bounded integer/UTC input validation, retain loaded pages when a later page fails, and remove the unused filter dialog. Review and submission preserve their initiating event, comment and operation lifetime, including truthful conflict feedback when a read pauses offline. Details show tenant-timezone start/end and physical/online/unspecified location. Router navigation opens detail at the top and restores list position on Back.\\n\\nPreservation is anchored to exact packet postimages: all earlier EventDetails cases/assertions remain; the schedule packet adds three expanded scenarios plus the missing-location assertion and a real query-cache state assertion. The full scroll case, measurements and viewport checks remain; both cleanup regions now retain primary and disposal/attachment failures. No17B announcement/discovery fields, card/authentication API changes, template/default changes, or registration/payment changes are introduced.\\n\\n`candidate-manifest.json` records all24 pre/post hashes and modes. `output-projection.json` binds the complete1,300-file result. All 1,278 non-owning paths remain identical to the parent; forward and reverse patch checks pass. No compiler, parser, tests, runtime, database/provider or ref action ran during this rebind. Canonical lint/format and all actual-head gates are explicitly deferred to the materialized stage by the source owner.\\n\\nFor17B, use this complete source as the predecessor. Retain the schedule/timezone/location fields and all three cases, adapt only their maybeSelf authentication fixture to17B's authentication query, avoid duplicating the already-present paused-conflict regression, and preserve the two scroll cleanup regions while adding discovery cases. Previous17B packets retain their original preimages and need this final rebind.\\n{\\n  \\\"status\\\": \\\"Root accepts source-only85-path16S candidate; materialization and all actual-head gates pending\\\",\\n  \\\"reviewedAt\\\": \\\"2026-09-05T00:54:15.016122+00:00\\\",\\n  \\\"parentHead\\\": \\\"2a1283ab0ca5ac3a84442037f89384f4150594c9\\\",\\n  \\\"parentTree\\\": \\\"54694b4d5b39611a068fe794a2fed4fc11c2d31e\\\",\\n  \\\"manifestSha256\\\": \\\"53aa8a4e0408fb662d187127ccbb78c5e51262d7dfcf362c33aef6888dbe2013\\\",\\n  \\\"candidatePatchSha256\\\": \\\"64acf237ff019440362670019ee03cb8d077d24dc3368f459d43f75a9020c854\\\",\\n  \\\"extensionPatchSha256\\\": \\\"786e51745209db39124093ac860e50c8607b818d4c2a9ba47afd9cae325d5800\\\",\\n  \\\"actualParentPreimagesVerified\\\": 85,\\n  \\\"candidateOutputsVerified\\\": 85,\\n  \\\"rootReadFullExtension\\\": true,\\n  \\\"boundIndependentReviewSha256\\\": \\\"99573e1304b6aad4c6fa76492cc8afd1ce8885263c9eccf9fcf2ed567f783db7\\\",\\n  \\\"eventBoundaryFilesReverified\\\": 12,\\n  \\\"scope\\\": \\\"Retire template listing inheritance end to end; ordinary event creation uses unchanged false default; all event listing/review/access boundaries preserved\\\",\\n  \\\"original75Preserved\\\": true,\\n  \\\"newPaths\\\": 10,\\n  \\\"notes\\\": [\\n    \\\"Schema removes template unlisted; relaunch reset/push verification remains required\\\",\\n    \\\"Canonical lint/format/strict/full unit/PostgreSQL/image/functional/docs and UI acceptance remain pending\\\",\\n    \\\"No shared ref or publication change authorized by source receipt\\\"\\n  ]\\n}\\n\"}}\n{\"i\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"a1e934\",\"wall_time_seconds\":0.000002,\"exit_code\":0,\"original_token_count\":2949,\"output\":\"\\\"\\\"\\\"One exact01 canonical image attempt; explicit root image grant required.\\\"\\\"\\\"\\nimport argparse\\nfrom datetime import datetime\\nimport hashlib\\nimport importlib.util\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport signal\\nimport subprocess\\n\\nHERE = Path(__file__).resolve().parent\\nREVIEW = HERE.parent.parent\\nROOT = REVIEW.parent / \\\"evorto-stack-main\\\"\\nHELPER_SHA = \\\"820f0fdd78f77d8cd3dc98586d661b58c1b86d10847c9b2b3d07d1f4253b2215\\\"\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"--execute\\\", action=\\\"store_true\\\")\\n    parser.add_argument(\\\"--slot-grant\\\")\\n    args = parser.parse_args()\\n    invocation_path = HERE / \\\"image-01-invocation.json\\\"\\n    invocation = json.loads(invocation_path.read_text())\\n    if not args.execute:\\n        print(json.dumps(invocation, indent=2))\\n        return\\n    if not args.slot_grant:\\n        raise RuntimeError(\\\"An actual root image slot grant is required\\\")\\n    helper_path = HERE / \\\"runtime-runner.before.py\\\"\\n    if hashlib.sha256(helper_path.read_bytes()).hexdigest() != HELPER_SHA:\\n        raise RuntimeError(\\\"Reviewed ownership helper changed\\\")\\n    spec = importlib.util.spec_from_file_location(\\\"image_ownership\\\", helper_path)\\n    helper = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(helper)\\n    helper.ROOT = ROOT\\n    helper.REVIEW = REVIEW\\n    os.umask(0o022)\\n    env = dict(os.environ)\\n    env[\\\"PATH\\\"] = invocation[\\\"environment\\\"][\\\"PATHPrefix\\\"] + \\\":\\\" + env[\\\"PATH\\\"]\\n    env.update({k: v for k, v in invocation[\\\"environment\\\"].items() if k != \\\"PATHPrefix\\\"})\\n    directory = Path(invocation[\\\"resultDirectory\\\"])\\n    directory.parent.mkdir(mode=0o700, parents=True, exist_ok=True)\\n    directory.parent.chmod(0o700)\\n    directory.mkdir(mode=0o700, exist_ok=False)\\n    expected = {\\\"head\\\": invocation[\\\"head\\\"], \\\"tree\\\": invocation[\\\"tree\\\"]}\\n    receipt = {\\\"status\\\": \\\"running\\\", **expected, \\\"parent\\\": invocation[\\\"parent\\\"], \\\"startedAt\\\": helper.now(),\\n               \\\"slotGrant\\\": args.slot_grant, \\\"commands\\\": {}, \\\"errors\\\": [], \\\"cleanup\\\": {},\\n               \\\"invocationSha256\\\": helper.sha(invocation_path), \\\"runnerSha256\\\": helper.sha(Path(__file__)),\\n               \\\"ownershipHelperSha256\\\": HELPER_SHA, \\\"environment\\\": invocation[\\\"environment\\\"]}\\n    save = lambda: helper.private_json(directory / \\\"receipt.json\\\", receipt)\\n    save()\\n\\n    def image_state():\\n        command = [\\\"docker\\\", \\\"image\\\", \\\"inspect\\\", \\\"--format\\\", \\\"{{.Id}}\\\", invocation[\\\"image\\\"]]\\n        result = subprocess.run(command, cwd=ROOT, env=env, capture_output=True, text=True, timeout=30)\\n        if result.returncode == 0:\\n            return {\\\"exists\\\": True, \\\"imageId\\\": result.stdout.strip(), \\\"exitCode\\\": 0}\\n        helper.require(\\\"No such image:\\\" in result.stderr, \\\"Cannot establish exact image-tag absence\\\")\\n        return {\\\"exists\\\": False, \\\"exitCode\\\": result.returncode}\\n\\n    def build_history():\\n        return [json.loads(line) for line in helper.read(env, \\\"docker\\\", \\\"buildx\\\", \\\"history\\\", \\\"ls\\\", \\\"--format\\\", \\\"json\\\").splitlines()]\\n\\n    try:\\n        receipt[\\\"sourceBefore\\\"] = helper.source(env, expected)\\n        helper.require(helper.read(env, \\\"git\\\", \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\") == \\\"HEAD\\\", \\\"Proof is not detached\\\")\\n        helper.require(helper.read(env, \\\"git\\\", \\\"rev-parse\\\", \\\"HEAD^\\\") == invocation[\\\"parent\\\"], \\\"Parent changed\\\")\\n        receipt[\\\"tools\\\"] = {\\\"node\\\": helper.read(env, \\\"node\\\", \\\"--version\\\"), \\\"bun\\\": helper.read(env, \\\"bun\\\", \\\"--version\\\")}\\n        helper.require(receipt[\\\"tools\\\"] == {\\\"node\\\": \\\"v24.15.0\\\", \\\"bun\\\": \\\"1.3.14\\\"}, \\\"Pinned tools unavailable\\\")\\n        for name in (\\\"sourceEvidence\\\", \\\"postgresEvidence\\\", \\\"postgresCleanup\\\"):\\n            item = invocation[name]\\n            helper.require(helper.sha(Path(item[\\\"path\\\"])) == item[\\\"sha256\\\"], \\\"Prerequisite evidence changed\\\")\\n        for path, expected_hash in invocation[\\\"canonicalSourceHashes\\\"].items():\\n            helper.require(helper.sha(ROOT / path) == expected_hash, \\\"Canonical source changed\\\")\\n        package = json.loads((ROOT / \\\"package.json\\\").read_text())\\n        helper.require(package[\\\"scripts\\\"][\\\"image:security:local\\\"] == invocation[\\\"script\\\"], \\\"Canonical image command changed\\\")\\n        receipt[\\\"imageBefore\\\"] = image_state()\\n        helper.require(not receipt[\\\"imageBefore\\\"][\\\"exists\\\"], \\\"Exact intended image tag already exists; ownership not acquired\\\")\\n        receipt[\\\"buildHistoryBefore\\\"] = build_history()\\n        helper.require(all(row[\\\"status\\\"] != \\\"Running\\\" for row in receipt[\\\"buildHistoryBefore\\\"]), \\\"Another BuildKit build is active\\\")\\n        receipt[\\\"trivyBefore\\\"] = json.loads(helper.read(env, \\\"/Users/hedde/.cache/evorto-verification-tools/trivy\\\", \\\"--version\\\", \\\"--format\\\", \\\"json\\\"))\\n        save()\\n        helper.run_command(\\\"image\\\", invocation[\\\"command\\\"], env, directory, invocation[\\\"wholeCommandTimeoutSeconds\\\"], receipt, save)\\n        receipt[\\\"status\\\"] = \\\"passed-pending-cleanup\\\"\\n    except BaseException as error:\\n        receipt[\\\"status\\\"] = \\\"failed\\\"\\n        receipt[\\\"errors\\\"].append(helper.failure(error, \\\"image\\\"))\\n    finally:\\n        acquired = \\\"pid\\\" in receipt[\\\"commands\\\"].get(\\\"image\\\", {})\\n        receipt[\\\"cleanup\\\"][\\\"ownedCommandStarted\\\"] = acquired\\n        if acquired:\\n            try:\\n                image_after = image_state()\\n                receipt[\\\"cleanup\\\"][\\\"imageAfter\\\"] = image_after\\n                if image_after[\\\"exists\\\"]:\\n                    receipt[\\\"errors\\\"].append({\\\"phase\\\": \\\"canonical-image-cleanup-left-tag\\\", \\\"type\\\": \\\"RuntimeError\\\"})\\n                    helper.run_command(\\\"owned-image-cleanup\\\", [\\\"docker\\\", \\\"image\\\", \\\"rm\\\", \\\"--force\\\", invocation[\\\"image\\\"]], env, directory, 60, receipt, save)\\n                    receipt[\\\"cleanup\\\"][\\\"afterRecovery\\\"] = image_state()\\n                final_image = receipt[\\\"cleanup\\\"].get(\\\"afterRecovery\\\", image_after)\\n                helper.require(not final_image[\\\"exists\\\"], \\\"Owned image tag cleanup incomplete\\\")\\n                history = build_history()\\n                receipt[\\\"buildHistoryAfter\\\"] = [row for row in history if datetime.fromisoformat(row[\\\"created_at\\\"].replace(\\\"Z\\\", \\\"+00:00\\\")) >= datetime.fromisoformat(receipt[\\\"startedAt\\\"])]\\n                helper.require(all(row[\\\"status\\\"] != \\\"Running\\\" for row in history), \\\"BuildKit still has a running build\\\")\\n                receipt[\\\"trivyAfter\\\"] = json.loads(helper.read(env, \\\"/Users/hedde/.cache/evorto-verification-tools/trivy\\\", \\\"--version\\\", \\\"--format\\\", \\\"json\\\"))\\n            except BaseException as error:\\n                receipt[\\\"errors\\\"].append(helper.failure(error, \\\"image-cleanup\\\"))\\n        try:\\n            receipt[\\\"sourceAfter\\\"] = helper.source(env, expected)\\n        except BaseException as error:\\n            receipt[\\\"errors\\\"].append(helper.failure(error, \\\"source-after\\\"))\\n        receipt[\\\"status\\\"] = \\\"passed\\\" if receipt[\\\"status\\\"] == \\\"passed-pending-cleanup\\\" and not receipt[\\\"errors\\\"] else \\\"failed\\\"\\n        receipt[\\\"completedAt\\\"] = helper.now()\\n        save()\\n    print(json.dumps({\\\"status\\\": receipt[\\\"status\\\"], \\\"receipt\\\": str(directory / \\\"receipt.json\\\")}))\\n    if receipt[\\\"status\\\"] != \\\"passed\\\":\\n        raise SystemExit(1)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    def interrupt(signum, frame):\\n        raise KeyboardInterrupt()\\n    signal.signal(signal.SIGTERM, interrupt)\\n    signal.signal(signal.SIGINT, interrupt)\\n    main()\\n\\\"\\\"\\\"Prepared exact02 ordinary source gates. Execution requires explicit root grant.\\\"\\\"\\\"\\nimport argparse\\nimport hashlib\\nimport importlib.util\\nimport json\\nimport os\\nimport signal\\nfrom pathlib import Path\\n\\nHERE = Path(__file__).resolve().parent\\nREVIEW = HERE.parent.parent\\nROOT = REVIEW.parent / \\\"evorto-stack-main\\\"\\nPINNED_HELPER_SHA = \\\"820f0fdd78f77d8cd3dc98586d661b58c1b86d10847c9b2b3d07d1f4253b2215\\\"\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"--execute\\\", action=\\\"store_true\\\")\\n    parser.add_argument(\\\"--slot-grant\\\")\\n    args = parser.parse_args()\\n    invocation_path = HERE / \\\"ordinary-02-invocation.json\\\"\\n    invocation = json.loads(invocation_path.read_text())\\n    if not args.execute:\\n        print(json.dumps(invocation, indent=2))\\n        return\\n    if not args.slot_grant:\\n        raise RuntimeError(\\\"An actual explicit root grant is required\\\")\\n    helper_path = HERE / \\\"runtime-runner.before.py\\\"\\n    if hashlib.sha256(helper_path.read_bytes()).hexdigest() != PINNED_HELPER_SHA:\\n        raise RuntimeError(\\\"Reviewed process ownership helper changed\\\")\\n    spec = importlib.util.spec_from_file_location(\\\"reviewed_runtime_ownership\\\", helper_path)\\n    helper = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(helper)\\n    helper.ROOT = ROOT\\n    helper.REVIEW = REVIEW\\n    os.umask(0o022)\\n    env = dict(os.environ)\\n    for key in (\\\"NODE_OPTIONS\\\", \\\"BUN_OPTIONS\\\"):\\n        env.pop(key, None)\\n    env[\\\"PATH\\\"] = invocation[\\\"environment\\\"][\\\"PATHPrefix\\\"] + \\\":\\\" + env[\\\"PATH\\\"]\\n    env[\\\"CI\\\"] = \\\"true\\\"\\n    helper.require(helper.read(env, \\\"node\\\", \\\"--version\\\") == \\\"v24.15.0\\\", \\\"Pinned Node version unavailable\\\")\\n    helper.require(helper.read(env, \\\"bun\\\", \\\"--version\\\") == \\\"1.3.14\\\", \\\"Pinned Bun version unavailable\\\")\\n    expected = {\\\"head\\\": invocation[\\\"head\\\"], \\\"tree\\\": invocation[\\\"tree\\\"]}\\n    helper.require(helper.read(env, \\\"git\\\", \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\") == \\\"HEAD\\\", \\\"Proof must be detached\\\")\\n    helper.require(helper.read(env, \\\"git\\\", \\\"rev-parse\\\", \\\"HEAD^\\\") == invocation[\\\"parent\\\"], \\\"Parent changed\\\")\\n    source_before = helper.source(env, expected)\\n    package = json.loads(helper.read(env, \\\"git\\\", \\\"show\\\", invocation[\\\"head\\\"] + \\\":package.json\\\"))\\n    helper.require(all(package[\\\"scripts\\\"][k] == v for k, v in invocation[\\\"canonicalSourceScripts\\\"].items()), \\\"Canonical script changed\\\")\\n    directory = Path(invocation[\\\"resultDirectory\\\"])\\n    directory.parent.mkdir(mode=0o700, parents=True, exist_ok=True)\\n    directory.parent.chmod(0o700)\\n    directory.mkdir(mode=0o700, exist_ok=False)\\n    receipt = {\\\"status\\\": \\\"running\\\", **expected, \\\"parent\\\": invocation[\\\"parent\\\"], \\\"sourceBefore\\\": source_before,\\n               \\\"startedAt\\\": helper.now(), \\\"slotGrant\\\": args.slot_grant, \\\"commands\\\": {}, \\\"errors\\\": [],\\n               \\\"invocationSha256\\\": helper.sha(invocation_path), \\\"runnerSha256\\\": helper.sha(Path(__file__)),\\n               \\\"helperSha256\\\": PINNED_HELPER_SHA,\\n               \\\"tools\\\": {\\\"node\\\": helper.read(env, \\\"node\\\", \\\"--version\\\"), \\\"bun\\\": helper.read(env, \\\"bun\\\", \\\"--version\\\")}}\\n    save = lambda: helper.private_json(directory / \\\"receipt.json\\\", receipt)\\n    save()\\n    try:\\n        for step in invocation[\\\"commands\\\"]:\\n            helper.source(env, expected)\\n            step_env = dict(env)\\n            if step[\\\"name\\\"] == \\\"infra\\\":\\n                step_env.update({key: invocation[\\\"environment\\\"][key] for key in (\\\"TF_PLUGIN_CACHE_DIR\\\", \\\"TF_CLI_ARGS_init\\\")})\\n            helper.run_command(step[\\\"name\\\"], step[\\\"command\\\"], step_env, directory,\\n                               invocation[\\\"processTimeoutSeconds\\\"], receipt, save)\\n            helper.source(env, expected)\\n            print(step[\\\"name\\\"] + \\\" passed\\\", flush=True)\\n        receipt[\\\"status\\\"] = \\\"source-gates-passed; root PG and image acceptance pending\\\"\\n    except BaseException as error:\\n        receipt[\\\"status\\\"] = \\\"failed\\\"\\n        receipt[\\\"errors\\\"].append(helper.failure(error, \\\"ordinary-source\\\"))\\n        raise\\n    finally:\\n        receipt[\\\"completedAt\\\"] = helper.now()\\n        try:\\n            receipt[\\\"sourceAfter\\\"] = helper.source(env, expected)\\n        except BaseException as error:\\n            receipt[\\\"status\\\"] = \\\"failed\\\"\\n            receipt[\\\"errors\\\"].append(helper.failure(error, \\\"final-source\\\"))\\n        save()\\n        print(json.dumps({\\\"status\\\": receipt[\\\"status\\\"], \\\"receipt\\\": str(directory / \\\"receipt.json\\\")}))\\n    if receipt[\\\"status\\\"] == \\\"failed\\\":\\n        raise SystemExit(1)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    def interrupt(signum, frame):\\n        raise KeyboardInterrupt()\\n    signal.signal(signal.SIGTERM, interrupt)\\n    signal.signal(signal.SIGINT, interrupt)\\n    main()\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788571293.535639}}}

istration-option/event-registration-option.component.spec.ts\",\n        \"src/app/events/event-registration-option/event-registration-option.component.ts\",\n        \"src/app/global-admin/platform-event-operations/platform-event-detail.component.html\",\n        \"src/app/global-admin/platform-event-operations/platform-event-detail.component.spec.ts\",\n        \"src/app/global-admin/platform-event-operations/platform-event-detail.component.ts\",\n        \"src/app/global-admin/platform-event-operations/platform-template-editor.component.spec.ts\",\n        \"src/app/shared/components/forms/template-graph-editor/template-graph-form.mapper.spec.ts\",\n        \"src/app/shared/components/forms/template-graph-editor/template-graph-form.mapper.ts\",\n        \"src/app/shared/components/forms/template-graph-editor/template-graph-form.model.ts\",\n        \"src/app/shared/components/forms/template-graph-editor/template-registration-option-editor.component.ts\",\n        \"src/app/templates/template-create-event/template-create-event.component.html\",\n        \"src/app/templates/template-create-event/template-create-event.component.spec.ts\",\n        \"src/app/templates/template-create-event/template-create-event.component.ts\",\n        \"src/db/schema/global-enums.ts\",\n        \"src/server/effect/rpc/handlers/events/event-graph.service.spec.ts\",\n        \"src/server/effect/rpc/handlers/events/event-graph.service.ts\",\n        \"src/server/effect/rpc/handlers/events/event-registration.service.spec.ts\",\n        \"src/server/effect/rpc/handlers/events/events-lifecycle.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/events/events-lifecycle.handlers.ts\",\n        \"src/server/effect/rpc/handlers/events/events-query.handlers.ts\",\n        \"src/server/effect/rpc/handlers/events/events-rpcs.schema.spec.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform-events.handlers.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform-templates.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform-templates.handlers.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.service.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.service.ts\",\n        \"src/server/effect/rpc/handlers/templates/templates-rpcs.schema.spec.ts\",\n        \"src/shared/registration-modes.spec.ts\",\n        \"src/shared/registration-modes.ts\",\n        \"src/shared/rpc-contracts/app-rpcs/events.rpcs.ts\",\n        \"src/shared/rpc-contracts/app-rpcs/platform-events.rpcs.spec.ts\",\n        \"src/shared/rpc-contracts/app-rpcs/platform-events.rpcs.ts\",\n        \"src/shared/rpc-contracts/app-rpcs/templates.rpcs.ts\",\n        \"tests/docs/templates/templates.doc.ts\",\n        \"tests/specs/events/negative-registration-states.spec.ts\",\n        \"tests/specs/templates/registration-configuration.spec.ts\",\n        \"tests/test-inventory.md\"\n      ]\n    },\n    {\n      \"layer\": \"17A\",\n      \"packet\": \"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/layer17a-event-list-review/final-parent-rebind\",\n      \"branch\": \"codex/relaunch/17a-event-list-review\",\n      \"baseBranch\": \"codex/relaunch/16r-registration-modes\",\n      \"pathCount\": 24,\n      \"manifestSha256\": \"14a82488609865a6eb08d7b2600176ef9f0c025384d78e1fdc74ab53aac09c9b\",\n      \"patchSha256\": \"e802560add458c99c6c9f7baeeedb3a4025b76a5671db706de44fc297a5aa2fd\",\n      \"commitArgv\": [\n        \"git\",\n        \"commit\",\n        \"-m\",\n        \"Improve event browsing and review\"\n      ],\n      \"stageArgv\": [\n        \"git\",\n        \"add\",\n        \"--all\",\n        \"--\",\n        \".changeset/bound-list-query-contracts.md\",\n        \".changeset/return-event-reviews-to-draft.md\",\n        \"helpers/testing/generated-docs-source.spec.ts\",\n        \"src/app/admin/admin-overview/admin-overview.component.html\",\n        \"src/app/admin/event-reviews/event-reviews.component.ts\",\n        \"src/app/app.config.ts\",\n        \"src/app/events/event-details/event-details.component.html\",\n        \"src/app/events/event-details/event-details.component.spec.ts\",\n        \"src/app/events/event-details/event-details.component.ts\",\n        \"src/app/events/event-filter-dialog/event-filter-dialog.component.html\",\n        \"src/app/events/event-filter-dialog/event-filter-dialog.component.ts\",\n        \"src/app/events/event-list.service.ts\",\n        \"src/app/events/event-list/event-list.component.html\",\n        \"src/app/events/event-list/event-list.component.spec.ts\",\n        \"src/app/events/event-list/event-list.component.ts\",\n        \"src/app/events/event-review-dialog/event-review-dialog.component.ts\",\n        \"src/server/effect/rpc/handlers/events/events-query.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/events/events-query.handlers.ts\",\n        \"src/server/effect/rpc/handlers/events/events-review.handlers.ts\",\n        \"src/server/effect/rpc/handlers/events/events-rpcs.schema.spec.ts\",\n        \"src/shared/rpc-contracts/app-rpcs/events.rpcs.ts\",\n        \"tests/docs/events/event-approval.doc.ts\",\n        \"tests/specs/events/event-discovery-eligibility.test.ts\",\n        \"tests/specs/events/events.test.ts\"\n      ]\n    }\n  ],\n  \"firstInvocationArgv\": [\n    \"python3\",\n    \"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/next-layer-materialization-plan/materialize-source.py\",\n    \"--layer\",\n    \"16S\",\n    \"--expected-parent\",\n    \"2a1283ab0ca5ac3a84442037f89384f4150594c9\",\n    \"--run-id\",\n    \"16s-initial-materialization\"\n  ],\n  \"subsequentInvocation\": \"Use the same script with --layer16R/17A, the actual just-committed immediate parent, and a fresh run-id. Each stage checks every candidate preimage against that parent before creating its child branch.\",\n  \"perLayerBoundaries\": [\n    \"Verify exact source identities and current stack state; preserve existing18heads and both originalPR backups.\",\n    \"Create one local gh-stack child; copy only manifested outputs/deletions; run mandatory canonical lint, format and release validation with owned logs.\",\n    \"Inspect all formatter/lint changes and final scope; require all prechecks green and fewer than100 paths before staging/committing.\",\n    \"Run the structured stageArgv/commitArgv only after the final delta is reviewed; capture exact parent/head/tree/paths/materialized hashes and clean status.\",\n    \"Update only sourceowner current-local-stack/current-gh-stack metadata after coordinating runtime binding; root PR drafts/manifest remain root-owned.\",\n    \"Fresh actual-head ordinary/strict/full units/PostgreSQL/image and full functional/docs remain separate root-coordinated gates. No prior candidate receipt becomes actual-head proof.\",\n    \"Any formatter/source repair that changes a packet output requires a concrete downstream source rebind before the next invocation; do not bypass preimage checks.\"\n  ],\n  \"explicitExclusions\": [\n    \"No push, submit, sync, remote PR update, assembly source change or root-owned PR artifact write.\",\n    \"No automatic source correction, dropped caller, schema runtime action, gate waiver or chained materialization after failure.\"\n  ]\n}\n#!/usr/bin/env python3\n\"\"\"Materialize exactly one approved local source layer after host-slot release.\n\nDoes not commit, update inventories, launch runtime/image gates, or contact GitHub.\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport subprocess\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef read_json(path):\n    return json.loads(path.read_text())\n\n\ndef file_hash(path):\n    return sha(path.read_bytes()) if path.exists() else None\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--layer\", choices=[\"16S\", \"16R\", \"17A\"], required=True)\n    parser.add_argument(\"--expected-parent\", required=True)\n    parser.add_argument(\"--run-id\", required=True)\n    args = parser.parse_args()\n    plan_root = Path(__file__).resolve().parent\n    plan = read_json(plan_root / \"plan.json\")\n    layer = next(item for item in plan[\"layers\"] if item[\"layer\"] == args.layer)\n    worktree = Path(plan[\"worktree\"])\n    packet = Path(layer[\"packet\"])\n    manifest_path = packet / \"candidate-manifest.json\"\n    assert file_hash(manifest_path) == layer[\"manifestSha256\"]\n    assert file_hash(packet / \"candidate.patch\") == layer[\"patchSha256\"]\n    manifest = read_json(manifest_path)\n    files = manifest[\"files\"]\n    assert len(files) == layer[\"pathCount\"] < 100\n    owning_paths = {item[\"path\"] for item in files}\n    assert len(owning_paths) == len(files)\n\n    def git(*argv):\n        return subprocess.check_output([\"git\", *argv], cwd=worktree).decode().strip()\n\n    assert not git(\"status\", \"--porcelain=v1\", \"--untracked-files=normal\")\n    assert git(\"branch\", \"--show-current\") == layer[\"baseBranch\"]\n    assert git(\"rev-parse\", \"HEAD\") == args.expected_parent\n    assert git(\"rev-parse\", layer[\"baseBranch\"]) == args.expected_parent\n    if args.layer == \"16S\":\n        assert args.expected_parent == plan[\"initialParent\"]\n    for branch, head in plan[\"preservedInitialRefs\"].items():\n        assert git(\"rev-parse\", branch) == head, branch\n    target_exists = subprocess.run(\n        [\"git\", \"show-ref\", \"--verify\", \"--quiet\", \"refs/heads/\" + layer[\"branch\"]],\n        cwd=worktree,\n    )\n    assert target_exists.returncode == 1, \"Target branch must be absent\"\n    for item in files:\n        assert file_hash(worktree / item[\"path\"]) == item[\"beforeSha256\"], item[\"path\"]\n        assert file_hash(packet / \"repository\" / item[\"path\"]) == item[\"afterSha256\"], item[\"path\"]\n\n    output = plan_root / \"runs\" / args.run_id\n    output.mkdir(parents=True, exist_ok=False)\n    receipt = {\n        \"layer\": args.layer,\n        \"parent\": args.expected_parent,\n        \"branch\": layer[\"branch\"],\n        \"inputManifestSha256\": layer[\"manifestSha256\"],\n        \"status\": \"started local materialization\",\n        \"commands\": [],\n    }\n\n    def save():\n        (output / \"receipt.json\").write_text(json.dumps(receipt, indent=2) + \"\\n\")\n\n    save()\n    try:\n        stack = subprocess.run(\n            [\"gh\", \"stack\", \"view\", \"--json\"], cwd=worktree, capture_output=True\n        )\n        (output / \"gh-stack-before.stdout\").write_bytes(stack.stdout)\n        (output / \"gh-stack-before.stderr\").write_bytes(stack.stderr)\n        assert stack.returncode == 0\n        stack_state = json.loads(stack.stdout)\n        assert stack_state[\"currentBranch\"] == layer[\"baseBranch\"]\n        assert not any(branch.get(\"needsRebase\") for branch in stack_state[\"branches\"])\n        subprocess.run([\"gh\", \"stack\", \"add\", layer[\"branch\"]], cwd=worktree, check=True)\n        assert git(\"branch\", \"--show-current\") == layer[\"branch\"]\n        assert git(\"rev-parse\", \"HEAD\") == args.expected_parent\n        for item in files:\n            destination = worktree / item[\"path\"]\n            assert file_hash(destination) == item[\"beforeSha256\"]\n            if item[\"afterSha256\"] is None:\n                destination.unlink()\n            else:\n                source = packet / \"repository\" / item[\"path\"]\n                destination.parent.mkdir(parents=True, exist_ok=True)\n                shutil.copyfile(source, destination)\n                mode = item.get(\"afterMode\") or format(source.stat().st_mode & 0o777, \"04o\")\n                destination.chmod(int(mode, 8))\n            assert file_hash(destination) == item[\"afterSha256\"]\n\n        environment = dict(os.environ)\n        environment[\"CI\"] = \"true\"\n        environment[\"PATH\"] = plan[\"toolPathPrefix\"] + os.pathsep + environment[\"PATH\"]\n        for name in [\"lint\", \"format:write\", \"release:validate\"]:\n            if name == \"release:validate\" and any(item[\"exitCode\"] != 0 for item in receipt[\"commands\"]):\n                break\n            log = output / (name.replace(\":\", \"-\") + \".log\")\n            with log.open(\"wb\") as handle:\n                result = subprocess.run([\"bun\", \"run\", name], cwd=worktree, env=environment,\n                                        stdout=handle, stderr=subprocess.STDOUT)\n            receipt[\"commands\"].append({\"argv\": [\"bun\", \"run\", name],\n                                         \"exitCode\": result.returncode, \"logSha256\": file_hash(log)})\n            save()\n\n        changed = set(git(\"diff\", \"--name-only\", args.expected_parent).splitlines())\n        changed.update(git(\"ls-files\", \"--others\", \"--exclude-standard\").splitlines())\n        changed.discard(\"\")\n        receipt[\"changedPaths\"] = sorted(changed)\n        receipt[\"unexpectedChangedPaths\"] = sorted(changed - owning_paths)\n        receipt[\"missingChangedPaths\"] = sorted(owning_paths - changed)\n        receipt[\"outputs\"] = [{\"path\": item[\"path\"],\n                                 \"proposedSha256\": item[\"afterSha256\"],\n                                 \"materializedSha256\": file_hash(worktree / item[\"path\"])}\n                                for item in files]\n        receipt[\"sourceChangesAfterFormatting\"] = [item[\"path\"] for item in receipt[\"outputs\"]\n                                                   if item[\"proposedSha256\"] != item[\"materializedSha256\"]]\n        assert changed == owning_paths, \"Unexpected scope after canonical prechecks\"\n        assert len(receipt[\"commands\"]) == 3 and all(item[\"exitCode\"] == 0 for item in receipt[\"commands\"])\n        subprocess.run([\"git\", \"diff\", \"--check\"], cwd=worktree, check=True)\n        receipt[\"status\"] = \"prechecks passed; inspect final delta, then commit and bind actual-head gates\"\n        receipt[\"nextLayerBoundary\"] = \"If any proposed bytes changed, rebind the next packet before invoking it.\"\n        save()\n    except BaseException as error:\n        receipt[\"status\"] = \"stopped; preserve source and logs for bounded correction\"\n        receipt[\"failure\"] = repr(error)\n        save()\n        raise\n\n\nif __name__ == \"__main__\":\n    main()\n"},"started_at_ms":1788571961348,"completed_at_ms":1788571961348}}
{"timestamp":"2026-09-05T01:32:41.371Z","ordinal":20374,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a06cdc-629f-7b82-8a80-b940922d7571","turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","item":{"type":"CommandExecution","id":"exec-7c29226e-6373-4708-9f4e-385c0d773086","process_id":"92461","command":["/bin/zsh","-lc","cat prefix-runtime-verification/fresh-remaining-source-preparation/README.md && cat prefix-runtime-verification/fresh-remaining-source-preparation/static-audit.json && sed -n '1,160p' prefix-runtime-verification/fresh-remaining-source-preparation/ordinary-15.py"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto-stack-review","parsed_cmd":[{"type":"read","cmd":"cat prefix-runtime-verification/fresh-remaining-source-preparation/README.md","name":"README.md","path":"prefix-runtime-verification/fresh-remaining-source-preparation/README.md"},{"type":"read","cmd":"cat prefix-runtime-verification/fresh-remaining-source-preparation/static-audit.json","name":"static-audit.json","path":"prefix-runtime-verification/fresh-remaining-source-preparation/static-audit.json"},{"type":"read","cmd":"sed -n '1,160p' prefix-runtime-verification/fresh-remaining-source-preparation/ordinary-15.py","name":"ordinary-15.py","path":"prefix-runtime-verification/fresh-remaining-source-preparation/ordinary-15.py"}],"source":"unified_exec_startup","status":"completed","stdout":"# Remaining fresh source preparation\n\nPrepared for root review only. No source gate, compiler, test, PostgreSQL, image or runtime invocation has run from this preparation. The proof checkout and local refs were not modified.\n\n`manifest.json` binds all13 current heads and their exact ordinary source commands. Each `ordinary-<layer>-invocation.json` has a separate runner that requires an actual future root slot grant and the clean detached target checkout. The placeholder grant is rejected. Result directories are unique and may not already exist; failures stop immediately with no retry or automatic next layer.\n\nFresh full canonical server/app suites and a separate root-owned complete PostgreSQL17 suite are required for every head. Historical artifacts only establish the existing supplemental verification scope. Dedicated strict probes are preserved for12a,12b,13,14,15 with58,47,61,35,54 roots respectively. Only15 adds its existing five-file Node tooling lint probe. Compiler configuration and complete diagnostics are unchanged; only source/output paths are relocated. The runner retains the reviewed process-group ownership helper by its exact hash.\n\nNo image or runtime invocation is prepared. Root must first obtain actual source and PostgreSQL proof, then prepare and review the next gate separately. All prepared inputs/manifests are0600 under0700 directories; code snapshots are0644. Static preparation checks are recorded in the manifest. No local lint, formatter, compiler or suite was invoked during this bounded preparation.\n{\n  \"status\": \"static-preparation-audit-passed\",\n  \"recordedAt\": \"2026-09-05T01:30:27.463885+00:00\",\n  \"manifestSha256\": \"82bbbd58bd935a3e2e9b67c1b7d78e0daf68158aaae18e9b5a36ca291e317976\",\n  \"preparationReceiptSha256\": \"50e4912dd29eb752c9f37e1c4da7c7379cfb0d5dcf784b3d7c754fb62894eac3\",\n  \"layerCount\": 13,\n  \"preparedFilesValidatedBeforeThisAudit\": 59,\n  \"sourceExecutions\": 0,\n  \"compilerExecutions\": 0,\n  \"testExecutions\": 0,\n  \"databaseExecutions\": 0,\n  \"networkCalls\": 0,\n  \"strictRoots\": {\n    \"12a\": 58,\n    \"12b\": 47,\n    \"13\": 61,\n    \"14\": 35,\n    \"15\": 54\n  },\n  \"checks\": [\n    \"Retained artifact hashes and modes match preparation receipt\",\n    \"All runner Python syntax parsed without import or execution\",\n    \"Per-layer source commands retain complete canonical server/app suites without forwarded selectors\",\n    \"Source invocation SHA pin is present in each runner\",\n    \"Every runner guards bound refs, parent and detached clean source before and after gates\",\n    \"Every strict probe relocation reverses to byte-identical original source\",\n    \"Every original probe and prior verification-scope artifact still matches its recorded hash\",\n    \"New preparation directory and every new probe parent are mode0700\"\n  ],\n  \"existingSharedAncestorCaveat\": {\n    \"paths\": {\n      \"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification\": \"0755\",\n      \"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review\": \"0755\"\n    },\n    \"changed\": false,\n    \"reason\": \"These are existing shared root-owned artifact directories; this bounded preparation created only its own private0700 subtree. Reported to root.\",\n    \"privatePreparationFilesExposed\": false\n  },\n  \"concreteExecutionPrerequisites\": [\n    \"Root selects the clean detached exact head after releasing its active slot\",\n    \"Root reviews the prepared invocation and supplies a real source execution slot grant\",\n    \"Each source result must exist and pass before the root-owned full PostgreSQL17 gate\",\n    \"Only after actual source and PostgreSQL proof may image/runtime invocation preparation proceed\"\n  ]\n}\n\"\"\"Prepared exact15 ordinary source gates. Execution requires explicit root grant.\"\"\"\nimport argparse\nimport hashlib\nimport importlib.util\nimport json\nimport os\nimport signal\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nREVIEW = HERE.parent.parent\nROOT = REVIEW.parent / \"evorto-stack-main\"\nPINNED_HELPER_SHA = \"820f0fdd78f77d8cd3dc98586d661b58c1b86d10847c9b2b3d07d1f4253b2215\"\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--execute\", action=\"store_true\")\n    parser.add_argument(\"--slot-grant\")\n    args = parser.parse_args()\n    invocation_path = HERE / \"ordinary-15-invocation.json\"\n    invocation = json.loads(invocation_path.read_text())\n    if not args.execute:\n        print(json.dumps(invocation, indent=2))\n        return\n    if not args.slot_grant or args.slot_grant.strip() == \"ACTUAL_ROOT_GRANT_REQUIRED\":\n        raise RuntimeError(\"An actual explicit root grant is required\")\n    if hashlib.sha256(invocation_path.read_bytes()).hexdigest() != \"f829eb95759f2e76da0bd1066b9bafa1f4857d2f06ceb3dd4ec0faab86f1b04b\":\n        raise RuntimeError(\"Prepared source invocation changed\")\n    helper_path = HERE.parent / \"post-replay-gates\" / \"runtime-runner.before.py\"\n    if hashlib.sha256(helper_path.read_bytes()).hexdigest() != PINNED_HELPER_SHA:\n        raise RuntimeError(\"Reviewed process ownership helper changed\")\n    spec = importlib.util.spec_from_file_location(\"reviewed_runtime_ownership\", helper_path)\n    helper = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(helper)\n    helper.ROOT = ROOT\n    helper.REVIEW = REVIEW\n    os.umask(0o022)\n    env = dict(os.environ)\n    for key in (\"NODE_OPTIONS\", \"BUN_OPTIONS\"):\n        env.pop(key, None)\n    env[\"PATH\"] = invocation[\"environment\"][\"PATHPrefix\"] + \":\" + env[\"PATH\"]\n    env[\"CI\"] = \"true\"\n    helper.require(helper.read(env, \"node\", \"--version\") == \"v24.15.0\", \"Pinned Node version unavailable\")\n    helper.require(helper.read(env, \"bun\", \"--version\") == \"1.3.14\", \"Pinned Bun version unavailable\")\n    expected = {\"head\": invocation[\"head\"], \"tree\": invocation[\"tree\"]}\n    helper.require(helper.read(env, \"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == \"HEAD\", \"Proof must be detached\")\n    helper.require(helper.read(env, \"git\", \"rev-parse\", \"HEAD^\") == invocation[\"parent\"], \"Parent changed\")\n    def bound_source():\n        helper.require(helper.read(env, \"git\", \"rev-parse\", \"refs/heads/\" + invocation[\"branch\"]) == invocation[\"head\"], \"Layer ref changed\")\n        helper.require(helper.read(env, \"git\", \"rev-parse\", \"refs/heads/\" + invocation[\"baseBranch\"]) == invocation[\"base\"], \"Base ref changed\")\n        helper.require(helper.read(env, \"git\", \"rev-parse\", \"HEAD^\") == invocation[\"parent\"], \"Parent changed\")\n        helper.require(helper.read(env, \"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == \"HEAD\", \"Proof must remain detached\")\n        for artifact in invocation[\"boundExternalArtifacts\"]:\n            helper.require(helper.sha(Path(artifact[\"path\"])) == artifact[\"sha256\"], \"Prepared external probe/input changed\")\n        return helper.source(env, expected)\n    source_before = bound_source()\n    package = json.loads(helper.read(env, \"git\", \"show\", invocation[\"head\"] + \":package.json\"))\n    helper.require(all(package[\"scripts\"][k] == v for k, v in invocation[\"canonicalSourceScripts\"].items()), \"Canonical script changed\")\n    directory = Path(invocation[\"resultDirectory\"])\n    directory.parent.mkdir(mode=0o700, parents=True, exist_ok=True)\n    directory.parent.chmod(0o700)\n    directory.mkdir(mode=0o700, exist_ok=False)\n    receipt = {\"status\": \"running\", **expected, \"parent\": invocation[\"parent\"], \"sourceBefore\": source_before,\n               \"startedAt\": helper.now(), \"slotGrant\": args.slot_grant, \"commands\": {}, \"errors\": [],\n               \"invocationSha256\": helper.sha(invocation_path), \"runnerSha256\": helper.sha(Path(__file__)),\n               \"helperSha256\": PINNED_HELPER_SHA,\n               \"tools\": {\"node\": helper.read(env, \"node\", \"--version\"), \"bun\": helper.read(env, \"bun\", \"--version\")}}\n    save = lambda: helper.private_json(directory / \"receipt.json\", receipt)\n    save()\n    try:\n        for step in invocation[\"commands\"]:\n            bound_source()\n            step_env = dict(env)\n            if step[\"name\"] == \"infra\":\n                step_env.update({key: invocation[\"environment\"][key] for key in (\"TF_PLUGIN_CACHE_DIR\", \"TF_CLI_ARGS_init\")})\n            previous_umask = os.umask(0o077 if step[\"name\"] in (\"types\", \"tooling-lint\") else 0o022)\n            try:\n                helper.run_command(step[\"name\"], step[\"command\"], step_env, directory,\n                                   invocation[\"processTimeoutSeconds\"], receipt, save)\n            finally:\n                os.umask(previous_umask)\n            bound_source()\n            print(step[\"name\"] + \" passed\", flush=True)\n        receipt[\"status\"] = \"source-gates-passed; fresh root PG required before image/runtime preparation\"\n    except BaseException as error:\n        receipt[\"status\"] = \"failed\"\n        receipt[\"errors\"].append(helper.failure(error, \"ordinary-source\"))\n        raise\n    finally:\n        receipt[\"completedAt\"] = helper.now()\n        try:\n            receipt[\"sourceAfter\"] = bound_source()\n        except BaseException as error:\n            receipt[\"status\"] = \"failed\"\n            receipt[\"errors\"].append(helper.failure(error, \"final-source\"))\n        save()\n        print(json.dumps({\"status\": receipt[\"status\"], \"receipt\": str(directory / \"receipt.json\")}))\n    if receipt[\"status\"] == \"failed\":\n        raise SystemExit(1)\n\n\nif __name__ == \"__main__\":\n    def interrupt(signum, frame):\n        raise KeyboardInterrupt()\n    signal.signal(signal.SIGTERM, interrupt)\n    signal.signal(signal.SIGINT, interrupt)\n    main()\n","stderr":"","aggregated_output":"# Remaining fresh source preparation\n\nPrepared for root review only. No source gate, compiler, test, PostgreSQL, image or runtime invocation has run from this preparation. The proof checkout and local refs were not modified.\n\n`manifest.json` binds all13 current heads and their exact ordinary source commands. Each `ordinary-<layer>-invocation.json` has a separate runner that requires an actual future root slot grant and the clean detached target checkout. The placeholder grant is rejected. Result directories are unique and may not already 
ists():\n            item.update(sha256=hashlib.sha256(log.read_bytes()).hexdigest(), bytes=log.stat().st_size)\n        receipt['status'] = 'failed' if item['status'] != 'passed' else 'running'\n        save()\n    print(name + ': ' + item['status'] + ' ' + str(item['passed']), flush=True)\n    if not complete:\n        raise SystemExit(1)\n    assert source() == before\nreceipt.update(status='passed', sourceAfter=source(), completedAt=datetime.now(timezone.utc).isoformat())\nsave()\nprint('Complete runtime and local publication acceptance passed.', flush=True)\n","exit_code":0,"duration":{"secs":0,"nanos":5667},"formatted_output":"from pathlib import Path\nfrom datetime import datetime, timezone\nimport os, subprocess, json, time, urllib.request, urllib.error, sys, socket, signal\nroot=Path('/Users/hedde/.codex/worktrees/aa9e/evorto');out=root.parent/'evorto-stack-review'\nhead=sys.argv[1];prefix=sys.argv[2];project='evorto-assembly-review-20260904'\nenv=dict(os.environ);env.pop('CI',None);env.pop('NO_WEBSERVER',None)\nenv['PATH']='/Users/hedde/.nvm/versions/node/v24.15.0/bin:/Users/hedde/.bun/bin:'+env['PATH']\nenv.update(APP_HOST_PORT='4200',POSTGRES_HOST_PORT='55722',MINIO_HOST_PORT='9025',MINIO_CONSOLE_HOST_PORT='9667',MAILPIT_HOST_PORT='14035',COMPOSE_PROJECT_NAME=project)\ndef read(*args):return subprocess.check_output(args,cwd=root,env=env,text=True).strip()\ndef stable():\n assert read('git','rev-parse','HEAD')==head\n assert not read('git','status','--porcelain=v1')\nstable();assert read('node','--version')=='v24.15.0';assert read('bun','--version')=='1.3.14'\nassert not read('docker','ps','-aq','--filter','label=com.docker.compose.project='+project)\nfor port in [4200,55722,9025,9667,14035]:\n with socket.socket() as sock:assert sock.connect_ex(('127.0.0.1',port))!=0,port\nlog=out/(prefix+'-webserver.log');ownerFile=out/(prefix+'-runtime-owner.json');stableFile=out/(prefix+'-stable-runtime.json');assert not log.exists() and not ownerFile.exists() and not stableFile.exists()\nwith log.open('x') as handle:\n log.chmod(0o600)\n proc=subprocess.Popen(['bun','run','docker:webserver'],cwd=root,env=env,stdout=handle,stderr=subprocess.STDOUT,start_new_session=True)\n owner={'head':head,'tree':read('git','rev-parse','HEAD^{tree}'),'project':project,'pid':proc.pid,'pgid':os.getpgid(proc.pid),'startedAt':datetime.now(timezone.utc).isoformat(),'command':['bun','run','docker:webserver'],'log':log.name,'ready':False}\n def save(file,value):file.write_text(json.dumps(value,indent=2)+chr(10));file.chmod(0o600)\n save(ownerFile,owner);print('Owned runtime started; private log '+log.name,flush=True)\n try:\n  deadline=time.monotonic()+1200\n  while True:\n   if proc.poll() is not None:raise RuntimeError('Runtime exited before readiness; inspect private log')\n   status=None\n   try:\n    with urllib.request.urlopen('http://localhost:4200/readyz',timeout=2) as response:status=response.status\n   except (urllib.error.URLError,TimeoutError):pass\n   if status==204:break\n   if time.monotonic()>deadline:raise TimeoutError('Runtime did not become ready within1200seconds')\n   time.sleep(2)\n  stable()\n  ids=read('docker','ps','-q','--no-trunc','--filter','label=com.docker.compose.project='+project,'--filter','label=com.docker.compose.service=evorto').splitlines();assert len(ids)==1\n  container=json.loads(read('docker','inspect',ids[0]))[0];assert container['State']['Running'] and container['Config']['Labels']['com.docker.compose.project']==project\n  image=json.loads(read('docker','image','inspect',container['Image']))[0]\n  owner.update(ready=True,readinessHttpStatus=204,containerId=container['Id'],imageId=container['Image'],imageArchitecture=image['Architecture'],imageOs=image['Os'],observedAt=datetime.now(timezone.utc).isoformat())\n  save(stableFile,owner);print('Runtime ready204 at exact'+head,flush=True)\n  code=proc.wait();print('Owned runtime supervisor exited'+str(code),flush=True)\n except BaseException:\n  if proc.poll() is None:\n   os.killpg(owner['pgid'],signal.SIGINT)\n   try:proc.wait(timeout=120)\n   except subprocess.TimeoutExpired:\n    os.killpg(owner['pgid'],signal.SIGTERM);proc.wait(timeout=30)\n  raise\nsys.exit(code if code >= 0 else 128 - code)\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nroot = Path('/Users/hedde/.codex/worktrees/aa9e/evorto')\nout = root.parent / 'evorto-stack-review'\npages = root.parent / 'evorto-pages-review'\nhead, prefix = sys.argv[1:3]\nenv = dict(os.environ)\nenv.pop('CI', None)\nenv['PATH'] = '/Users/hedde/.nvm/versions/node/v24.15.0/bin:/Users/hedde/.bun/bin:' + env['PATH']\nenv.update(APP_HOST_PORT='4200', POSTGRES_HOST_PORT='55722', MINIO_HOST_PORT='9025',\n           MINIO_CONSOLE_HOST_PORT='9667', MAILPIT_HOST_PORT='14035',\n           COMPOSE_PROJECT_NAME='evorto-assembly-review-20260904', NO_WEBSERVER='true')\n\ndef read(*args, cwd=root):\n    return subprocess.check_output(args, cwd=cwd, env=env, text=True).strip()\n\ndef source():\n    value = {'head': read('git', 'rev-parse', 'HEAD'),\n             'tree': read('git', 'rev-parse', 'HEAD^{tree}'),\n             'status': read('git', 'status', '--porcelain=v1')}\n    assert value['head'] == head and not value['status']\n    return value\n\nbefore = source()\nassert read('node', '--version') == 'v24.15.0'\nassert read('bun', '--version') == '1.3.14'\nruntime = json.loads((out / (prefix + '-stable-runtime.json')).read_text())\nassert runtime['head'] == head and runtime['tree'] == before['tree']\ncontainer = json.loads(read('docker', 'inspect', runtime['containerId']))[0]\nassert container['State']['Running'] and container['Image'] == runtime['imageId']\nassert container['Config']['Labels']['com.docker.compose.project'] == env['COMPOSE_PROJECT_NAME']\nwith urllib.request.urlopen('http://localhost:4200/readyz', timeout=10) as response:\n    assert response.status == 204\nreceipt_path = out / (prefix + '-runtime-gates.json')\nassert not receipt_path.exists()\nreceipt = {'sourceBefore': before, 'runtime': runtime, 'startedAt': datetime.now(timezone.utc).isoformat(),\n           'status': 'running', 'gates': {}}\n\ndef save():\n    receipt_path.write_text(json.dumps(receipt, indent=2) + '\\n')\n    receipt_path.chmod(0o600)\n\nsave()\nfor name, script in [('functional', 'test:e2e'), ('documentation', 'test:e2e:docs'),\n                     ('providerIntegration', 'test:e2e:integration'),\n                     ('liveEsncardRelease', 'test:e2e:live-esncard:release'),\n                     ('docsPublication', 'test:e2e:docs:publish')]:\n    assert source() == before\n    command = ['bun', 'run', script]\n    run_env = dict(env)\n    if name == 'docsPublication':\n        assert not read('git', 'status', '--porcelain=v1', cwd=pages)\n        run_env['EVORTO_PAGES_ROOT'] = str(pages)\n    log = out / (prefix + '-' + name + '.log')\n    item = {'command': command, 'startedAt': datetime.now(timezone.utc).isoformat(),\n            'status': 'running', 'log': log.name}\n    if name == 'docsPublication':\n        item.update(pagesRoot=str(pages), pagesHeadBefore=read('git', 'rev-parse', 'HEAD', cwd=pages))\n    receipt['gates'][name] = item\n    save()\n    start = time.monotonic()\n    print('Starting ' + name, flush=True)\n    try:\n        with os.fdopen(os.open(log, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as handle:\n            result = subprocess.run(command, cwd=root, env=run_env, stdout=handle,\n                                    stderr=subprocess.STDOUT, timeout=1200)\n        raw = re.sub(r'\\x1b\\[[0-9;]*m', '', log.read_text())\n        collected = [int(n) for n in re.findall(r'Running (\\d+) tests? using', raw)]\n        passed = [int(n) for n in re.findall(r'(?m)^\\s*(\\d+) passed\\s*\\(', raw)]\n        bad = re.findall(r'(?m)^\\s*\\d+ (?:failed|skipped|flaky|interrupted|did not run)\\b', raw)\n        complete = result.returncode == 0 and len(collected) == 1 and collected == passed and not bad\n        item.update(exitCode=result.returncode, collected=collected, passed=passed,\n                    incompleteSummaries=bad, allCollectedPassed=complete,\n                    status='passed' if complete else 'failed')\n        if name == 'docsPublication':\n            item['pagesHeadAfter'] = read('git', 'rev-parse', 'HEAD', cwd=pages)\n            item['pagesChangedPaths'] = read('git', 'status', '--porcelain=v1', '--untracked-files=all', cwd=pages).splitlines()\n            assert item['pagesHeadAfter'] == item['pagesHeadBefore']\n    except BaseException as error:\n        item.update(status='failed', exceptionType=type(error).__name__)\n        raise\n    finally:\n        item.update(seconds=round(time.monotonic() - start, 3), completedAt=datetime.now(timezone.utc).isoformat())\n        if log.exists():\n            item.update(sha256=hashlib.sha256(log.read_bytes()).hexdigest(), bytes=log.stat().st_size)\n        receipt['status'] = 'failed' if item['status'] != 'passed' else 'running'\n        save()\n    print(name + ': ' + item['status'] + ' ' + str(item['passed']), flush=True)\n    if not complete:\n        raise SystemExit(1)\n    assert source() == before\nreceipt.update(status='passed', sourceAfter=source(), completedAt=datetime.now(timezone.utc).isoformat())\nsave()\nprint('Complete runtime and local publication acceptance passed.', flush=True)\n"},"started_at_ms":1788573098368,"completed_at_ms":1788573098369}}

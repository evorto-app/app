{"timestamp":"2026-09-05T00:52:49.403Z","ordinal":19296,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a06cdc-629f-7b82-8a80-b940922d7571","turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","item":{"type":"CommandExecution","id":"exec-1e5bfc56-bb02-4f2d-b39f-b369d1197baf","process_id":"65218","command":["/bin/zsh","-lc","cat /Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification/post-replay-gates/runtime-ready-targets.patch"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto","parsed_cmd":[{"type":"read","cmd":"cat /Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification/post-replay-gates/runtime-ready-targets.patch","name":"runtime-ready-targets.patch","path":"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification/post-replay-gates/runtime-ready-targets.patch"}],"source":"unified_exec_startup","status":"completed","stdout":"--- a/run.py\n+++ b/run.py\n@@ -265,14 +265,33 @@\n     require(plan[\"inventory\"][\"sha256\"] == INVENTORY_SHA and sha(inventory_path) == INVENTORY_SHA, \"Inventory changed\")\n     inventory = json.loads(inventory_path.read_text())\n     identity_keys = (\"layer\", \"branch\", \"head\", \"ordinaryReceipt\", \"receiptSha256\")\n-    require([{key: row[key] for key in identity_keys} for row in plan[\"entries\"]] == inventory[\"heads\"], \"Plan does not bind every inventoried ordinary receipt\")\n-    require(sha(REVIEW / \"current-local-stack.json\") == plan[\"sourceStackReceiptSha256\"], \"Stack inventory changed; refresh the reviewed plan\")\n+    require(plan[\"historicalOrdinaryEntries\"] == inventory[\"heads\"], \"Historical ordinary receipt bindings changed\")\n+    for historical in plan[\"historicalOrdinaryEntries\"]:\n+        require(sha(REVIEW / historical[\"ordinaryReceipt\"]) == historical[\"receiptSha256\"], \"A historical ordinary receipt changed\")\n+    stack_path = REVIEW / \"current-local-stack.json\"\n+    require(sha(stack_path) == plan[\"sourceStackReceiptSha256\"], \"Stack inventory changed; refresh the reviewed plan\")\n+    stack = json.loads(stack_path.read_text())\n+    ref_keys = (\"layer\", \"branch\", \"head\", \"tree\")\n+    expected_refs = [{key: str(row[key]) if key == \"layer\" else row[key] for key in ref_keys} for row in stack[\"layers\"]]\n+    require([{key: row[key] for key in ref_keys} for row in plan[\"registeredPrefixes\"]] == expected_refs, \"Plan does not bind every registered prefix\")\n     require(plan[\"commands\"] == COMMANDS, \"Canonical commands changed\")\n-    for current in plan[\"entries\"]:\n-        require(sha(REVIEW / current[\"ordinaryReceipt\"]) == current[\"receiptSha256\"], \"An ordinary receipt changed\")\n+    for current in plan[\"registeredPrefixes\"]:\n         require(read(env, \"git\", \"rev-parse\", \"refs/heads/\" + current[\"branch\"]) == current[\"head\"], \"A registered prefix head changed\")\n+        require(read(env, \"git\", \"rev-parse\", current[\"head\"] + \"^{tree}\") == current[\"tree\"], \"A registered prefix tree changed\")\n         package = json.loads(read(env, \"git\", \"show\", current[\"head\"] + \":package.json\"))\n         require(all(package[\"scripts\"][key] == value for key, value in current[\"canonicalScripts\"].items()), \"A canonical script binding changed\")\n+    require(len({row[\"head\"] for row in plan[\"entries\"]}) == len(plan[\"entries\"]), \"Duplicate runnable head\")\n+    for runnable in plan[\"entries\"]:\n+        registered = [row for row in plan[\"registeredPrefixes\"] if row[\"head\"] == runnable[\"head\"]]\n+        require(len(registered) == 1 and all(runnable[key] == registered[0][key] for key in ref_keys), \"Runnable target is not an exact registered prefix\")\n+        receipt_path = REVIEW / runnable[\"ordinaryReceipt\"]\n+        require(sha(receipt_path) == runnable[\"receiptSha256\"], \"A runnable ordinary receipt changed\")\n+        ordinary = json.loads(receipt_path.read_text())\n+        require(ordinary[\"head\"] == runnable[\"head\"] and ordinary[\"tree\"] == runnable[\"tree\"], \"Ordinary proof is not bound to the runnable identity\")\n+        approval_path = REVIEW / runnable[\"readinessApproval\"]\n+        require(sha(approval_path) == runnable[\"readinessApprovalSha256\"], \"Readiness approval changed\")\n+        approval = json.loads(approval_path.read_text())\n+        require(approval[\"status\"] == \"approved\" and approval[\"head\"] == runnable[\"head\"] and approval[\"tree\"] == runnable[\"tree\"] and approval[\"ordinaryReceiptSha256\"] == runnable[\"receiptSha256\"], \"Runnable target is not approved with this ordinary proof\")\n     source_before = source(env)\n     require(read(env, \"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == \"HEAD\", \"Proof checkout must be detached\")\n     require(read(env, \"node\", \"--version\") == \"v24.15.0\" and read(env, \"bun\", \"--version\") == \"1.3.14\", \"Pinned tools unavailable\")\n@@ -287,7 +306,7 @@\n     directory.chmod(0o700)\n     receipt = {\"status\": \"running\", \"startedAt\": now(), \"head\": entry[\"head\"], \"tree\": entry[\"tree\"], \"slotGrant\": args.slot_grant,\n                \"runnerSha256\": sha(Path(__file__)), \"planSha256\": sha(HERE / \"plan.json\"), \"inventorySha256\": INVENTORY_SHA,\n-               \"sourceBeforeSelection\": source_before, \"ordinaryReceiptCountValidated\": len(plan[\"entries\"]),\n+               \"sourceBeforeSelection\": source_before, \"ordinaryReceiptCountValidated\": len(plan[\"entries\"]), \"registeredPrefixCountValidated\": len(plan[\"registeredPrefixes\"]), \"historicalReceiptCountValidated\": len(plan[\"historicalOrdinaryEntries\"]),\n                \"project\": project, \"ports\": entry[\"ports\"], \"commands\": {}, \"artifacts\": {}, \"errors\": []}\n     save = lambda: private_json(directory / \"receipt.json\", receipt)\n     save()\n","stderr":"","aggregated_output":"--- a/run.py\n+++ b/run.py\n@@ -265,14 +2
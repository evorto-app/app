ory-dialog/create-edit-category-dialog.component.ts\",\n        \"src/app/templates/shared/template-form/template-addon-form.schema.ts\",\n        \"src/app/templates/shared/template-form/template-addon-form.utilities.spec.ts\",\n        \"src/app/templates/shared/template-form/template-addon-form.utilities.ts\",\n        \"src/app/templates/shared/template-form/template-form.utilities.spec.ts\",\n        \"src/app/templates/shared/template-form/template-form.utilities.ts\",\n        \"src/app/templates/shared/template-form/template-general-form.schema.ts\",\n        \"src/app/templates/shared/template-form/template-question-form.component.html\",\n        \"src/app/templates/shared/template-form/template-question-form.component.ts\",\n        \"src/app/templates/shared/template-form/template-question-form.schema.ts\",\n        \"src/app/templates/shared/template-form/template-question-form.utilities.ts\",\n        \"src/app/templates/shared/template-form/template-registration-option-form.schema.ts\",\n        \"src/app/templates/shared/template-form/template-registration-option-form.utilities.spec.ts\",\n        \"src/app/templates/shared/template-form/template-registration-option-form.utilities.ts\",\n        \"src/app/templates/template-authoring-fail-loud.spec.ts\",\n        \"src/app/templates/template-create-event/template-create-event.component.html\",\n        \"src/app/templates/template-create-event/template-create-event.component.spec.ts\",\n        \"src/app/templates/template-create-event/template-create-event.component.ts\",\n        \"src/app/templates/template-create/template-create.component.html\",\n        \"src/app/templates/template-create/template-create.component.spec.ts\",\n        \"src/app/templates/template-create/template-create.component.ts\",\n        \"src/app/templates/template-details/template-details.component.html\",\n        \"src/app/templates/template-details/template-details.component.spec.ts\",\n        \"src/app/templates/template-details/template-details.component.ts\",\n        \"src/app/templates/template-edit/template-edit.component.html\",\n        \"src/app/templates/template-edit/template-edit.component.spec.ts\",\n        \"src/app/templates/template-edit/template-edit.component.ts\",\n        \"src/app/templates/template-list/template-list.component.html\",\n        \"src/app/templates/template-list/template-list.component.ts\",\n        \"src/db/schema/event-templates.ts\",\n        \"src/server/effect/rpc/app-rpcs.web-handler.ts\",\n        \"src/server/effect/rpc/handlers/events/events-lifecycle.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/events/events-lifecycle.handlers.ts\",\n        \"src/server/effect/rpc/handlers/icons.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/icons.handlers.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform-templates.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform-templates.handlers.ts\",\n        \"src/server/effect/rpc/handlers/platform/platform.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates.handlers.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates.handlers.ts\",\n        \"src/server/effect/rpc/handlers/templates/simple-template.service.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/simple-template.service.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.query.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.query.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.service.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/template-graph.service.ts\",\n        \"src/server/effect/rpc/handlers/templates/templates-rpcs.schema.spec.ts\",\n        \"src/server/effect/rpc/handlers/templates/templates.errors.ts\",\n        \"src/server/payments/event-create-stripe-serialization.source.spec.ts\",\n        \"src/server/roles/tenant-rol
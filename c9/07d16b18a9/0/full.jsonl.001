ate references remain in the current17B first-party source with these outputs overlaid; platform references remain.\\n\\nFinal17B source/commit rebinding and independent source review remain prerequisites. No compiler, parser, tests, formatter, lint, runtime, database or network execution was performed for this proposal. These artifacts are source evidence only; root owns actual-head integration and gates.\\n{\\n  \\\"status\\\": \\\"Bounded source-only measurement; no output proposal or branch, final17C source rebind required\\\",\\n  \\\"sourcePathCount\\\": 6,\\n  \\\"releaseNoteAdditionalPath\\\": 1,\\n  \\\"projectedTotal\\\": 7,\\n  \\\"files\\\": [\\n    {\\n      \\\"path\\\": \\\"src/shared/rpc-contracts/app-rpcs/events.rpcs.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"71264e32835dfdbac4d9ce41ff1102f21b2658032ae143de0cc34a8f032fe6e8\\\",\\n      \\\"reference56e7Sha256\\\": \\\"e1fe0871a74434aafe7f7e6ee8be19382aa81c6472a4452b706ffaecc05677cc\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/server/effect/rpc/handlers/events/events-query.handlers.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"efefec6cfb447d302b20e64386be4a667657814ece3bfe575b41117e86785cc3\\\",\\n      \\\"reference56e7Sha256\\\": \\\"a4c9116953017bf2f1fec9cacdfecd17137997ba228a6e172ae11da2fb8ee00c\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/server/effect/rpc/handlers/events/events-query.handlers.postgres.spec.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"1ac233814722f784ed758c1561f90b44cb868df5d7d7550f96be078623d8b8c9\\\",\\n      \\\"reference56e7Sha256\\\": \\\"dbb6cd1dfbaf513b3ccc98f8aa0d17cc39c2352a62ca8612aef0c77dd464f35f\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/server/effect/rpc/handlers/events/events.handlers.spec.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"089a619f9be14698de14c856c55ef38dfe69e64ee53989332edb8bf2c9538fa4\\\",\\n      \\\"reference56e7Sha256\\\": \\\"8d80022cd9a88f25d12805ed84d18f4c0771c70b1e86ef280c39e18204147485\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/server/effect/rpc/handlers/events/events-rpcs.schema.spec.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"33949189b52ae81df5437c8f058bddd38768538cac9fee28355c78e62a010ac6\\\",\\n      \\\"reference56e7Sha256\\\": \\\"1ebd658adab03e881dc70345d3b4456b1754c649ba2a0a71b5b39dcb286327ff\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/app/events/event-registration-option/event-registration-option.component.ts\\\",\\n      \\\"provisional17BSha256\\\": \\\"394aadce29a80800afc365f54d8b610ac1a91836a1cd44aad749e63ea804e9ec\\\",\\n      \\\"reference56e7Sha256\\\": \\\"5d93b59cdc4487a3518bb9b60911ff69e0e79ca91922edd4e900476f8612dced\\\"\\n    }\\n  ],\\n  \\\"fieldBoundary\\\": [\\n    \\\"checkedInSpots\\\",\\n    \\\"registeredDescription\\\",\\n    \\\"roleIds\\\",\\n    \\\"stripeTaxRateId\\\"\\n  ],\\n  \\\"requiredChanges\\\": [\\n    \\\"Remove four properties from ordinary public option schema and returned projection.\\\",\\n    \\\"Stop selecting checkedInSpots and registeredDescription in public detail only; retain internal role IDs and tax-rate ID for eligibility, price labels and authorization.\\\",\\n    \\\"Keep real SQL discount/tenant fixture aligned with the two removed SELECT columns.\\\",\\n    \\\"Restore all five exact PostgreSQL field-absence assertions already captured.\\\",\\n    \\\"Adapt existing tax-label schema case to verify the reduced decoded record and intact label/price/question fields.\\\",\\n    \\\"Remove obsolete optional raw tax ID from EventRegistrationOptionView and its price-label adapter; no registration-option test currently supplies that member.\\\"\\n  ],\\n  \\\"notIncluded\\\": [\\n    \\\"creatorId\\\\u2192userIsCreator guard change (separate producer/guard boundary not required for these four fields)\\\",\\n    \\\"ordinary findOneForEdit legacy API retirement\\\",\\n    \\\"organizer-overview status projection\\\",\\n    \\\"any stored schema/tax/payment-field deletion\\\"\\n  ],\\n  \\\"proofBoundary\\\": \\\"No privacy closure claim until actual-parent tests pass; final17B PostgreSQL lifetime correction must be preserved before restoring assertions.\\\"\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"3f64cb\",\"wall_time_seconds\":5.002347916,\"session_id\":4723,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788571706.198651}}}

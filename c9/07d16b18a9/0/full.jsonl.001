{"timestamp":"2026-09-05T01:46:46.269Z","ordinal":20713,"type":"token_usage_record","payload":{"thread_id":"01a06cdc-629f-7b82-8a80-b940922d7571","turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","session_id":"01a06cdc-629f-7b82-8a80-b940922d7571","root_turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","response_id":"resp_0c5872428dbc2885016a9b7470272487d2a62d28b96fa872d7","usage":{"input_tokens":206572,"cached_input_tokens":204032,"cache_write_input_tokens":0,"output_tokens":864,"reasoning_output_tokens":774,"total_tokens":207436},"turn_token_usage":{"input_tokens":298053634,"cached_input_tokens":293394560,"cache_write_input_tokens":0,"output_tokens":959358,"reasoning_output_tokens":329272,"total_tokens":299012992},"thread_token_usage":{"input_tokens":298053634,"cached_input_tokens":293394560,"cache_write_input_tokens":0,"output_tokens":959358,"reasoning_output_tokens":329272,"total_tokens":299012992}}}
{"timestamp":"2026-09-05T01:46:46.312Z","ordinal":20714,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a06cdc-629f-7b82-8a80-b940922d7571","turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","item":{"type":"CommandExecution","id":"exec-1a30300c-7008-4146-8b88-2c951bf4b7ef","process_id":"97649","command":["/bin/zsh","-lc","cat next-layer-materialization-plan/materialize-source.py"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto-stack-review","parsed_cmd":[{"type":"read","cmd":"cat next-layer-materialization-plan/materialize-source.py","name":"materialize-source.py","path":"next-layer-materialization-plan/materialize-source.py"}],"source":"unified_exec_startup","status":"completed","stdout":"#!/usr/bin/env python3\n\"\"\"Apply one granted local source layer, then stop before staging or committing.\n\nSource preparation only until the coordinator grants an invocation. No GitHub\nread, push, inventory update, database operation or runtime gate is implemented.\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport signal\nimport stat\nimport subprocess\nimport time\n\n\nclass MaterializationError(RuntimeError):\n    pass\n\n\ndef require(condition, message):\n    if not condition:\n        raise MaterializationError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    require(not path.is_symlink(), f\"Symlink is not a source file: {path}\")\n    if not path.exists():\n        return None\n    require(path.is_file(), f\"Expected a regular file: {path}\")\n    return sha(path.read_bytes())\n\n\ndef expect_hash(path, expected):\n    observed = file_hash(path)\n    require(observed == expected, f\"Hash mismatch {path}: expected {expected}, observed {observed}\")\n\n\ndef private_file(path):\n    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    os.fchmod(descriptor, 0o600)\n    return os.fdopen(descriptor, \"wb\")\n\n\ndef private_directory(path, fresh=False):\n    try:\n        path.mkdir(mode=0o700)\n    except FileExistsError:\n        require(not fresh, f\"Run already exists; choose a fresh run-id: {path}\")\n    details = path.lstat()\n    require(stat.S_ISDIR(details.st_mode) and details.st_uid == os.getuid(),\n            f\"Expected an owned directory, without symlinks: {path}\")\n    path.chmod(0o700)\n\n\ndef contained_file(root, name):\n    relative = Path(name)\n    require(not relative.is_absolute() and relative.parts and\n            all(part not in (\".\", \"..\", \".git\") for part in relative.parts),\n            f\"Invalid owning path: {name!r}\")\n    destination = root / relative\n    current = root\n    for part in relative.parts:\n        current = current / part\n        require(not current.is_symlink(), f\"Symlink in owning path: {current}\")\n    require(destination.resolve().is_relative_to(root.resolve()), f\"Path escapes root: {name}\")\n    return destination\n\n\nclass Run:\n    def __init__(self, output, receipt):\n        self.output = output\n        self.receipt = receipt\n        self.signals = []\n        self.unreaped = []\n        self.environment = dict(os.environ)\n        self.cwd = output\n        self.save()\n\n    def save(self):\n        temporary = self.output / \"receipt.next.json\"\n        with private_file(temporary) as handle:\n            handle.write((json.dumps(self.receipt, indent=2) + \"\\n\").encode())\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, self.output / \"receipt.json\")\n\n    def interrupted(self):\n        require(not self.signals, f\"Interrupted by signals {self.signals}\")\n\n    def observe_group(self, group, record):\n        # Fixed read-only ps has no children. Its distinct PID is retained and\n        # reaped independently; it is never confused with the command group.\n        observer = subprocess.Popen([\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"],\n                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                                    stderr=subprocess.PIPE, start_new_session=True,\n                                    env={\"LC_ALL\": \"C\", \"PATH\": \"/usr/bin:/bin\"})\n        observation = {\"pid\": observer.pid, \"argv\": [\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"]}\n        record.setdefault(\"groupObservers\", []).append(observation)\n        try:\n            stdout, stderr = observer.communicate(timeout=2)\n        except BaseException as original:\n            failures = []\n            try:\n                observer.kill()\n            except BaseException as error:\n                failures.append(repr(error))\n            try:\n                observer.wait(timeout=2)\n            except BaseException as error:\n                self.unreaped.append(observer)\n                failures.append(repr(error))\n            observation.update(failure=repr(original), cleanupFailures=failures)\n            raise MaterializationError(f\"Group observer failed: {original!r}; cleanup={failures!r}\") from original\n        finally:\n            for handle in (observer.stdout, observer.stderr):\n                if handle is not None:\n                    handle.close()\n        observation.update(exitCode=observer.returncode, stderr=stderr.decode(errors=\"replace\"))\n        require(observer.returncode == 0, f\"Group observer failed: {observation!r}\")\n        members = []\n        for line in stdout.decode().splitlines():\n            pid, pgid, state = line.split()\n            if int(pgid) == group:\n                members.append({\"pid\": int(pid), \"state\": state})\n        return members\n\n    def command(self, argv, timeout=60, accepted=(0,)):\n        self.interrupted()\n        require(not self.unreaped, \"A previous owned child remains unreaped; stop\")\n        number = len(self.receipt[\"commands\"]) + 1\n        stdout_path = self.output / f\"{number:03d}.stdout\"\n        stderr_path = self.output / f\"{number:03d}.stderr\"\n        record = {\"argv\": argv, \"cwd\": str(self.cwd), \"timeoutSeconds\": timeout,\n                  \"stdout\": stdout_path.name, \"stderr\": stderr_path.name,\n                  \"status\": \"before spawn\", \"cleanup\": []}\n        self.receipt[\"commands\"].append(record)\n        self.save()\n        process = None\n        original = None\n        try:\n            with private_file(stdout_path) as stdout, private_file(stderr_path) as stderr:\n                try:\n                    # Signal handlers only record interruption. They cannot raise\n                    # between spawn and recording the owned PID/session identity.\n                    process = subprocess.Popen(argv, cwd=self.cwd, env=self.environment,\n                                               stdin=subprocess.DEVNULL, stdout=stdout,\n                                               stderr=stderr, start_new_session=True)\n                    record.update(pid=process.pid, processGroup=process.pid, status=\"running\")\n                    self.save()\n                    deadline = time.monotonic() + timeout\n                    while True:\n                        self.interrupted()\n                        observed = os.waitid(os.P_PID, process.pid,\n                                             os.WEXITED | os.WNOHANG | os.WNOWAIT)\n                        if observed is not None:\n                            record[\"observedCompletion\"] = {\"code\": observed.si_code,\n                                                            \"status\": observed.si_status}\n                            break\n                        require(time.monotonic() < deadline, f\"Command timed out: {argv!r}\")\n                        time.sleep(0.1)\n                except BaseException as error:\n                    original = error\n                    record[\"originalFailure\"] = repr(error)\n                finally:\n                    if process is not None:\n                        # Never poll, communicate or reap before the last group\n                        # signal: the live/unreaped leader reserves its identity.\n                        ownership = False\n                        try:\n                            ownership = (os.getpgid(process.pid) == process.pid and\n                                         os.getsid(process.pid) == process.pid)\n                            require(ownership, \"Owned child group/session identity changed\")\n                        except BaseException as error:\n                            record[\"cleanup\"].append({\"failure\": repr(error), \"step\": \"identity\"})\n                        if ownership:\n                            term_grace = 0.1 if \"observedCompletion\" in record else 1.0\n                            for sig, grace in ((signal.SIGTERM, term_grace), (signal.SIGKILL, 0.0)):\n                                try:\n                                    os.killpg(process.pid, sig)\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"sent\": True})\n                                except ProcessLookupError:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"alreadyAbsent\": True})\n                                except BaseException as error:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"failure\": repr(error)})\n                                # Further SIGINT/SIGTERM are recorded, not raised.\n                                deadline = time.monotonic() + grace\n                                while time.monotonic() < deadline:\n                                    time.sleep(min(0.1, max(0, deadline - time.monotonic())))\n                            try:\n                                # The held zombie leader makes killpg(..., 0)\n                                # unsuitable as a descendant completion test.\n                                deadline = time.monotonic() + 5\n                                while True:\n                                    require(time.monotonic() < deadline, \"Owned group completion deadline expired\")\n                                    members = self.observe_group(process.pid, record)\n                                    record[\"groupObservation\"] = members\n                                    if not any(\"Z\" not in member[\"state\"] for member in members):\n                                        record[\"groupHasNoLiveMembers\"] = True\n                                        break\n                                    require(time.monotonic() < deadline, \"Owned group still has live members after KILL\")\n                                    time.sleep(0.1)\n                            except BaseException as error:\n                                record[\"cleanup\"].append({\"step\": \"group completion\", \"failure\": repr(error)})\n                        try:\n                            record[\"exitCode\"] = process.wait(timeout=5)\n                            record[\"leaderReaped\"] = True\n                        except BaseException as error:\n                            self.unreaped.append(process)\n                            record[\"cleanup\"].append({\"step\": \"reap\", \"failure\": repr(error)})\n                            record[\"leaderReaped\"] = False\n        except BaseException as error:\n            if original is None:\n                original = error\n                record[\"originalFailure\"] = repr(error)\n            else:\n                record[\"cleanup\"].append({\"step\": \"log close\", \"failure\": repr(error)})\n        for name, path in ((\"stdoutSha256\", stdout_path), (\"stderrSha256\", stderr_path)):\n            try:\n                record[name] = file_hash(path)\n            except BaseException as error:\n                record[\"cleanup\"].append({\"step\": name, \"failure\": repr(error)})\n        record[\"signals\"] = list(self.signals)\n        cleanup_failed = any(\"failure\" in step for step in record[\"cleanup\"])\n        record[\"status\"] = \"failed\" if (original or cleanup_failed or self.signals or\n                                         record.get(\"exitCode\") not in accepted) else \"completed\"\n        try:\n            self.save()\n        except BaseException as save_error:\n            raise MaterializationError(\n                f\"Command evidence persistence failed: original={original!r}, \"\n                f\"exit={record.get('exitCode')!r}, cleanup={record['cleanup']!r}, \"\n                f\"signals={self.signals!r}, save={save_error!r}\"\n            ) from original\n        if record[\"status\"] != \"completed\":\n            raise MaterializationError(f\"Command failed; original and cleanup causes retained in command {number}\") from original\n        return stdout_path.read_bytes(), record[\"exitCode\"]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--layer\", choices=[\"16S\", \"16R\", \"17A\"], required=True)\n    parser.add_argument(\"--expected-parent\", required=True)\n    parser.add_argument(\"--run-id\", required=True)\n    args = parser.parse_args()\n    # Only argument parsing and private, fresh receipt bootstrap precede try.\n    # Invalid/reused run IDs never overwrite another run's evidence.\n    require(re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]{0,79}\", args.run_id), \"Invalid run-id\")\n    plan_root = Path(__file__).resolve().parent\n    private_directory(plan_root / \"runs\")\n    output = plan_root / \"runs\" / args.run_id\n    private_directory(output, fresh=True)\n    receipt = {\"layer\": args.layer, \"parent\": args.expected_parent, \"runId\": args.run_id,\n               \"status\": \"started\", \"phase\": \"preflight\", \"commands\": []}\n    run = Run(output, receipt)\n    previous_handlers = {}\n    try:\n        for sig in (signal.SIGINT, signal.SIGTERM):\n            previous_handlers[sig] = signal.signal(sig, lambda number, frame: run.signals.append(number))\n        require(os.name == \"posix\" and all(hasattr(os, name) for name in\n                (\"waitid\", \"P_PID\", \"WEXITED\", \"WNOHANG\", \"WNOWAIT\", \"getpgid\", \"getsid\")),\n                \"Host must support non-reaping waitid and POSIX process groups\")\n        require(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\n                \"An external SIGCHLD reaper would invalidate owned child identities\")\n        require(re.fullmatch(r\"[0-9a-f]{40}\", args.expected_parent), \"Expected parent must be a full commit ID\")\n        plan_path = plan_root / \"plan.json\"\n        plan_bytes = plan_path.read_bytes()\n        plan = json.loads(plan_bytes)\n        receipt[\"planSha256\"] = sha(plan_bytes)\n        expect_hash(Path(__file__).resolve(), plan[\"scriptSha256\"])\n        receipt[\"scriptSha256\"] = plan[\"scriptSha256\"]\n        layer_index = next(index for index, item in enumerate(plan[\"layers\"]) if item[\"layer\"] == args.layer)\n        layer = plan[\"layers\"][layer_index]\n        worktree = Path(plan[\"worktree\"])\n        packet = Path(layer[\"packet\"])\n        require(worktree.is_absolute() and worktree.resolve() == worktree, \"Worktree path must be absolute without symlinks\")\n        run.cwd = worktree\n        run.environment.update(CI=\"true\", GH_PROMPT_DISABLED=\"1\", GIT_TERMINAL_PROMPT=\"0\")\n        run.environment[\"PATH\"] = plan[\"toolPathPrefix\"] + os.pathsep + os.environ.get(\"PATH\", \"\")\n        # Resolve and execute the pinned binaries before any branch/source edit.\n        receipt[\"runtimes\"] = {}\n        for name, expected in plan[\"runtimes\"].items():\n            located = shutil.which(name, path=run.environment[\"PATH\"])\n            require(located is not None, f\"Missing runtime: {name}\")\n            resolved = Path(located).resolve(strict=True)\n            require(resolved == Path(expected[\"path\"]).resolve(strict=True), f\"Unexpected {name} executable: {resolved}\")\n            result, _ = run.command([str(resolved), \"--version\"], timeout=15)\n            observed = result.decode().strip()\n            require(observed == expected[\"version\"], f\"Runtime {name}: expected {expected['version']}, observed {observed}\")\n            receipt[\"runtimes\"][name] = {\"path\": str(resolved), \"version\": observed, \"sha256\": file_hash(resolved)}\n        git_path = shutil.which(\"git\", path=run.environment[\"PATH\"])\n        gh_path = shutil.which(\"gh\", path=run.environment[\"PATH\"])\n        require(git_path and gh_path, \"Local git and gh executables are required\")\n\n        def git(*argv):\n            data, _ = run.command([git_path, *argv])\n            return data.decode().strip()\n\n        def ref_snapshot():\n            raw = git(\"for-each-ref\", \"--format=%(refname)%00%(objectname)\")\n            return dict(line.split(\"\\0\", 1) for line in raw.splitlines())\n\n        def verify_stack(expected_branches, current_branch):\n            require(git(\"branch\", \"--show-current\") == current_branch, \"Unexpected current branch\")\n            require(git(\"rev-parse\", \"HEAD\") == args.expected_parent, \"HEAD moved from expected parent\")\n            git_dir = Path(git(\"rev-parse\", \"--absolute-git-dir\")).resolve()\n            metadata_path = Path(git(\"rev-parse\", \"--git-path\", \"gh-stack\"))\n            if not metadata_path.is_absolute():\n                metadata_path = worktree / metadata_path\n            require(not metadata_path.is_symlink() and metadata_path.resolve() == git_dir / \"gh-stack\",\n                    \"Stack metadata must be the actual worktree-local git-path gh-stack file\")\n            require(metadata_path.is_file(), \"Missing local gh-stack metadata\")\n            metadata_bytes = metadata_path.read_bytes()\n            metadata = json.loads(metadata_bytes)\n            require(metadata.get(\"schemaVersion\") == 1 and metadata.get(\"repository\") == plan[\"localStack\"][\"repository\"],\n                    \"Unexpected gh-stack schema/repository identity\")\n            require(len(metadata.get(\"stacks\", [])) == 1, \"Expected exactly one local stack\")\n            stack = metadata[\"stacks\"][0]\n            trunk = plan[\"localStack\"][\"trunk\"]\n            require(stack[\"trunk\"][\"branch\"] == trunk[\"branch\"], \"Unexpected trunk branch\")\n            parent = git(\"rev-parse\", \"refs/heads/\" + trunk[\"branch\"])\n            require(parent == trunk[\"head\"], \"Local trunk changed\")\n            branches = stack[\"branches\"]\n            require([item[\"branch\"] for item in branches] == expected_branches,\n                    \"Local stack has unexpected, missing, duplicate or reordered branches\")\n            for item in branches:\n                actual_head = git(\"rev-parse\", \"refs/heads/\" + item[\"branch\"])\n                require(item[\"base\"] == parent,\n                        f\"Stack base needs repair for {item['branch']}: expected {parent}, observed {item['base']}\")\n                git(\"merge-base\", \"--is-ancestor\", parent, actual_head)\n                parent = actual_head\n            require(expected_branches[-1] == current_branch, \"Current branch must be local stack tip\")\n            receipt.setdefault(\"localStackSnapshots\", []).append({\"path\": str(metadata_path),\n                \"sha256\": sha(metadata_bytes), \"branches\": expected_branches, \"currentBranch\": current_branch})\n            run.save()\n\n        require(git(\"rev-parse\", \"--show-toplevel\") == str(worktree), \"Unexpected Git worktree root\")\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Worktree must be clean\")\n        if args.layer == \"16S\":\n            require(args.expected_parent == plan[\"initialParent\"], \"Initial parent mismatch\")\n            require(git(\"rev-parse\", \"HEAD^{tree}\") == plan[\"initialTree\"], \"Initial tree mismatch\")\n        for branch, head in plan[\"preservedInitialRefs\"].items():\n            require(git(\"rev-parse\", \"refs/heads/\" + branch) == head, f\"Preserved ref changed: {branch}\")\n        refs_before = ref_snapshot()\n        target_ref = \"refs/heads/\" + layer[\"branch\"]\n        require(target_ref not in refs_before, \"Target branch must be absent\")\n        expected_branches = plan[\"localStack\"][\"initialBranches\"] + [item[\"branch\"] for item in plan[\"layers\"][:layer_index]]\n        require(expected_branches[-1] == layer[\"baseBranch\"], \"Layer base does not match stack order\")\n        verify_stack(expected_branches, layer[\"baseBranch\"])\n        manifest_path = packet / \"candidate-manifest.json\"\n        expect_hash(manifest_path, layer[\"manifestSha256\"])\n        expect_hash(packet / \"candidate.patch\", layer[\"patchSha256\"])\n        files = json.loads(manifest_path.read_bytes())[\"files\"]\n        owning_paths = {item[\"path\"] for item in files}\n        require(len(files) == len(owning_paths) == layer[\"pathCount\"] < 100, \"Unexpected owning path count\")\n        require(layer[\"stageArgv\"] == [\"git\", \"add\", \"--all\", \"--\", *sorted(owning_paths)],\n                \"Separately recorded staging scope must match manifest\")\n        for item in files:\n            expect_hash(contained_file(worktree, item[\"path\"]), item[\"beforeSha256\"])\n            expect_hash(contained_file(packet / \"repository\", item[\"path\"]), item[\"afterSha256\"])\n        receipt.update(branch=layer[\"branch\"], inputManifestSha256=layer[\"manifestSha256\"],\n                       refsBefore=refs_before, phase=\"local branch creation\")\n        run.save()\n        run.command([gh_path, \"stack\", \"add\", layer[\"branch\"]])\n        expected_refs = {**refs_before, target_ref: args.expected_parent}\n        require(ref_snapshot() == expected_refs, \"Unexpected ref changes from local branch creation\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Local add changed source/index\")\n        receipt[\"phase\"] = \"owning source copy\"\n        run.save()\n        for item in files:\n            run.interrupted()\n            destination = contained_file(worktree, item[\"path\"])\n            expect_hash(destination, item[\"beforeSha256\"])\n            if item[\"afterSha256\"] is None:\n                destination.unlink()\n            else:\n                source = contained_file(packet / \"repository\", item[\"path\"])\n                expect_hash(source, item[\"afterSha256\"])\n                destination.parent.mkdir(parents=True, exist_ok=True)\n                shutil.copyfile(source, destination)\n                mode = item.get(\"afterMode\") or format(source.stat().st_mode & 0o777, \"04o\")\n                destination.chmod(int(mode, 8))\n            expect_hash(destination, item[\"afterSha256\"])\n        receipt[\"phase\"] = \"canonical prechecks\"\n        receipt[\"canonicalPrechecks\"] = []\n        run.save()\n        bun = receipt[\"runtimes\"][\"bun\"][\"path\"]\n        for name in (\"lint\", \"format:write\", \"release:validate\"):\n            for runtime in receipt[\"runtimes\"].values():\n                expect_hash(Path(runtime[\"path\"]), runtime[\"sha256\"])\n            run.command([bun, \"run\", name], timeout=plan[\"canonicalTimeoutSeconds\"])\n            receipt[\"canonicalPrechecks\"].append({\"name\": name, \"command\": len(receipt[\"commands\"]), \"exitCode\": 0})\n            run.save()\n        changed_bytes, _ = run.command([git_path, \"diff\", \"--name-only\", \"-z\", args.expected_parent])\n        untracked_bytes, _ = run.command([git_path, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\"])\n        changed = {name.decode() for name in (changed_bytes + untracked_bytes).split(b\"\\0\") if name}\n        receipt[\"changedPaths\"] = sorted(changed)\n        receipt[\"unexpectedChangedPaths\"] = sorted(changed - owning_paths)\n        receipt[\"missingChangedPaths\"] = sorted(owning_paths - changed)\n        receipt[\"outputs\"] = [{\"path\": item[\"path\"], \"proposedSha256\": item[\"afterSha256\"],\n            \"materializedSha256\": file_hash(contained_file(worktree, item[\"path\"]))} for item in files]\n        receipt[\"sourceChangesAfterFormatting\"] = [item[\"path\"] for item in receipt[\"outputs\"]\n            if item[\"proposedSha256\"] != item[\"materializedSha256\"]]\n        run.save()\n        require(changed == owning_paths, \"Unexpected scope after canonical prechecks\")\n        require(ref_snapshot() == expected_refs, \"Refs changed during canonical prechecks\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        git(\"diff\", \"--cached\", \"--exit-code\")\n        git(\"diff\", \"--check\")\n        run.interrupted()\n        receipt.update(status=\"prechecks passed; stopped before staging, commit, inventory or actual-head gates\",\n                       phase=\"review final delta\", nextLayerBoundary=\"Rebind the next packet if proposed bytes changed.\")\n        run.save()\n    except BaseException as error:\n        receipt.update(status=\"stopped; preserve source and evidence for bounded correction\", failure=repr(error),\n                       signals=list(run.signals))\n        try:\n            run.save()\n        except BaseException as save_error:\n            raise MaterializationError(f\"Original failure: {error!r}; receipt failure: {save_error!r}\") from error\n        raise\n    finally:\n        for sig, handler in previous_handlers.items():\n            signal.signal(sig, handler)\n\n\nif __name__ == \"__main__\":\n    main()\n","stderr":"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Apply one granted local source layer, then stop before staging or committing.\n\nSource preparation only until the coordinator grants an invocation. No GitHub\nread, push, inventory update, database operation or runtime gate is implemented.\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport signal\nimport stat\nimport subprocess\nimport time\n\n\nclass MaterializationError(RuntimeError):\n    pass\n\n\ndef require(condition, message):\n    if not condition:\n        raise MaterializationError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    require(not path.is_symlink(), f\"Symlink is not a source file: {path}\")\n    if not path.exists():\n        return None\n    require(path.is_file(), f\"Expected a regular file: {path}\")\n    return sha(path.read_bytes())\n\n\ndef expect_hash(path, expected):\n    observed = file_hash(path)\n    require(observed == expected, f\"Hash mismatch {path}: expected {expected}, observed {observed}\")\n\n\ndef private_file(path):\n    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    os.fchmod(descriptor, 0o600)\n    return os.fdopen(descriptor, \"wb\")\n\n\ndef private_directory(path, fresh=False):\n    try:\n        path.mkdir(mode=0o700)\n    except FileExistsError:\n        require(not fresh, f\"Run already exists; choose a fresh run-id: {path}\")\n    details = path.lstat()\n    require(stat.S_ISDIR(details.st_mode) and details.st_uid == os.getuid(),\n            f\"Expected an owned directory, without symlinks: {path}\")\n    path.chmod(0o700)\n\n\ndef contained_file(root, name):\n    relative = Path(name)\n    require(not relative.is_absolute() and relative.parts and\n            all(part not in (\".\", \"..\", \".git\") for part in relative.parts),\n            f\"Invalid owning path: {name!r}\")\n    destination = root / relative\n    current = root\n    for part in relative.parts:\n        current = current / part\n        require(not current.is_symlink(), f\"Symlink in owning path: {current}\")\n    require(destination.resolve().is_relative_to(root.resolve()), f\"Path escapes root: {name}\")\n    return destination\n\n\nclass Run:\n    def __init__(self, output, receipt):\n        self.output = output\n        self.receipt = receipt\n        self.signals = []\n        self.unreaped = []\n        self.environment = dict(os.environ)\n        self.cwd = output\n        self.save()\n\n    def save(self):\n        temporary = self.output / \"receipt.next.json\"\n        with private_file(temporary) as handle:\n            handle.write((json.dumps(self.receipt, indent=2) + \"\\n\").encode())\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, self.output / \"receipt.json\")\n\n    def interrupted(self):\n        require(not self.signals, f\"Interrupted by signals {self.signals}\")\n\n    def observe_group(self, group, record):\n        # Fixed read-only ps has no children. Its distinct PID is retained and\n        # reaped independently; it is never confused with the command group.\n        observer = subprocess.Popen([\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"],\n                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                                    stderr=subprocess.PIPE, start_new_session=True,\n                                    env={\"LC_ALL\": \"C\", \"PATH\": \"/usr/bin:/bin\"})\n        observation = {\"pid\": observer.pid, \"argv\": [\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"]}\n        record.setdefault(\"groupObservers\", []).append(observation)\n        try:\n            stdout, stderr = observer.communicate(timeout=2)\n        except BaseException as original:\n            failures = []\n            try:\n                observer.kill()\n            except BaseException as error:\n                failures.append(repr(error))\n            try:\n                observer.wait(timeout=2)\n            except BaseException as error:\n                self.unreaped.append(observer)\n                failures.append(repr(error))\n            observation.update(failure=repr(original), cleanupFailures=failures)\n            raise MaterializationError(f\"Group observer failed: {original!r}; cleanup={failures!r}\") from original\n        finally:\n            for handle in (observer.stdout, observer.stderr):\n                if handle is not None:\n                    handle.close()\n        observation.update(exitCode=observer.returncode, stderr=stderr.decode(errors=\"replace\"))\n        require(observer.returncode == 0, f\"Group observer failed: {observation!r}\")\n        members = []\n        for line in stdout.decode().splitlines():\n            pid, pgid, state = line.split()\n            if int(pgid) == group:\n                members.append({\"pid\": int(pid), \"state\": state})\n        return members\n\n    def command(self, argv, timeout=60, accepted=(0,)):\n        self.interrupted()\n        require(not self.unreaped, \"A previous owned child remains unreaped; stop\")\n        number = len(self.receipt[\"commands\"]) + 1\n        stdout_path = self.output / f\"{number:03d}.stdout\"\n        stderr_path = self.output / f\"{number:03d}.stderr\"\n        record = {\"argv\": argv, \"cwd\": str(self.cwd), \"timeoutSeconds\": timeout,\n                  \"stdout\": stdout_path.name, \"stderr\": stderr_path.name,\n                  \"status\": \"before spawn\", \"cleanup\": []}\n        self.receipt[\"commands\"].append(record)\n        self.save()\n        process = None\n        original = None\n        try:\n            with private_file(stdout_path) as stdout, private_file(stderr_path) as stderr:\n                try:\n                    # Signal handlers only record interruption. They cannot raise\n                    # between spawn and recording the owned PID/session identity.\n                    process = subprocess.Popen(argv, cwd=self.cwd, env=self.environment,\n                                               stdin=subprocess.DEVNULL, stdout=stdout,\n                                               stderr=stderr, start_new_session=True)\n                    record.update(pid=process.pid, processGroup=process.pid, status=\"running\")\n                    self.save()\n                    deadline = time.monotonic() + timeout\n                    while True:\n                        self.interrupted()\n                        observed = os.waitid(os.P_PID, process.pid,\n                                             os.WEXITED | os.WNOHANG | os.WNOWAIT)\n                        if observed is not None:\n                            record[\"observedCompletion\"] = {\"code\": observed.si_code,\n                                                            \"status\": observed.si_status}\n                            break\n                        require(time.monotonic() < deadline, f\"Command timed out: {argv!r}\")\n                        time.sleep(0.1)\n                except BaseException as error:\n                    original = error\n                    record[\"originalFailure\"] = repr(error)\n                finally:\n                    if process is not None:\n                        # Never poll, communicate or reap before the last group\n                        # signal: the live/unreaped leader reserves its identity.\n                        ownership = False\n                        try:\n                            ownership = (os.getpgid(process.pid) == process.pid and\n                                         os.getsid(process.pid) == process.pid)\n                            require(ownership, \"Owned child group/session identity changed\")\n                        except BaseException as error:\n                            record[\"cleanup\"].append({\"failure\": repr(error), \"step\": \"identity\"})\n                        if ownership:\n                            term_grace = 0.1 if \"observedCompletion\" in record else 1.0\n                            for sig, grace in ((signal.SIGTERM, term_grace), (signal.SIGKILL, 0.0)):\n                                try:\n                                    os.killpg(process.pid, sig)\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"sent\": True})\n                                except ProcessLookupError:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"alreadyAbsent\": True})\n                                except BaseException as error:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"failure\": repr(error)})\n                                # Further SIGINT/SIGTERM are recorded, not raised.\n                                deadline = time.monotonic() + grace\n                                while time.monotonic() < deadline:\n                                    time.sleep(min(0.1, max(0, deadline - time.monotonic())))\n                            try:\n                                # The held zombie leader makes killpg(..., 0)\n                                # unsuitable as a descendant completion test.\n                                deadline = time.monotonic() + 5\n                                while True:\n                                    require(time.monotonic() < deadline, \"Owned group completion deadline expired\")\n                                    members = self.observe_group(process.pid, record)\n                                    record[\"groupObservation\"] = members\n                                    if not any(\"Z\" not in member[\"state\"] for member in members):\n                                        record[\"groupHasNoLiveMembers\"] = True\n                                        break\n                                    require(time.monotonic() < deadline, \"Owned group still has live members after KILL\")\n                                    time.sleep(0.1)\n                            except BaseException as error:\n                                record[\"cleanup\"].append({\"step\": \"group completion\", \"failure\": repr(error)})\n                        try:\n                            record[\"exitCode\"] = process.wait(timeout=5)\n                            record[\"leaderReaped\"] = True\n                        except BaseException as error:\n                            self.unreaped.append(process)\n                            record[\"cleanup\"].append({\"step\": \"reap\", \"failure\": repr(error)})\n                            record[\"leaderReaped\"] = False\n        except BaseException as error:\n            if original is None:\n                original = error\n                record[\"originalFailure\"] = repr(error)\n            else:\n                record[\"cleanup\"].append({\"step\": \"log close\", \"failure\": repr(error)})\n        for name, path in ((\"stdoutSha256\", stdout_path), (\"stderrSha256\", stderr_path)):\n            try:\n                record[name] = file_hash(path)\n            except BaseException as error:\n                record[\"cleanup\"].append({\"step\": name, \"failure\": repr(error)})\n        record[\"signals\"] = list(self.signals)\n        cleanup_failed = any(\"failure\" in step for step in record[\"cleanup\"])\n        record[\"status\"] = \"failed\" if (original or cleanup_failed or self.signals or\n                                         record.get(\"exitCode\") not in accepted) else \"completed\"\n        try:\n            self.save()\n        except BaseException as save_error:\n            raise MaterializationError(\n                f\"Command evidence persistence failed: original={original!r}, \"\n                f\"exit={record.get('exitCode')!r}, cleanup={record['cleanup']!r}, \"\n                f\"signals={self.signals!r}, save={save_error!r}\"\n            ) from original\n        if record[\"status\"] != \"completed\":\n            raise MaterializationError(f\"Command failed; original and cleanup causes retained in command {number}\") from original\n        return stdout_path.read_bytes(), record[\"exitCode\"]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--layer\", choices=[\"16S\", \"16R\", \"17A\"], required=True)\n    parser.add_argument(\"--expected-parent\", required=True)\n    parser.add_argument(\"--run-id\", required=True)\n    args = parser.parse_args()\n    # Only argument parsing and private, fresh receipt bootstrap precede try.\n    # Invalid/reused run IDs never overwrite another run's evidence.\n    require(re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]{0,79}\", args.run_id), \"Invalid run-id\")\n    plan_root = Path(__file__).resolve().parent\n    private_directory(plan_root / \"runs\")\n    output = plan_root / \"runs\" / args.run_id\n    private_directory(output, fresh=True)\n    receipt = {\"layer\": args.layer, \"parent\": args.expected_parent, \"runId\": args.run_id,\n               \"status\": \"started\", \"phase\": \"preflight\", \"commands\": []}\n    run = Run(output, receipt)\n    previous_handlers = {}\n    try:\n        for sig in (signal.SIGINT, signal.SIGTERM):\n            previous_handlers[sig] = signal.signal(sig, lambda number, frame: run.signals.append(number))\n        require(os.name == \"posix\" and all(hasattr(os, name) for name in\n                (\"waitid\", \"P_PID\", \"WEXITED\", \"WNOHANG\", \"WNOWAIT\", \"getpgid\", \"getsid\")),\n                \"Host must support non-reaping waitid and POSIX process groups\")\n        require(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\n                \"An external SIGCHLD reaper would invalidate owned child identities\")\n        require(re.fullmatch(r\"[0-9a-f]{40}\", args.expected_parent), \"Expected parent must be a full commit ID\")\n        plan_path = plan_root / \"plan.json\"\n        plan_bytes = plan_path.read_bytes()\n        plan = json.loads(plan_bytes)\n        receipt[\"planSha256\"] = sha(plan_bytes)\n        expect_hash(Path(__file__).resolve(), plan[\"scriptSha256\"])\n        receipt[\"scriptSha256\"] = plan[\"scriptSha256\"]\n        layer_index = next(index for index, item in enumerate(plan[\"layers\"]) if item[\"layer\"] == args.layer)\n        layer = plan[\"layers\"][layer_index]\n        worktree = Path(plan[\"worktree\"])\n        packet = Path(layer[\"packet\"])\n        require(worktree.is_absolute() and worktree.resolve() == worktree, \"Worktree path must be absolute without symlinks\")\n        run.cwd = worktree\n        run.environment.update(CI=\"true\", GH_PROMPT_DISABLED=\"1\", GIT_TERMINAL_PROMPT=\"0\")\n        run.environment[\"PATH\"] = plan[\"toolPathPrefix\"] + os.pathsep + os.environ.get(\"PATH\", \"\")\n        # Resolve and execute the pinned binaries before any branch/source edit.\n        receipt[\"runtimes\"] = {}\n        for name, expected in plan[\"runtimes\"].items():\n            located = shutil.which(name, path=run.environment[\"PATH\"])\n            require(located is not None, f\"Missing runtime: {name}\")\n            resolved = Path(located).resolve(strict=True)\n            require(resolved == Path(expected[\"path\"]).resolve(strict=True), f\"Unexpected {name} executable: {resolved}\")\n            result, _ = run.command([str(resolved), \"--version\"], timeout=15)\n            observed = result.decode().strip()\n            require(observed == expected[\"version\"], f\"Runtime {name}: expected {expected['version']}, observed {observed}\")\n            receipt[\"runtimes\"][name] = {\"path\": str(resolved), \"version\": observed, \"sha256\": file_hash(resolved)}\n        git_path = shutil.which(\"git\", path=run.environment[\"PATH\"])\n        gh_path = shutil.which(\"gh\", path=run.environment[\"PATH\"])\n        require(git_path and gh_path, \"Local git and gh executables are required\")\n\n        def git(*argv):\n            data, _ = run.command([git_path, *argv])\n            return data.decode().strip()\n\n        def ref_snapshot():\n            raw = git(\"for-each-ref\", \"--format=%(refname)%00%(objectname)\")\n            return dict(line.split(\"\\0\", 1) for line in raw.splitlines())\n\n        def verify_stack(expected_branches, current_branch):\n            require(git(\"branch\", \"--show-current\") == current_branch, \"Unexpected current branch\")\n            require(git(\"rev-parse\", \"HEAD\") == args.expected_parent, \"HEAD moved from expected parent\")\n            git_dir = Path(git(\"rev-parse\", \"--absolute-git-dir\")).resolve()\n            metadata_path = Path(git(\"rev-parse\", \"--git-path\", \"gh-stack\"))\n            if not metadata_path.is_absolute():\n                metadata_path = worktree / metadata_path\n            require(not metadata_path.is_symlink() and metadata_path.resolve() == git_dir / \"gh-stack\",\n                    \"Stack metadata must be the actual worktree-local git-path gh-stack file\")\n            require(metadata_path.is_file(), \"Missing local gh-stack metadata\")\n            metadata_bytes = metadata_path.read_bytes()\n            metadata = json.loads(metadata_bytes)\n            require(metadata.get(\"schemaVersion\") == 1 and metadata.get(\"repository\") == plan[\"localStack\"][\"repository\"],\n                    \"Unexpected gh-stack schema/repository identity\")\n            require(len(metadata.get(\"stacks\", [])) == 1, \"Expected exactly one local stack\")\n            stack = metadata[\"stacks\"][0]\n            trunk = plan[\"localStack\"][\"trunk\"]\n            require(stack[\"trunk\"][\"branch\"] == trunk[\"branch\"], \"Unexpected trunk branch\")\n            parent = git(\"rev-parse\", \"refs/heads/\" + trunk[\"branch\"])\n            require(parent == trunk[\"head\"], \"Local trunk changed\")\n            branches = stack[\"branches\"]\n            require([item[\"branch\"] for item in branches] == expected_branches,\n                    \"Local stack has unexpected, missing, duplicate or reordered branches\")\n            for item in branches:\n                actual_head = git(\"rev-parse\", \"refs/heads/\" + item[\"branch\"])\n                require(item[\"base\"] == parent,\n                        f\"Stack base needs repair for {item['branch']}: expected {parent}, observed {item['base']}\")\n                git(\"merge-base\", \"--is-ancestor\", parent, actual_head)\n                parent = actual_head\n            require(expected_branches[-1] == current_branch, \"Current branch must be local stack tip\")\n            receipt.setdefault(\"localStackSnapshots\", []).append({\"path\": str(metadata_path),\n                \"sha256\": sha(metadata_bytes), \"branches\": expected_branches, \"currentBranch\": current_branch})\n            run.save()\n\n        require(git(\"rev-parse\", \"--show-toplevel\") == str(worktree), \"Unexpected Git worktree root\")\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Worktree must be clean\")\n        if args.layer == \"16S\":\n            require(args.expected_parent == plan[\"initialParent\"], \"Initial parent mismatch\")\n            require(git(\"rev-parse\", \"HEAD^{tree}\") == plan[\"initialTree\"], \"Initial tree mismatch\")\n        for branch, head in plan[\"preservedInitialRefs\"].items():\n            require(git(\"rev-parse\", \"refs/heads/\" + branch) == head, f\"Preserved ref changed: {branch}\")\n        refs_before = ref_snapshot()\n        target_ref = \"refs/heads/\" + layer[\"branch\"]\n        require(target_ref not in refs_before, \"Target branch must be absent\")\n        expected_branches = plan[\"localStack\"][\"initialBranches\"] + [item[\"branch\"] for item in plan[\"layers\"][:layer_index]]\n        require(expected_branches[-1] == layer[\"baseBranch\"], \"Layer base does not match stack order\")\n        verify_stack(expected_branches, layer[\"baseBranch\"])\n        manifest_path = packet / \"candidate-manifest.json\"\n        expect_hash(manifest_path, layer[\"manifestSha256\"])\n        expect_hash(packet / \"candidate.patch\", layer[\"patchSha256\"])\n        files = json.loads(manifest_path.read_bytes())[\"files\"]\n        owning_paths = {item[\"path\"] for item in files}\n        require(len(files) == len(owning_paths) == layer[\"pathCount\"] < 100, \"Unexpected owning path count\")\n        require(layer[\"stageArgv\"] == [\"git\", \"add\", \"--all\", \"--\", *sorted(owning_paths)],\n                \"Separately recorded staging scope must match manifest\")\n        for item in files:\n            expect_hash(contained_file(worktree, item[\"path\"]), item[\"beforeSha256\"])\n            expect_hash(contained_file(packet / \"repository\", item[\"path\"]), item[\"afterSha256\"])\n        receipt.update(branch=layer[\"branch\"], inputManifestSha256=layer[\"manifestSha256\"],\n                       refsBefore=refs_before, phase=\"local branch creation\")\n        run.save()\n        run.command([gh_path, \"stack\", \"add\", layer[\"branch\"]])\n        expected_refs = {**refs_before, target_ref: args.expected_parent}\n        require(ref_snapshot() == expected_refs, \"Unexpected ref changes from local branch creation\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Local add changed source/index\")\n        receipt[\"phase\"] = \"owning source copy\"\n        run.save()\n        for item in files:\n            run.interrupted()\n            destination = contained_file(worktree, item[\"path\"])\n            expect_hash(destination, item[\"beforeSha256\"])\n            if item[\"afterSha256\"] is None:\n                destination.unlink()\n            else:\n                source = contained_file(packet / \"repository\", item[\"path\"])\n                expect_hash(source, item[\"afterSha256\"])\n                destination.parent.mkdir(parents=True, exist_ok=True)\n                shutil.copyfile(source, destination)\n                mode = item.get(\"afterMode\") or format(source.stat().st_mode & 0o777, \"04o\")\n                destination.chmod(int(mode, 8))\n            expect_hash(destination, item[\"afterSha256\"])\n        receipt[\"phase\"] = \"canonical prechecks\"\n        receipt[\"canonicalPrechecks\"] = []\n        run.save()\n        bun = receipt[\"runtimes\"][\"bun\"][\"path\"]\n        for name in (\"lint\", \"format:write\", \"release:validate\"):\n            for runtime in receipt[\"runtimes\"].values():\n                expect_hash(Path(runtime[\"path\"]), runtime[\"sha256\"])\n            run.command([bun, \"run\", name], timeout=plan[\"canonicalTimeoutSeconds\"])\n            receipt[\"canonicalPrechecks\"].append({\"name\": name, \"command\": len(receipt[\"commands\"]), \"exitCode\": 0})\n            run.save()\n        changed_bytes, _ = run.command([git_path, \"diff\", \"--name-only\", \"-z\", args.expected_parent])\n        untracked_bytes, _ = run.command([git_path, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\"])\n        changed = {name.decode() for name in (changed_bytes + untracked_bytes).split(b\"\\0\") if name}\n        receipt[\"changedPaths\"] = sorted(changed)\n        receipt[\"unexpectedChangedPaths\"] = sorted(changed - owning_paths)\n        receipt[\"missingChangedPaths\"] = sorted(owning_paths - changed)\n        receipt[\"outputs\"] = [{\"path\": item[\"path\"], \"proposedSha256\": item[\"afterSha256\"],\n            \"materializedSha256\": file_hash(contained_file(worktree, item[\"path\"]))} for item in files]\n        receipt[\"sourceChangesAfterFormatting\"] = [item[\"path\"] for item in receipt[\"outputs\"]\n            if item[\"proposedSha256\"] != item[\"materializedSha256\"]]\n        run.save()\n        require(changed == owning_paths, \"Unexpected scope after canonical prechecks\")\n        require(ref_snapshot() == expected_refs, \"Refs changed during canonical prechecks\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        git(\"diff\", \"--cached\", \"--exit-code\")\n        git(\"diff\", \"--check\")\n        run.interrupted()\n        receipt.update(status=\"prechecks passed; stopped before staging, commit, inventory or actual-head gates\",\n                       phase=\"review final delta\", nextLayerBoundary=\"Rebind the next packet if proposed bytes changed.\")\n        run.save()\n    except BaseException as error:\n        receipt.update(status=\"stopped; preserve source and evidence for bounded correction\", failure=repr(error),\n                       signals=list(run.signals))\n        try:\n            run.save()\n        except BaseException as save_error:\n            raise MaterializationError(f\"Original failure: {error!r}; receipt failure: {save_error!r}\") from error\n        raise\n    finally:\n        for sig, handler in previous_handlers.items():\n            signal.signal(sig, handler)\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"duration":{"secs":0,"nanos":4375},"formatted_output":"#!/usr/bin/env python3\n\"\"\"Apply one granted local source layer, then stop before staging or committing.\n\nSource preparation only until the coordinator grants an invocation. No GitHub\nread, push, inventory update, database operation or runtime gate is implemented.\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport signal\nimport stat\nimport subprocess\nimport time\n\n\nclass MaterializationError(RuntimeError):\n    pass\n\n\ndef require(condition, message):\n    if not condition:\n        raise MaterializationError(message)\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef file_hash(path):\n    require(not path.is_symlink(), f\"Symlink is not a source file: {path}\")\n    if not path.exists():\n        return None\n    require(path.is_file(), f\"Expected a regular file: {path}\")\n    return sha(path.read_bytes())\n\n\ndef expect_hash(path, expected):\n    observed = file_hash(path)\n    require(observed == expected, f\"Hash mismatch {path}: expected {expected}, observed {observed}\")\n\n\ndef private_file(path):\n    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\n    os.fchmod(descriptor, 0o600)\n    return os.fdopen(descriptor, \"wb\")\n\n\ndef private_directory(path, fresh=False):\n    try:\n        path.mkdir(mode=0o700)\n    except FileExistsError:\n        require(not fresh, f\"Run already exists; choose a fresh run-id: {path}\")\n    details = path.lstat()\n    require(stat.S_ISDIR(details.st_mode) and details.st_uid == os.getuid(),\n            f\"Expected an owned directory, without symlinks: {path}\")\n    path.chmod(0o700)\n\n\ndef contained_file(root, name):\n    relative = Path(name)\n    require(not relative.is_absolute() and relative.parts and\n            all(part not in (\".\", \"..\", \".git\") for part in relative.parts),\n            f\"Invalid owning path: {name!r}\")\n    destination = root / relative\n    current = root\n    for part in relative.parts:\n        current = current / part\n        require(not current.is_symlink(), f\"Symlink in owning path: {current}\")\n    require(destination.resolve().is_relative_to(root.resolve()), f\"Path escapes root: {name}\")\n    return destination\n\n\nclass Run:\n    def __init__(self, output, receipt):\n        self.output = output\n        self.receipt = receipt\n        self.signals = []\n        self.unreaped = []\n        self.environment = dict(os.environ)\n        self.cwd = output\n        self.save()\n\n    def save(self):\n        temporary = self.output / \"receipt.next.json\"\n        with private_file(temporary) as handle:\n            handle.write((json.dumps(self.receipt, indent=2) + \"\\n\").encode())\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temporary, self.output / \"receipt.json\")\n\n    def interrupted(self):\n        require(not self.signals, f\"Interrupted by signals {self.signals}\")\n\n    def observe_group(self, group, record):\n        # Fixed read-only ps has no children. Its distinct PID is retained and\n        # reaped independently; it is never confused with the command group.\n        observer = subprocess.Popen([\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"],\n                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\n                                    stderr=subprocess.PIPE, start_new_session=True,\n                                    env={\"LC_ALL\": \"C\", \"PATH\": \"/usr/bin:/bin\"})\n        observation = {\"pid\": observer.pid, \"argv\": [\"/bin/ps\", \"-axo\", \"pid=,pgid=,stat=\"]}\n        record.setdefault(\"groupObservers\", []).append(observation)\n        try:\n            stdout, stderr = observer.communicate(timeout=2)\n        except BaseException as original:\n            failures = []\n            try:\n                observer.kill()\n            except BaseException as error:\n                failures.append(repr(error))\n            try:\n                observer.wait(timeout=2)\n            except BaseException as error:\n                self.unreaped.append(observer)\n                failures.append(repr(error))\n            observation.update(failure=repr(original), cleanupFailures=failures)\n            raise MaterializationError(f\"Group observer failed: {original!r}; cleanup={failures!r}\") from original\n        finally:\n            for handle in (observer.stdout, observer.stderr):\n                if handle is not None:\n                    handle.close()\n        observation.update(exitCode=observer.returncode, stderr=stderr.decode(errors=\"replace\"))\n        require(observer.returncode == 0, f\"Group observer failed: {observation!r}\")\n        members = []\n        for line in stdout.decode().splitlines():\n            pid, pgid, state = line.split()\n            if int(pgid) == group:\n                members.append({\"pid\": int(pid), \"state\": state})\n        return members\n\n    def command(self, argv, timeout=60, accepted=(0,)):\n        self.interrupted()\n        require(not self.unreaped, \"A previous owned child remains unreaped; stop\")\n        number = len(self.receipt[\"commands\"]) + 1\n        stdout_path = self.output / f\"{number:03d}.stdout\"\n        stderr_path = self.output / f\"{number:03d}.stderr\"\n        record = {\"argv\": argv, \"cwd\": str(self.cwd), \"timeoutSeconds\": timeout,\n                  \"stdout\": stdout_path.name, \"stderr\": stderr_path.name,\n                  \"status\": \"before spawn\", \"cleanup\": []}\n        self.receipt[\"commands\"].append(record)\n        self.save()\n        process = None\n        original = None\n        try:\n            with private_file(stdout_path) as stdout, private_file(stderr_path) as stderr:\n                try:\n                    # Signal handlers only record interruption. They cannot raise\n                    # between spawn and recording the owned PID/session identity.\n                    process = subprocess.Popen(argv, cwd=self.cwd, env=self.environment,\n                                               stdin=subprocess.DEVNULL, stdout=stdout,\n                                               stderr=stderr, start_new_session=True)\n                    record.update(pid=process.pid, processGroup=process.pid, status=\"running\")\n                    self.save()\n                    deadline = time.monotonic() + timeout\n                    while True:\n                        self.interrupted()\n                        observed = os.waitid(os.P_PID, process.pid,\n                                             os.WEXITED | os.WNOHANG | os.WNOWAIT)\n                        if observed is not None:\n                            record[\"observedCompletion\"] = {\"code\": observed.si_code,\n                                                            \"status\": observed.si_status}\n                            break\n                        require(time.monotonic() < deadline, f\"Command timed out: {argv!r}\")\n                        time.sleep(0.1)\n                except BaseException as error:\n                    original = error\n                    record[\"originalFailure\"] = repr(error)\n                finally:\n                    if process is not None:\n                        # Never poll, communicate or reap before the last group\n                        # signal: the live/unreaped leader reserves its identity.\n                        ownership = False\n                        try:\n                            ownership = (os.getpgid(process.pid) == process.pid and\n                                         os.getsid(process.pid) == process.pid)\n                            require(ownership, \"Owned child group/session identity changed\")\n                        except BaseException as error:\n                            record[\"cleanup\"].append({\"failure\": repr(error), \"step\": \"identity\"})\n                        if ownership:\n                            term_grace = 0.1 if \"observedCompletion\" in record else 1.0\n                            for sig, grace in ((signal.SIGTERM, term_grace), (signal.SIGKILL, 0.0)):\n                                try:\n                                    os.killpg(process.pid, sig)\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"sent\": True})\n                                except ProcessLookupError:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"alreadyAbsent\": True})\n                                except BaseException as error:\n                                    record[\"cleanup\"].append({\"signal\": int(sig), \"failure\": repr(error)})\n                                # Further SIGINT/SIGTERM are recorded, not raised.\n                                deadline = time.monotonic() + grace\n                                while time.monotonic() < deadline:\n                                    time.sleep(min(0.1, max(0, deadline - time.monotonic())))\n                            try:\n                                # The held zombie leader makes killpg(..., 0)\n                                # unsuitable as a descendant completion test.\n                                deadline = time.monotonic() + 5\n                                while True:\n                                    require(time.monotonic() < deadline, \"Owned group completion deadline expired\")\n                                    members = self.observe_group(process.pid, record)\n                                    record[\"groupObservation\"] = members\n                                    if not any(\"Z\" not in member[\"state\"] for member in members):\n                                        record[\"groupHasNoLiveMembers\"] = True\n                                        break\n                                    require(time.monotonic() < deadline, \"Owned group still has live members after KILL\")\n                                    time.sleep(0.1)\n                            except BaseException as error:\n                                record[\"cleanup\"].append({\"step\": \"group completion\", \"failure\": repr(error)})\n                        try:\n                            record[\"exitCode\"] = process.wait(timeout=5)\n                            record[\"leaderReaped\"] = True\n                        except BaseException as error:\n                            self.unreaped.append(process)\n                            record[\"cleanup\"].append({\"step\": \"reap\", \"failure\": repr(error)})\n                            record[\"leaderReaped\"] = False\n        except BaseException as error:\n            if original is None:\n                original = error\n                record[\"originalFailure\"] = repr(error)\n            else:\n                record[\"cleanup\"].append({\"step\": \"log close\", \"failure\": repr(error)})\n        for name, path in ((\"stdoutSha256\", stdout_path), (\"stderrSha256\", stderr_path)):\n            try:\n                record[name] = file_hash(path)\n            except BaseException as error:\n                record[\"cleanup\"].append({\"step\": name, \"failure\": repr(error)})\n        record[\"signals\"] = list(self.signals)\n        cleanup_failed = any(\"failure\" in step for step in record[\"cleanup\"])\n        record[\"status\"] = \"failed\" if (original or cleanup_failed or self.signals or\n                                         record.get(\"exitCode\") not in accepted) else \"completed\"\n        try:\n            self.save()\n        except BaseException as save_error:\n            raise MaterializationError(\n                f\"Command evidence persistence failed: original={original!r}, \"\n                f\"exit={record.get('exitCode')!r}, cleanup={record['cleanup']!r}, \"\n                f\"signals={self.signals!r}, save={save_error!r}\"\n            ) from original\n        if record[\"status\"] != \"completed\":\n            raise MaterializationError(f\"Command failed; original and cleanup causes retained in command {number}\") from original\n        return stdout_path.read_bytes(), record[\"exitCode\"]\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--layer\", choices=[\"16S\", \"16R\", \"17A\"], required=True)\n    parser.add_argument(\"--expected-parent\", required=True)\n    parser.add_argument(\"--run-id\", required=True)\n    args = parser.parse_args()\n    # Only argument parsing and private, fresh receipt bootstrap precede try.\n    # Invalid/reused run IDs never overwrite another run's evidence.\n    require(re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]{0,79}\", args.run_id), \"Invalid run-id\")\n    plan_root = Path(__file__).resolve().parent\n    private_directory(plan_root / \"runs\")\n    output = plan_root / \"runs\" / args.run_id\n    private_directory(output, fresh=True)\n    receipt = {\"layer\": args.layer, \"parent\": args.expected_parent, \"runId\": args.run_id,\n               \"status\": \"started\", \"phase\": \"preflight\", \"commands\": []}\n    run = Run(output, receipt)\n    previous_handlers = {}\n    try:\n        for sig in (signal.SIGINT, signal.SIGTERM):\n            previous_handlers[sig] = signal.signal(sig, lambda number, frame: run.signals.append(number))\n        require(os.name == \"posix\" and all(hasattr(os, name) for name in\n                (\"waitid\", \"P_PID\", \"WEXITED\", \"WNOHANG\", \"WNOWAIT\", \"getpgid\", \"getsid\")),\n                \"Host must support non-reaping waitid and POSIX process groups\")\n        require(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\n                \"An external SIGCHLD reaper would invalidate owned child identities\")\n        require(re.fullmatch(r\"[0-9a-f]{40}\", args.expected_parent), \"Expected parent must be a full commit ID\")\n        plan_path = plan_root / \"plan.json\"\n        plan_bytes = plan_path.read_bytes()\n        plan = json.loads(plan_bytes)\n        receipt[\"planSha256\"] = sha(plan_bytes)\n        expect_hash(Path(__file__).resolve(), plan[\"scriptSha256\"])\n        receipt[\"scriptSha256\"] = plan[\"scriptSha256\"]\n        layer_index = next(index for index, item in enumerate(plan[\"layers\"]) if item[\"layer\"] == args.layer)\n        layer = plan[\"layers\"][layer_index]\n        worktree = Path(plan[\"worktree\"])\n        packet = Path(layer[\"packet\"])\n        require(worktree.is_absolute() and worktree.resolve() == worktree, \"Worktree path must be absolute without symlinks\")\n        run.cwd = worktree\n        run.environment.update(CI=\"true\", GH_PROMPT_DISABLED=\"1\", GIT_TERMINAL_PROMPT=\"0\")\n        run.environment[\"PATH\"] = plan[\"toolPathPrefix\"] + os.pathsep + os.environ.get(\"PATH\", \"\")\n        # Resolve and execute the pinned binaries before any branch/source edit.\n        receipt[\"runtimes\"] = {}\n        for name, expected in plan[\"runtimes\"].items():\n            located = shutil.which(name, path=run.environment[\"PATH\"])\n            require(located is not None, f\"Missing runtime: {name}\")\n            resolved = Path(located).resolve(strict=True)\n            require(resolved == Path(expected[\"path\"]).resolve(strict=True), f\"Unexpected {name} executable: {resolved}\")\n            result, _ = run.command([str(resolved), \"--version\"], timeout=15)\n            observed = result.decode().strip()\n            require(observed == expected[\"version\"], f\"Runtime {name}: expected {expected['version']}, observed {observed}\")\n            receipt[\"runtimes\"][name] = {\"path\": str(resolved), \"version\": observed, \"sha256\": file_hash(resolved)}\n        git_path = shutil.which(\"git\", path=run.environment[\"PATH\"])\n        gh_path = shutil.which(\"gh\", path=run.environment[\"PATH\"])\n        require(git_path and gh_path, \"Local git and gh executables are required\")\n\n        def git(*argv):\n            data, _ = run.command([git_path, *argv])\n            return data.decode().strip()\n\n        def ref_snapshot():\n            raw = git(\"for-each-ref\", \"--format=%(refname)%00%(objectname)\")\n            return dict(line.split(\"\\0\", 1) for line in raw.splitlines())\n\n        def verify_stack(expected_branches, current_branch):\n            require(git(\"branch\", \"--show-current\") == current_branch, \"Unexpected current branch\")\n            require(git(\"rev-parse\", \"HEAD\") == args.expected_parent, \"HEAD moved from expected parent\")\n            git_dir = Path(git(\"rev-parse\", \"--absolute-git-dir\")).resolve()\n            metadata_path = Path(git(\"rev-parse\", \"--git-path\", \"gh-stack\"))\n            if not metadata_path.is_absolute():\n                metadata_path = worktree / metadata_path\n            require(not metadata_path.is_symlink() and metadata_path.resolve() == git_dir / \"gh-stack\",\n                    \"Stack metadata must be the actual worktree-local git-path gh-stack file\")\n            require(metadata_path.is_file(), \"Missing local gh-stack metadata\")\n            metadata_bytes = metadata_path.read_bytes()\n            metadata = json.loads(metadata_bytes)\n            require(metadata.get(\"schemaVersion\") == 1 and metadata.get(\"repository\") == plan[\"localStack\"][\"repository\"],\n                    \"Unexpected gh-stack schema/repository identity\")\n            require(len(metadata.get(\"stacks\", [])) == 1, \"Expected exactly one local stack\")\n            stack = metadata[\"stacks\"][0]\n            trunk = plan[\"localStack\"][\"trunk\"]\n            require(stack[\"trunk\"][\"branch\"] == trunk[\"branch\"], \"Unexpected trunk branch\")\n            parent = git(\"rev-parse\", \"refs/heads/\" + trunk[\"branch\"])\n            require(parent == trunk[\"head\"], \"Local trunk changed\")\n            branches = stack[\"branches\"]\n            require([item[\"branch\"] for item in branches] == expected_branches,\n                    \"Local stack has unexpected, missing, duplicate or reordered branches\")\n            for item in branches:\n                actual_head = git(\"rev-parse\", \"refs/heads/\" + item[\"branch\"])\n                require(item[\"base\"] == parent,\n                        f\"Stack base needs repair for {item['branch']}: expected {parent}, observed {item['base']}\")\n                git(\"merge-base\", \"--is-ancestor\", parent, actual_head)\n                parent = actual_head\n            require(expected_branches[-1] == current_branch, \"Current branch must be local stack tip\")\n            receipt.setdefault(\"localStackSnapshots\", []).append({\"path\": str(metadata_path),\n                \"sha256\": sha(metadata_bytes), \"branches\": expected_branches, \"currentBranch\": current_branch})\n            run.save()\n\n        require(git(\"rev-parse\", \"--show-toplevel\") == str(worktree), \"Unexpected Git worktree root\")\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Worktree must be clean\")\n        if args.layer == \"16S\":\n            require(args.expected_parent == plan[\"initialParent\"], \"Initial parent mismatch\")\n            require(git(\"rev-parse\", \"HEAD^{tree}\") == plan[\"initialTree\"], \"Initial tree mismatch\")\n        for branch, head in plan[\"preservedInitialRefs\"].items():\n            require(git(\"rev-parse\", \"refs/heads/\" + branch) == head, f\"Preserved ref changed: {branch}\")\n        refs_before = ref_snapshot()\n        target_ref = \"refs/heads/\" + layer[\"branch\"]\n        require(target_ref not in refs_before, \"Target branch must be absent\")\n        expected_branches = plan[\"localStack\"][\"initialBranches\"] + [item[\"branch\"] for item in plan[\"layers\"][:layer_index]]\n        require(expected_branches[-1] == layer[\"baseBranch\"], \"Layer base does not match stack order\")\n        verify_stack(expected_branches, layer[\"baseBranch\"])\n        manifest_path = packet / \"candidate-manifest.json\"\n        expect_hash(manifest_path, layer[\"manifestSha256\"])\n        expect_hash(packet / \"candidate.patch\", layer[\"patchSha256\"])\n        files = json.loads(manifest_path.read_bytes())[\"files\"]\n        owning_paths = {item[\"path\"] for item in files}\n        require(len(files) == len(owning_paths) == layer[\"pathCount\"] < 100, \"Unexpected owning path count\")\n        require(layer[\"stageArgv\"] == [\"git\", \"add\", \"--all\", \"--\", *sorted(owning_paths)],\n                \"Separately recorded staging scope must match manifest\")\n        for item in files:\n            expect_hash(contained_file(worktree, item[\"path\"]), item[\"beforeSha256\"])\n            expect_hash(contained_file(packet / \"repository\", item[\"path\"]), item[\"afterSha256\"])\n        receipt.update(branch=layer[\"branch\"], inputManifestSha256=layer[\"manifestSha256\"],\n                       refsBefore=refs_before, phase=\"local branch creation\")\n        run.save()\n        run.command([gh_path, \"stack\", \"add\", layer[\"branch\"]])\n        expected_refs = {**refs_before, target_ref: args.expected_parent}\n        require(ref_snapshot() == expected_refs, \"Unexpected ref changes from local branch creation\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        require(not git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\"), \"Local add changed source/index\")\n        receipt[\"phase\"] = \"owning source copy\"\n        run.save()\n        for item in files:\n            run.interrupted()\n            destination = contained_file(worktree, item[\"path\"])\n            expect_hash(destination, item[\"beforeSha256\"])\n            if item[\"afterSha256\"] is None:\n                destination.unlink()\n            else:\n                source = contained_file(packet / \"repository\", item[\"path\"])\n                expect_hash(source, item[\"afterSha256\"])\n                destination.parent.mkdir(parents=True, exist_ok=True)\n                shutil.copyfile(source, destination)\n                mode = item.get(\"afterMode\") or format(source.stat().st_mode & 0o777, \"04o\")\n                destination.chmod(int(mode, 8))\n            expect_hash(destination, item[\"afterSha256\"])\n        receipt[\"phase\"] = \"canonical prechecks\"\n        receipt[\"canonicalPrechecks\"] = []\n        run.save()\n        bun = receipt[\"runtimes\"][\"bun\"][\"path\"]\n        for name in (\"lint\", \"format:write\", \"release:validate\"):\n            for runtime in receipt[\"runtimes\"].values():\n                expect_hash(Path(runtime[\"path\"]), runtime[\"sha256\"])\n            run.command([bun, \"run\", name], timeout=plan[\"canonicalTimeoutSeconds\"])\n            receipt[\"canonicalPrechecks\"].append({\"name\": name, \"command\": len(receipt[\"commands\"]), \"exitCode\": 0})\n            run.save()\n        changed_bytes, _ = run.command([git_path, \"diff\", \"--name-only\", \"-z\", args.expected_parent])\n        untracked_bytes, _ = run.command([git_path, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\"])\n        changed = {name.decode() for name in (changed_bytes + untracked_bytes).split(b\"\\0\") if name}\n        receipt[\"changedPaths\"] = sorted(changed)\n        receipt[\"unexpectedChangedPaths\"] = sorted(changed - owning_paths)\n        receipt[\"missingChangedPaths\"] = sorted(owning_paths - changed)\n        receipt[\"outputs\"] = [{\"path\": item[\"path\"], \"proposedSha256\": item[\"afterSha256\"],\n            \"materializedSha256\": file_hash(contained_file(worktree, item[\"path\"]))} for item in files]\n        receipt[\"sourceChangesAfterFormatting\"] = [item[\"path\"] for item in receipt[\"outputs\"]\n            if item[\"proposedSha256\"] != item[\"materializedSha256\"]]\n        run.save()\n        require(changed == owning_paths, \"Unexpected scope after canonical prechecks\")\n        require(ref_snapshot() == expected_refs, \"Refs changed during canonical prechecks\")\n        verify_stack(expected_branches + [layer[\"branch\"]], layer[\"branch\"])\n        git(\"diff\", \"--cached\", \"--exit-code\")\n        git(\"diff\", \"--check\")\n        run.interrupted()\n        receipt.update(status=\"prechecks passed; stopped before staging, commit, inventory or actual-head gates\",\n                       phase=\"review final delta\", nextLayerBoundary=\"Rebind the next packet if proposed bytes changed.\")\n        run.save()\n    except BaseException as error:\n        receipt.update(status=\"stopped; preserve source and evidence for bounded correction\", failure=repr(error),\n                       signals=list(run.signals))\n        try:\n            run.save()\n        except BaseException as save_error:\n            raise MaterializationError(f\"Original failure: {error!r}; receipt failure: {save_error!r}\") from error\n        raise\n    finally:\n        for sig, handler in previous_handlers.items():\n            signal.signal(sig, handler)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"started_at_ms":1788572806312,"completed_at_ms":1788572806312}}
{"timestamp":"2026-09-05T01:46:46.316Z","ordinal":20715,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a06f3f-2cac-71c1-a976-67b48069e0b5","call_id":"call_csEiCmao11zCm2slOLjmKzNq","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"c210ef\",\"wall_time_seconds\":0.000004375,\"exit_code\":0,\"original_token_count\":6002,\"output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Apply one granted local source layer, then stop before staging or committing.\\n\\nSource preparation only until the coordinator grants an invocation. No GitHub\\nread, push, inventory update, database operation or runtime gate is implemented.\\n\\\"\\\"\\\"\\nimport argparse\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport re\\nimport shutil\\nimport signal\\nimport stat\\nimport subprocess\\nimport time\\n\\n\\nclass MaterializationError(RuntimeError):\\n    pass\\n\\n\\ndef require(condition, message):\\n    if not condition:\\n        raise MaterializationError(message)\\n\\n\\ndef sha(data):\\n    return hashlib.sha256(data).hexdigest()\\n\\n\\ndef file_hash(path):\\n    require(not path.is_symlink(), f\\\"Symlink is not a source file: {path}\\\")\\n    if not path.exists():\\n        return None\\n    require(path.is_file(), f\\\"Expected a regular file: {path}\\\")\\n    return sha(path.read_bytes())\\n\\n\\ndef expect_hash(path, expected):\\n    observed = file_hash(path)\\n    require(observed == expected, f\\\"Hash mismatch {path}: expected {expected}, observed {observed}\\\")\\n\\n\\ndef private_file(path):\\n    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)\\n    os.fchmod(descriptor, 0o600)\\n    return os.fdopen(descriptor, \\\"wb\\\")\\n\\n\\ndef private_directory(path, fresh=False):\\n    try:\\n        path.mkdir(mode=0o700)\\n    except FileExistsError:\\n        require(not fresh, f\\\"Run already exists; choose a fresh run-id: {path}\\\")\\n    details = path.lstat()\\n    require(stat.S_ISDIR(details.st_mode) and details.st_uid == os.getuid(),\\n            f\\\"Expected an owned directory, without symlinks: {path}\\\")\\n    path.chmod(0o700)\\n\\n\\ndef contained_file(root, name):\\n    relative = Path(name)\\n    require(not relative.is_absolute() and relative.parts and\\n            all(part not in (\\\".\\\", \\\"..\\\", \\\".git\\\") for part in relative.parts),\\n            f\\\"Invalid owning path: {name!r}\\\")\\n    destination = root / relative\\n    current = root\\n    for part in relative.parts:\\n        current = current / part\\n        require(not current.is_symlink(), f\\\"Symlink in owning path: {current}\\\")\\n    require(destination.resolve().is_relative_to(root.resolve()), f\\\"Path escapes root: {name}\\\")\\n    return destination\\n\\n\\nclass Run:\\n    def __init__(self, output, receipt):\\n        self.output = output\\n        self.receipt = receipt\\n        self.signals = []\\n        self.unreaped = []\\n        self.environment = dict(os.environ)\\n        self.cwd = output\\n        self.save()\\n\\n    def save(self):\\n        temporary = self.output / \\\"receipt.next.json\\\"\\n        with private_file(temporary) as handle:\\n            handle.write((json.dumps(self.receipt, indent=2) + \\\"\\\\n\\\").encode())\\n            handle.flush()\\n            os.fsync(handle.fileno())\\n        os.replace(temporary, self.output / \\\"receipt.json\\\")\\n\\n    def interrupted(self):\\n        require(not self.signals, f\\\"Interrupted by signals {self.signals}\\\")\\n\\n    def observe_group(self, group, record):\\n        # Fixed read-only ps has no children. Its distinct PID is retained and\\n        # reaped independently; it is never confused with the command group.\\n        observer = subprocess.Popen([\\\"/bin/ps\\\", \\\"-axo\\\", \\\"pid=,pgid=,stat=\\\"],\\n                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,\\n                                    stderr=subprocess.PIPE, start_new_session=True,\\n                                    env={\\\"LC_ALL\\\": \\\"C\\\", \\\"PATH\\\": \\\"/usr/bin:/bin\\\"})\\n        observation = {\\\"pid\\\": observer.pid, \\\"argv\\\": [\\\"/bin/ps\\\", \\\"-axo\\\", \\\"pid=,pgid=,stat=\\\"]}\\n        record.setdefault(\\\"groupObservers\\\", []).append(observation)\\n        try:\\n            stdout, stderr = observer.communicate(timeout=2)\\n        except BaseException as original:\\n            failures = []\\n            try:\\n                observer.kill()\\n            except BaseException as error:\\n                failures.append(repr(error))\\n            try:\\n                observer.wait(timeout=2)\\n            except BaseException as error:\\n                self.unreaped.append(observer)\\n                failures.append(repr(error))\\n            observation.update(failure=repr(original), cleanupFailures=failures)\\n            raise MaterializationError(f\\\"Group observer failed: {original!r}; cleanup={failures!r}\\\") from original\\n        finally:\\n            for handle in (observer.stdout, observer.stderr):\\n                if handle is not None:\\n                    handle.close()\\n        observation.update(exitCode=observer.returncode, stderr=stderr.decode(errors=\\\"replace\\\"))\\n        require(observer.returncode == 0, f\\\"Group observer failed: {observation!r}\\\")\\n        members = []\\n        for line in stdout.decode().splitlines():\\n            pid, pgid, state = line.split()\\n            if int(pgid) == group:\\n                members.append({\\\"pid\\\": int(pid), \\\"state\\\": state})\\n        return members\\n\\n    def command(self, argv, timeout=60, accepted=(0,)):\\n        self.interrupted()\\n        require(not self.unreaped, \\\"A previous owned child remains unreaped; stop\\\")\\n        number = len(self.receipt[\\\"commands\\\"]) + 1\\n        stdout_path = self.output / f\\\"{number:03d}.stdout\\\"\\n        stderr_path = self.output / f\\\"{number:03d}.stderr\\\"\\n        record = {\\\"argv\\\": argv, \\\"cwd\\\": str(self.cwd), \\\"timeoutSeconds\\\": timeout,\\n                  \\\"stdout\\\": stdout_path.name, \\\"stderr\\\": stderr_path.name,\\n                  \\\"status\\\": \\\"before spawn\\\", \\\"cleanup\\\": []}\\n        self.receipt[\\\"commands\\\"].append(record)\\n        self.save()\\n        process = None\\n        original = None\\n        try:\\n            with private_file(stdout_path) as stdout, private_file(stderr_path) as stderr:\\n                try:\\n                    # Signal handlers only record interruption. They cannot raise\\n                    # between spawn and recording the owned PID/session identity.\\n                    process = subprocess.Popen(argv, cwd=self.cwd, env=self.environment,\\n                                               stdin=subprocess.DEVNULL, stdout=stdout,\\n                                               stderr=stderr, start_new_session=True)\\n                    record.update(pid=process.pid, processGroup=process.pid, status=\\\"running\\\")\\n                    self.save()\\n                    deadline = time.monotonic() + timeout\\n                    while True:\\n                        self.interrupted()\\n                        observed = os.waitid(os.P_PID, process.pid,\\n                                             os.WEXITED | os.WNOHANG | os.WNOWAIT)\\n                        if observed is not None:\\n                            record[\\\"observedCompletion\\\"] = {\\\"code\\\": observed.si_code,\\n                                                            \\\"status\\\": observed.si_status}\\n                            break\\n                        require(time.monotonic() < deadline, f\\\"Command timed out: {argv!r}\\\")\\n                        time.sleep(0.1)\\n                except BaseException as error:\\n                    original = error\\n                    record[\\\"originalFailure\\\"] = repr(error)\\n                finally:\\n                    if process is not None:\\n                        # Never poll, communicate or reap before the last group\\n                        # signal: the live/unreaped leader reserves its identity.\\n                        ownership = False\\n                        try:\\n                            ownership = (os.getpgid(process.pid) == process.pid and\\n                                         os.getsid(process.pid) == process.pid)\\n                            require(ownership, \\\"Owned child group/session identity changed\\\")\\n                        except BaseException as error:\\n                            record[\\\"cleanup\\\"].append({\\\"failure\\\": repr(error), \\\"step\\\": \\\"identity\\\"})\\n                        if ownership:\\n                            term_grace = 0.1 if \\\"observedCompletion\\\" in record else 1.0\\n                            for sig, grace in ((signal.SIGTERM, term_grace), (signal.SIGKILL, 0.0)):\\n                                try:\\n                                    os.killpg(process.pid, sig)\\n                                    record[\\\"cleanup\\\"].append({\\\"signal\\\": int(sig), \\\"sent\\\": True})\\n                                except ProcessLookupError:\\n                                    record[\\\"cleanup\\\"].append({\\\"signal\\\": int(sig), \\\"alreadyAbsent\\\": True})\\n                                except BaseException as error:\\n                                    record[\\\"cleanup\\\"].append({\\\"signal\\\": int(sig), \\\"failure\\\": repr(error)})\\n                                # Further SIGINT/SIGTERM are recorded, not raised.\\n                                deadline = time.monotonic() + grace\\n                                while time.monotonic() < deadline:\\n                                    time.sleep(min(0.1, max(0, deadline - time.monotonic())))\\n                            try:\\n                                # The held zombie leader makes killpg(..., 0)\\n                                # unsuitable as a descendant completion test.\\n                                deadline = time.monotonic() + 5\\n                                while True:\\n                                    require(time.monotonic() < deadline, \\\"Owned group completion deadline expired\\\")\\n                                    members = self.observe_group(process.pid, record)\\n                                    record[\\\"groupObservation\\\"] = members\\n                                    if not any(\\\"Z\\\" not in member[\\\"state\\\"] for member in members):\\n                                        record[\\\"groupHasNoLiveMembers\\\"] = True\\n                                        break\\n                                    require(time.monotonic() < deadline, \\\"Owned group still has live members after KILL\\\")\\n                                    time.sleep(0.1)\\n                            except BaseException as error:\\n                                record[\\\"cleanup\\\"].append({\\\"step\\\": \\\"group completion\\\", \\\"failure\\\": repr(error)})\\n                        try:\\n                            record[\\\"exitCode\\\"] = process.wait(timeout=5)\\n                            record[\\\"leaderReaped\\\"] = True\\n                        except BaseException as error:\\n                            self.unreaped.append(process)\\n                            record[\\\"cleanup\\\"].append({\\\"step\\\": \\\"reap\\\", \\\"failure\\\": repr(error)})\\n                            record[\\\"leaderReaped\\\"] = False\\n        except BaseException as error:\\n            if original is None:\\n                original = error\\n                record[\\\"originalFailure\\\"] = repr(error)\\n            else:\\n                record[\\\"cleanup\\\"].append({\\\"step\\\": \\\"log close\\\", \\\"failure\\\": repr(error)})\\n        for name, path in ((\\\"stdoutSha256\\\", stdout_path), (\\\"stderrSha256\\\", stderr_path)):\\n            try:\\n                record[name] = file_hash(path)\\n            except BaseException as error:\\n                record[\\\"cleanup\\\"].append({\\\"step\\\": name, \\\"failure\\\": repr(error)})\\n        record[\\\"signals\\\"] = list(self.signals)\\n        cleanup_failed = any(\\\"failure\\\" in step for step in record[\\\"cleanup\\\"])\\n        record[\\\"status\\\"] = \\\"failed\\\" if (original or cleanup_failed or self.signals or\\n                                         record.get(\\\"exitCode\\\") not in accepted) else \\\"completed\\\"\\n        try:\\n            self.save()\\n        except BaseException as save_error:\\n            raise MaterializationError(\\n                f\\\"Command evidence persistence failed: original={original!r}, \\\"\\n                f\\\"exit={record.get('exitCode')!r}, cleanup={record['cleanup']!r}, \\\"\\n                f\\\"signals={self.signals!r}, save={save_error!r}\\\"\\n            ) from original\\n        if record[\\\"status\\\"] != \\\"completed\\\":\\n            raise MaterializationError(f\\\"Command failed; original and cleanup causes retained in command {number}\\\") from original\\n        return stdout_path.read_bytes(), record[\\\"exitCode\\\"]\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\\\"--layer\\\", choices=[\\\"16S\\\", \\\"16R\\\", \\\"17A\\\"], required=True)\\n    parser.add_argument(\\\"--expected-parent\\\", required=True)\\n    parser.add_argument(\\\"--run-id\\\", required=True)\\n    args = parser.parse_args()\\n    # Only argument parsing and private, fresh receipt bootstrap precede try.\\n    # Invalid/reused run IDs never overwrite another run's evidence.\\n    require(re.fullmatch(r\\\"[A-Za-z0-9][A-Za-z0-9._-]{0,79}\\\", args.run_id), \\\"Invalid run-id\\\")\\n    plan_root = Path(__file__).resolve().parent\\n    private_directory(plan_root / \\\"runs\\\")\\n    output = plan_root / \\\"runs\\\" / args.run_id\\n    private_directory(output, fresh=True)\\n    receipt = {\\\"layer\\\": args.layer, \\\"parent\\\": args.expected_parent, \\\"runId\\\": args.run_id,\\n               \\\"status\\\": \\\"started\\\", \\\"phase\\\": \\\"preflight\\\", \\\"commands\\\": []}\\n    run = Run(output, receipt)\\n    previous_handlers = {}\\n    try:\\n        for sig in (signal.SIGINT, signal.SIGTERM):\\n            previous_handlers[sig] = signal.signal(sig, lambda number, frame: run.signals.append(number))\\n        require(os.name == \\\"posix\\\" and all(hasattr(os, name) for name in\\n                (\\\"waitid\\\", \\\"P_PID\\\", \\\"WEXITED\\\", \\\"WNOHANG\\\", \\\"WNOWAIT\\\", \\\"getpgid\\\", \\\"getsid\\\")),\\n                \\\"Host must support non-reaping waitid and POSIX process groups\\\")\\n        require(signal.getsignal(signal.SIGCHLD) == signal.SIG_DFL,\\n                \\\"An external SIGCHLD reaper would invalidate owned child identities\\\")\\n        require(re.fullmatch(r\\\"[0-9a-f]{40}\\\", args.expected_parent), \\\"Expected parent must be a full commit ID\\\")\\n        plan_path = plan_root / \\\"plan.json\\\"\\n        plan_bytes = plan_path.read_bytes()\\n        plan = json.loads(plan_bytes)\\n        receipt[\\\"planSha256\\\"] = sha(plan_bytes)\\n        expect_hash(Path(__file__).resolve(), plan[\\\"scriptSha256\\\"])\\n        receipt[\\\"scriptSha256\\\"] = plan[\\\"scriptSha256\\\"]\\n        layer_index = next(index for index, item in enumerate(plan[\\\"layers\\\"]) if item[\\\"layer\\\"] == args.layer)\\n        layer = plan[\\\"layers\\\"][layer_index]\\n        worktree = Path(plan[\\\"worktree\\\"])\\n        packet = Path(layer[\\\"packet\\\"])\\n        require(worktree.is_absolute() and worktree.resolve() == worktree, \\\"Worktree path must be absolute without symlinks\\\")\\n        run.cwd = worktree\\n        run.environment.update(CI=\\\"true\\\", GH_PROMPT_DISABLED=\\\"1\\\", GIT_TERMINAL_PROMPT=\\\"0\\\")\\n        run.environment[\\\"PATH\\\"] = plan[\\\"toolPathPrefix\\\"] + os.pathsep + os.environ.get(\\\"PATH\\\", \\\"\\\")\\n        # Resolve and execute the pinned binaries before any branch/source edit.\\n        receipt[\\\"runtimes\\\"] = {}\\n        for name, expected in plan[\\\"runtimes\\\"].items():\\n            located = shutil.which(name, path=run.environment[\\\"PATH\\\"])\\n            require(located is not None, f\\\"Missing runtime: {name}\\\")\\n            resolved = Path(located).resolve(strict=True)\\n            require(resolved == Path(expected[\\\"path\\\"]).resolve(strict=True), f\\\"Unexpected {name} executable: {resolved}\\\")\\n            result, _ = run.command([str(resolved), \\\"--version\\\"], timeout=15)\\n            observed = result.decode().strip()\\n            require(observed == expected[\\\"version\\\"], f\\\"Runtime {name}: expected {expected['version']}, observed {observed}\\\")\\n            receipt[\\\"runtimes\\\"][name] = {\\\"path\\\": str(resolved), \\\"version\\\": observed, \\\"sha256\\\": file_hash(resolved)}\\n        git_path = shutil.which(\\\"git\\\", path=run.environment[\\\"PATH\\\"])\\n        gh_path = shutil.which(\\\"gh\\\", path=run.environment[\\\"PATH\\\"])\\n        require(git_path and gh_path, \\\"Local git and gh executables are required\\\")\\n\\n        def git(*argv):\\n            data, _ = run.command([git_path, *argv])\\n            return data.decode().strip()\\n\\n        def ref_snapshot():\\n            raw = git(\\\"for-each-ref\\\", \\\"--format=%(refname)%00%(objectname)\\\")\\n            return dict(line.split(\\\"\\\\0\\\", 1) for line in raw.splitlines())\\n\\n        def verify_stack(expected_branches, current_branch):\\n            require(git(\\\"branch\\\", \\\"--show-current\\\") == current_branch, \\\"Unexpected current branch\\\")\\n            require(git(\\\"rev-parse\\\", \\\"HEAD\\\") == args.expected_parent, \\\"HEAD moved from expected parent\\\")\\n            git_dir = Path(git(\\\"rev-parse\\\", \\\"--absolute-git-dir\\\")).resolve()\\n            metadata_path = Path(git(\\\"rev-parse\\\", \\\"--git-path\\\", \\\"gh-stack\\\"))\\n            if not metadata_path.is_absolute():\\n                metadata_path = worktree / metadata_path\\n            require(not metadata_path.is_symlink() and metadata_path.resolve() == git_dir / \\\"gh-stack\\\",\\n                    \\\"Stack metadata must be the actual worktree-local git-path gh-stack file\\\")\\n            require(metadata_path.is_file(), \\\"Missing local gh-stack metadata\\\")\\n            metadata_bytes = metadata_path.read_bytes()\\n            metadata = json.loads(metadata_bytes)\\n            require(metadata.get(\\\"schemaVersion\\\") == 1 and metadata.get(\\\"repository\\\") == plan[\\\"localStack\\\"][\\\"repository\\\"],\\n                    \\\"Unexpected gh-stack schema/repository identity\\\")\\n            require(len(metadata.get(\\\"stacks\\\", [])) == 1, \\\"Expected exactly one local stack\\\")\\n            stack = metadata[\\\"stacks\\\"][0]\\n            trunk = plan[\\\"localStack\\\"][\\\"trunk\\\"]\\n            require(stack[\\\"trunk\\\"][\\\"branch\\\"] == trunk[\\\"branch\\\"], \\\"Unexpected trunk branch\\\")\\n            parent = git(\\\"rev-parse\\\", \\\"refs/heads/\\\" + trunk[\\\"branch\\\"])\\n            require(parent == trunk[\\\"head\\\"], \\\"Local trunk changed\\\")\\n            branches = stack[\\\"branches\\\"]\\n            require([item[\\\"branch\\\"] for item in branches] == expected_branches,\\n                    \\\"Local stack has unexpected, missing, duplicate or reordered branches\\\")\\n            for item in branches:\\n                actual_head = git(\\\"rev-parse\\\", \\\"refs/heads/\\\" + item[\\\"branch\\\"])\\n                require(item[\\\"base\\\"] == parent,\\n                        f\\\"Stack base needs repair for {item['branch']}: expected {parent}, observed {item['base']}\\\")\\n                git(\\\"merge-base\\\", \\\"--is-ancestor\\\", parent, actual_head)\\n                parent = actual_head\\n            require(expected_branches[-1] == current_branch, \\\"Current branch must be local stack tip\\\")\\n            receipt.setdefault(\\\"localStackSnapshots\\\", []).append({\\\"path\\\": str(metadata_path),\\n                \\\"sha256\\\": sha(metadata_bytes), \\\"branches\\\": expected_branches, \\\"currentBranch\\\": current_branch})\\n            run.save()\\n\\n        require(git(\\\"rev-parse\\\", \\\"--show-toplevel\\\") == str(worktree), \\\"Unexpected Git worktree root\\\")\\n        require(not git(\\\"status\\\", \\\"--porcelain=v1\\\", \\\"--untracked-files=all\\\"), \\\"Worktree must be clean\\\")\\n        if args.layer == \\\"16S\\\":\\n            require(args.expected_parent == plan[\\\"initialParent\\\"], \\\"Initial parent mismatch\\\")\\n            require(git(\\\"rev-parse\\\", \\\"HEAD^{tree}\\\") == plan[\\\"initialTree\\\"], \\\"Initial tree mismatch\\\")\\n        for branch, head in plan[\\\"preservedInitialRefs\\\"].items():\\n            require(git(\\\"rev-parse\\\", \\\"refs/heads/\\\" + branch) == head, f\\\"Preserved ref changed: {branch}\\\")\\n        refs_before = ref_snapshot()\\n        target_ref = \\\"refs/heads/\\\" + layer[\\\"branch\\\"]\\n        require(target_ref not in refs_before, \\\"Target branch must be absent\\\")\\n        expected_branches = plan[\\\"localStack\\\"][\\\"initialBranches\\\"] + [item[\\\"branch\\\"] for item in plan[\\\"layers\\\"][:layer_index]]\\n        require(expected_branches[-1] == layer[\\\"baseBranch\\\"], \\\"Layer base does not match stack order\\\")\\n        verify_stack(expected_branches, layer[\\\"baseBranch\\\"])\\n        manifest_path = packet / \\\"candidate-manifest.json\\\"\\n        expect_hash(manifest_path, layer[\\\"manifestSha256\\\"])\\n        expect_hash(packet / \\\"candidate.patch\\\", layer[\\\"patchSha256\\\"])\\n        files = json.loads(manifest_path.read_bytes())[\\\"files\\\"]\\n        owning_paths = {item[\\\"path\\\"] for item in files}\\n        require(len(files) == len(owning_paths) == layer[\\\"pathCount\\\"] < 100, \\\"Unexpected owning path count\\\")\\n        require(layer[\\\"stageArgv\\\"] == [\\\"git\\\", \\\"add\\\", \\\"--all\\\", \\\"--\\\", *sorted(owning_paths)],\\n                \\\"Separately recorded staging scope must match manifest\\\")\\n        for item in files:\\n            expect_hash(contained_file(worktree, item[\\\"path\\\"]), item[\\\"beforeSha256\\\"])\\n            expect_hash(contained_file(packet / \\\"repository\\\", item[\\\"path\\\"]), item[\\\"afterSha256\\\"])\\n        receipt.update(branch=layer[\\\"branch\\\"], inputManifestSha256=layer[\\\"manifestSha256\\\"],\\n                       refsBefore=refs_before, phase=\\\"local branch creation\\\")\\n        run.save()\\n        run.command([gh_path, \\\"stack\\\", \\\"add\\\", layer[\\\"branch\\\"]])\\n        expected_refs = {**refs_before, target_ref: args.expected_parent}\\n        require(ref_snapshot() == expected_refs, \\\"Unexpected ref changes from local branch creation\\\")\\n        verify_stack(expected_branches + [layer[\\\"branch\\\"]], layer[\\\"branch\\\"])\\n        require(not git(\\\"status\\\", \\\"--porcelain=v1\\\", \\\"--untracked-files=all\\\"), \\\"Local add changed source/index\\\")\\n        receipt[\\\"phase\\\"] = \\\"owning source copy\\\"\\n        run.save()\\n        for item in files:\\n            run.interrupted()\\n            destination = contained_file(worktree, item[\\\"path\\\"])\\n            expect_hash(destination, item[\\\"beforeSha256\\\"])\\n            if item[\\\"afterSha256\\\"] is None:\\n                destination.unlink()\\n            else:\\n                source = contained_file(packet / \\\"repository\\\", item[\\\"path\\\"])\\n                expect_hash(source, item[\\\"afterSha256\\\"])\\n                destination.parent.mkdir(parents=True, exist_ok=True)\\n                shutil.copyfile(source, destination)\\n                mode = item.get(\\\"afterMode\\\") or format(source.stat().st_mode & 0o777, \\\"04o\\\")\\n                destination.chmod(int(mode, 8))\\n            expect_hash(destination, item[\\\"afterSha256\\\"])\\n        receipt[\\\"phase\\\"] = \\\"canonical prechecks\\\"\\n        receipt[\\\"canonicalPrechecks\\\"] = []\\n        run.save()\\n        bun = receipt[\\\"runtimes\\\"][\\\"bun\\\"][\\\"path\\\"]\\n        for name in (\\\"lint\\\", \\\"format:write\\\", \\\"release:validate\\\"):\\n            for runtime in receipt[\\\"runtimes\\\"].values():\\n                expect_hash(Path(runtime[\\\"path\\\"]), runtime[\\\"sha256\\\"])\\n            run.command([bun, \\\"run\\\", name], timeout=plan[\\\"canonicalTimeoutSeconds\\\"])\\n            receipt[\\\"canonicalPrechecks\\\"].append({\\\"name\\\": name, \\\"command\\\": len(receipt[\\\"commands\\\"]), \\\"exitCode\\\": 0})\\n            run.save()\\n        changed_bytes, _ = run.command([git_path, \\\"diff\\\", \\\"--name-only\\\", \\\"-z\\\", args.expected_parent])\\n        untracked_bytes, _ = run.command([git_path, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"-z\\\"])\\n        changed = {name.decode() for name in (changed_bytes + untracked_bytes).split(b\\\"\\\\0\\\") if name}\\n        receipt[\\\"changedPaths\\\"] = sorted(changed)\\n        receipt[\\\"unexpectedChangedPaths\\\"] = sorted(changed - owning_paths)\\n        receipt[\\\"missingChangedPaths\\\"] = sorted(owning_paths - changed)\\n        receipt[\\\"outputs\\\"] = [{\\\"path\\\": item[\\\"path\\\"], \\\"proposedSha256\\\": item[\\\"afterSha256\\\"],\\n            \\\"materializedSha256\\\": file_hash(contained_file(worktree, item[\\\"path\\\"]))} for item in files]\\n        receipt[\\\"sourceChangesAfterFormatting\\\"] = [item[\\\"path\\\"] for item in receipt[\\\"outputs\\\"]\\n            if item[\\\"proposedSha256\\\"] != item[\\\"materializedSha256\\\"]]\\n        run.save()\\n        require(changed == owning_paths, \\\"Unexpected scope after canonical prechecks\\\")\\n        require(ref_snapshot() == expected_refs, \\\"Refs changed during canonical prechecks\\\")\\n        verify_stack(expected_branches + [layer[\\\"branch\\\"]], layer[\\\"branch\\\"])\\n        git(\\\"diff\\\", \\\"--cached\\\", \\\"--exit-code\\\")\\n        git(\\\"diff\\\", \\\"--check\\\")\\n        run.interrupted()\\n        receipt.update(status=\\\"prechecks passed; stopped before staging, commit, inventory or actual-head gates\\\",\\n                       phase=\\\"review final delta\\\", nextLayerBoundary=\\\"Rebind the next packet if proposed bytes changed.\\\")\\n        run.save()\\n    except BaseException as error:\\n        receipt.update(status=\\\"stopped; preserve source and evidence for bounded correction\\\", failure=repr(error),\\n                       signals=list(run.signals))\\n        try:\\n            run.save()\\n        except BaseException as save_error:\\n            raise MaterializationError(f\\\"Original failure: {error!r}; receipt failure: {save_error!r}\\\") from error\\n        raise\\n    finally:\\n        for sig, handler in previous_handlers.items():\\n            signal.signal(sig, handler)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"873867\",\"wall_time_seconds\":0.000001084,\"exit_code\":1,\"original_token_count\":94,\"output\":\"{\\\"status\\\": \\\"failed\\\", \\\"head\\\": \\\"d957893ae7c5ab95850520b88334be557fdedce3\\\", \\\"receipt\\\": \\\"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification/runs/03-d957893a-a1/receipt.json\\\"}\\n{\\\"status\\\": \\\"failed\\\", \\\"failureReceipt\\\": \\\"/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review/prefix-runtime-verification/blocked/03-d957893a-a1-1788572749766876000.json\\\"}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788572806.316733}}}

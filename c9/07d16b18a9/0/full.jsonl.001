pt changed\")\n+        ordinary = json.loads(receipt_path.read_text())\n+        require(ordinary[\"head\"] == runnable[\"head\"] and ordinary[\"tree\"] == runnable[\"tree\"], \"Ordinary proof is not bound to the runnable identity\")\n+        approval_path = REVIEW / runnable[\"readinessApproval\"]\n+        require(sha(approval_path) == runnable[\"readinessApprovalSha256\"], \"Readiness approval changed\")\n+        approval = json.loads(approval_path.read_text())\n+        require(approval[\"status\"] == \"approved\" and approval[\"head\"] == runnable[\"head\"] and approval[\"tree\"] == runnable[\"tree\"] and approval[\"ordinaryReceiptSha256\"] == runnable[\"receiptSha256\"], \"Runnable target is not approved with this ordinary proof\")\n     source_before = source(env)\n     require(read(env, \"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == \"HEAD\", \"Proof checkout must be detached\")\n     require(read(env, \"node\", \"--version\") == \"v24.15.0\" and read(env, \"bun\", \"--version\") == \"1.3.14\", \"Pinned tools unavailable\")\n@@ -287,7 +306,7 @@\n     directory.chmod(0o700)\n     receipt = {\"status\": \"running\", \"startedAt\": now(), \"head\": entry[\"head\"], \"tree\": entry[\"tree\"], \"slotGrant\": args.slot_grant,\n                \"runnerSha256\": sha(Path(__file__)), \"planSha256\": sha(HERE / \"plan.json\"), \"inventorySha256\": INVENTORY_SHA,\n-               \"sourceBeforeSelection\": source_before, \"ordinaryReceiptCountValidated\": len(plan[\"entries\"]),\n+               \"sourceBeforeSelection\": source_before, \"ordinaryReceiptCountValidated\": len(plan[\"entries\"]), \"registeredPrefixCountValidated\": len(plan[\"registeredPrefixes\"]), \"historicalReceiptCountValidated\": len(plan[\"historicalOrdinaryEntries\"]),\n                \"project\": project, \"ports\": entry[\"ports\"], \"commands\": {}, \"artifacts\": {}, \"errors\": []}\n     save = lambda: private_json(directory / \"receipt.json\", receipt)\n     save()\n"},"started_
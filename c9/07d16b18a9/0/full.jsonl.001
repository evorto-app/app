\\\"paths\\\": unreadable}\\n        require(not unreadable, \\\"Tracked files are not Docker-readable; no mode repair is automatic\\\")\\n        receipt[\\\"artifacts\\\"][\\\"prior\\\"] = archive_artifacts(directory, \\\"prior\\\")\\n        runtime_path = directory / \\\"runtime.log\\\"\\n        receipt[\\\"runtime\\\"] = {\\\"command\\\": COMMANDS[\\\"runtime\\\"], \\\"startedAt\\\": now(), \\\"log\\\": runtime_path.name}\\n        runtime_log = os.fdopen(os.open(runtime_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), \\\"w\\\")\\n        runtime = subprocess.Popen(COMMANDS[\\\"runtime\\\"], cwd=ROOT, env=env, stdout=runtime_log, stderr=subprocess.STDOUT, start_new_session=True)\\n        receipt[\\\"runtime\\\"].update(pid=runtime.pid, pgid=runtime.pid)\\n        save()\\n        deadline = time.monotonic() + 1200\\n        while True:\\n            require(runtime.poll() is None, \\\"Runtime exited before readiness\\\")\\n            require(time.monotonic() < deadline, \\\"Runtime startup exceeded its bound\\\")\\n            try:\\n                with urllib.request.urlopen(\\\"http://localhost:4200/readyz\\\", timeout=2) as response:\\n                    if response.status == 204:\\n                        break\\n            except (urllib.error.URLError, TimeoutError):\\n                pass\\n            time.sleep(2)\\n        identity = runtime_identity(env, project, entry)\\n        receipt[\\\"runtime\\\"].update(identity=identity, readyAt=now())\\n        save()\\n        test_env = dict(env, NO_WEBSERVER=\\\"true\\\")\\n        for phase in (\\\"functional\\\", \\\"documentation\\\"):\\n            require(runtime.poll() is None and runtime_identity(env, project, entry) == identity, \\\"Owned runtime changed before suite\\\")\\n            try:\\n                run_command(phase, COMMANDS[phase], test_env, directory, 1200, receipt, save)\\n            finally:\\n                receipt[\\\"artifacts\\\"][phase] = archive_artifacts(directory, phase)\\n                save()\\n            require(runtime.poll() is None and runtime_identity(env, project, entry) == identity, \\\"Owned runtime changed during suite\\\")\\n        receipt[\\\"status\\\"] = \\\"passed-pending-cleanup\\\"\\n    except BaseException as error:\\n        receipt[\\\"errors\\\"].append(failure(error, \\\"execution\\\"))\\n        receipt[\\\"status\\\"] = \\\"failed\\\"\\n    finally:\\n        cleanup = {\\\"startedAt\\\": now(), \\\"errors\\\": []}\\n        if runtime is not None:\\n            try:\\n                cleanup[\\\"supervisor\\\"] = stop_owned(runtime, 300)\\n                require(cleanup[\\\"supervisor\\\"][\\\"exitCode\\\"] in (0, -15, 143), \\\"Runtime cleanup supervisor failed\\\")\\n                require(\\\"SIGKILL\\\" not in cleanup[\\\"supervisor\\\"][\\\"signals\\\"], \\\"Runtime required forced termination\\\")\\n            except BaseException as error:\\n                cleanup[\\\"errors\\\"].append(failure(error, \\\"supervisor\\\"))\\n        if runtime_log is not None:\\n            try:\\n                runtime_log.close()\\n            except BaseException as error:\\n                cleanup[\\\"errors\\\"].append(failure(error, \\\"runtime-log-close\\\"))\\n            try:\\n                receipt.setdefault(\\\"runtime\\\", {}).update(sha256=sha(directory / \\\"runtime.log\\\"), bytes=(directory / \\\"runtime.log\\\").stat().st_size)\\n            except BaseException as error:\\n                cleanup[\\\"errors\\\"].append(failure(error, \\\"runtime-log-metadata\\\"))\\n        try:\\n            cleanup[\\\"remainingResources\\\"] = resources(env, project)\\n            if any(cleanup[\\\"remainingResources\\\"].values()) and runtime is not None:\\n                # One owner-scoped recovery, never a successful gate or a test retry.\\n                cleanup[\\\"errors\\\"].append({\\\"phase\\\": \\\"supervisor-left-resources\\\", \\\"type\\\": \\\"RuntimeError\\\"})\\n                cleanup_command = [str(ROOT / \\\"node_modules/.bin/dotenv\\\"), \\\"-c\\\", \\\"dev\\\", \\\"--\\\", \\\"docker\\\", \\\"compose\\\",\\n                                   \\\"--project-name\\\", project, \\\"--file\\\", str(ROOT / \\\"docker-compose.yml\\\"),\\n                                   \\\"down\\\", \\\"--timeout\\\", \\\"60\\\", \\\"--remove-orphans\\\", \\\"--volumes\\\"]\\n                run_command(\\\"owned-cleanup-environment\\\", [\\\"bun\\\", \\\"run\\\", \\\"env:runtime\\\"], env, directory, 30, receipt, save)\\n                run_command(\\\"owned-cleanup-recovery\\\", cleanup_command, env, directory, 120, receipt, save)\\n                cleanup[\\\"afterRecoveryResources\\\"] = resources(env, project)\\n                require(not any(cleanup[\\\"afterRecoveryResources\\\"].values()), \\\"Owned resource recovery did not complete\\\")\\n            final_resources = cleanup.get(\\\"afterRecoveryResources\\\", cleanup[\\\"remainingResources\\\"])\\n            require(not any(final_resources.values()), \\\"Owned project cleanup incomplete; manual owner recovery required\\\")\\n            ports_free(entry[\\\"ports\\\"])\\n            cleanup[\\\"portsReleased\\\"] = True\\n        except BaseException as error:\\n            cleanup[\\\"errors\\\"].append(failure(error, \\\"resources\\\"))\\n        try:\\n            receipt[\\\"sourceAfter\\\"] = source(env, entry)\\n        except BaseException as error:\\n            cleanup[\\\"errors\\\"].append(failure(error, \\\"source\\\"))\\n        cleanup[\\\"completedAt\\\"] = now()\\n        receipt[\\\"cleanup\\\"] = cleanup\\n        receipt[\\\"status\\\"] = \\\"passed\\\" if receipt[\\\"status\\\"] == \\\"passed-pending-cleanup\\\" and not cleanup[\\\"errors\\\"] else \\\"failed\\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788569572.792203}}}

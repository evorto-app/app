tch=re.findall(r'(?m)^\\s*'+label+r'\\s+(\\d+) passed \\((\\d+)\\)\\s*$',raw);assert len(match)==1 and match[0][0]==match[0][1];counts[kind]=int(match[0][0])\n  bad=re.findall(r'(?m)^\\s*(?:Test Files|Tests)\\s+.*\\b(?:failed|skipped|todo|flaky|interrupted|fixme)\\b',raw);assert not bad\n  g.update(**counts,allCollectedPassed=True,incompleteSummaries=[])\n out['gates'][name]=g;out['retainedLogHashes'][g['log']]=g['sha256']\nf=d/'source-evidence.json';assert not f.exists();f.write_text(json.dumps(out,indent=2)+'\\n');f.chmod(0o600);print(json.dumps({'sha256':s(f),'server':out['gates']['server']['tests'],'app':out['gates']['app']['tests'],'allGroupsAbsent':True}))\nPY"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nimport json,hashlib,re,os,errno\nart=Path('/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review');d=art/'prefix-runtime-verification/ordinary-runs/02-08806f0b-a1';s=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();r=json.loads((d/'receipt.json').read_text());inv=art/'prefix-runtime-verification/post-replay-gates/ordinary-02-invocation.json';j=json.loads(inv.read_text());assert r['invocationSha256']==s(inv)\nassert r['status']=='source-gates-passed; root PG and image acceptance pending' and not r['errors'];assert r['head']==j['head'] and r['tree']==j['tree'];assert r['sourceBefore']==r['sourceAfter'] and not r['sourceAfter']['status'];assert len(r['commands'])==8\nout={k:r[k] for k in ['head','tree','parent','sourceBefore','sourceAfter','tools']};out.update(status='All fresh ordinary source gates passed; PG/image/runtime pending',sourceRunnerReceiptSha256=s(d/'receipt.json'),gates={},retainedLogHashes={},reviewedAt=datetime.now(timezone.utc).isoformat())\nfor step in j['commands']:\n name=step['name'];v=r['commands'][name];f=d/v['log'];assert s(f)==v['sha256'] and v['command']==step['command'];assert v['status']=='passed' and v['exitCode']==0 and v['processGroupAbsent'];g={'passed':True,'command':v['command'],'log':str(f.relative_to(art)),'sha256':v['sha256']}\n try:os.killpg(v['pgid'],0)\n except ProcessLookupError:pass\n else:raise AssertionError('Process group still present')\n if name in ['server','app']:\n  raw=re.sub(chr(27)+r'\\[[0-9;]*m','',f.read_text());counts={}\n  for kind,label in [('files','Test Files'),('tests','Tests')]:\n   match=re.findall(r'(?m)^\\s*'+label+r'\\s+(\\d+) passed \\((\\d+)\\)\\s*$',raw);assert len(match)==1 and match[0][0]==match[0][1];counts[kind]=int(match[0][0])\n  bad=re.findall(r'(?m)^\\s*(?:Test Files|Tests)\\s+.*\\b(?:failed|skipped|todo|flaky|interrupted|fixme)\\b',raw);assert not bad\n  g.update(**counts,allCollectedPassed=True,incompleteSummaries=[])\n out['gates'][name]=g;out['retainedLogHashes'][g['log']]=g['sha256']\nf=d/'source-evidence.json';assert not f.exists();f.write_text(json.dumps(out,indent=2)+'\\n');f.chmod(0o600);print(json.dumps({'sha256':s(f),'server':out['gates']['server']['tests'],'app':out['gates']['app']['tests'],'allGroupsAbsent':True}))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"{\"sha256\": \"4cad77be0ee2027d538a21e1fbf48fc68f20b7401fc7741f87f37f64f259c2f1\", \"server\": 1394, \"app\": 802, \"allGroupsAbsent\": true}\n","stderr":"","aggregated_output":"{\"sha256\": \"4cad77be0ee2027d538a21e1fbf48fc68f20b7401fc7741f87f37f64f259c2f1\", \"server\": 1394, \"app\": 802, \"allGroupsAbsent\": true}\n","exit_code":0,"duration":{"secs":0,"nanos":3958},"formatted_output":"{\"sha256\": \"4cad77be0ee2027d538a21e1fbf48fc68f20b7401fc7741f87f37f64f259c2f1\", \"server\": 1394, \"app\": 802, \"allGroupsAbsent\": true}\n"},"started_at_ms":1788571534185,"completed_at_ms":1788571534185}}

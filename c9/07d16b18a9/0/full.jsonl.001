a9e/evorto-stack-review');repo=art.parent/'evorto-stack-main';expected=sys.argv[1];prefix=sys.argv[2]\\ndef git(*args):return subprocess.check_output(['git',*args],cwd=repo,text=True).strip()\\ndef source():return {'head':git('rev-parse','HEAD'),'tree':git('rev-parse','HEAD^{tree}'),'status':git('status','--porcelain')}\\nbefore=source();assert before['head']==expected and not before['status']\\ns=json.loads((art/'postgres-state.json').read_text());assert s['container_id']=='aba217723c41d26b0989b64eff5a95d6726cf17cbd96fa7b00026d0dc6265ae0'\\nactual=json.loads(subprocess.check_output(['docker','inspect',s['container_id']],text=True))[0];assert actual['State']['Running'] and actual['Name']=='/'+s['name']\\nenv=os.environ.copy();env['PATH']='/Users/hedde/.nvm/versions/node/v24.15.0/bin:/Users/hedde/.bun/bin:'+env['PATH'];env.update(CI='true',APP_HOST_PORT='4200',POSTGRES_HOST_PORT=str(s['port']),POSTGRES_INTEGRATION_DISPOSABLE='true',POSTGRES_INTEGRATION_DATABASE_URL='postgresql://'+quote(s['user'],safe='')+':'+quote(s['password'],safe='')+'@127.0.0.1:'+str(s['port'])+'/'+s['database'])\\nassert subprocess.check_output(['node','--version'],env=env,text=True).strip()=='v24.15.0'\\nlog=art/(prefix+'-postgres.log');receipt=art/(prefix+'-postgres-evidence.json');assert not log.exists() and not receipt.exists()\\nd={'head':expected,'tree':before['tree'],'sourceBefore':before,'databaseContainerId':s['container_id'],'command':['bun','run','test:integration:postgres'],'startedAt':datetime.now(timezone.utc).isoformat(),'status':'running'}\\ndef save():receipt.write_text(json.dumps(d,indent=2)+chr(10));receipt.chmod(0o600)\\nsave();t=time.monotonic()\\nwith log.open('x') as f:\\n log.chmod(0o600);r=subprocess.run(d['command'],cwd=repo,env=env,stdout=f,stderr=subprocess.STDOUT)\\nraw=re.sub(chr(27)+r'\\\\[[0-9;]*m','',log.read_text());summary=[l for l in raw.splitlines() if re.search(r'Test Files|Tests  |Duration|complete-run|Failed Tests',l)]\\nd.update(status='passed' if r.returncode==0 else 'failed',exitCode=r.returncode,seconds=round(time.monotonic()-t,3),log=log.name,sha256=hashlib.sha256(log.read_bytes()).hexdigest(),summary=summary,sourceAfter=source(),completedAt=datetime.now(timezone.utc).isoformat());save();assert d['sourceAfter']==before\\nprint(json.dumps({k:d[k] for k in ['head','status','exitCode','seconds','summary','sourceAfter']},indent=2))\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a06cdc-6399-7b30-9fa8-4b87f0cfba0e","create_time":1788571508.078297}}}

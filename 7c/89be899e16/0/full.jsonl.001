one\n if types:\n  t={k:types.get(k) for k in ['roots','diagnostics','firstPartySources','script','scriptSha256','rootsFile','rootsFileSha256','optionsProvenance']}\n  assert types['exitCode']==0 and types['diagnostics']==0\n  for pathkey,hashkey in [('log','sha256'),('script','scriptSha256'),('rootsFile','rootsFileSha256')]:\n   assert sha(r/types[pathkey])==types[hashkey]\n  actual=json.loads((r/types['log']).read_text());assert actual['diagnostics']==0 and actual['roots']==types['roots'] and actual['firstPartySources']==types['firstPartySources']\n out.append({'layer':row['layer'],'oldHead':x['oldHead'],'newHead':x['head'],'tree':x['tree'],'actualCompleteTreeEquality':True,'originalReceipt':str(ep),'originalReceiptSha256':sha(ep),'originalCompletedAt':v.get('completedAt',v.get('completed_at')),'runtime':v.get('runtime',v.get('host_runtime')),'unitGates':checks,'strictEvidenceHashAndCountAudit':t,'status':'Full-unit original logs and tree equality verified; final admission awaits full command/dependency audit and fresh activation'})\np=d/'root-historical-unit-log-review.json'\nwith p.open('x') as f:json.dump({'reviewedAt':datetime.now(timezone.utc).isoformat(),'records':out,'noNewExecution':True,'postgresAdmission':'Separate; original cleanup proof required or perform fresh PG','nested12a':'Independent audit pending'},f,indent=2);f.write('\\n')\np.chmod(0o600)\nprint(json.dumps({'path':str(p),'sha256':sha(p),'layers':len(out),'fullUnitLogs':sum(len(x['unitGates']) for x in out),'strictLogAndProbeHashChecks':sum(x['strictEvidenceHashAndCountAudit'] is not None for x in out)}))\nPY"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nimport json,hashlib,subprocess,re\nr=Path('/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review');d=r/'prefix-runtime-verification/post-replay-gates';out=[]\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdi
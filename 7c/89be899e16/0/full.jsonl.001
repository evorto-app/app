,'reviewedAt':datetime.now(timezone.utc).isoformat()};f=p/'source-evidence.json';f.write_text(json.dumps(record,indent=2)+'\\n');f.chmod(0o600);print(json.dumps({'sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'server':gates['server']['tests'],'app':gates['app']['tests'],'head':v['head']}))\nPY"],"cwd":"file:///Users/hedde/.codex/worktrees/aa9e/evorto","parsed_cmd":[{"type":"unknown","cmd":"python3 - <<'PY'\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nimport json,hashlib,re,os\nr=Path('/Users/hedde/.codex/worktrees/aa9e/evorto-stack-review');p=r/'prefix-runtime-verification/ordinary-runs/01-3ad029b3-a1';v=json.loads((p/'receipt.json').read_text());assert v['errors']==[] and v['sourceBefore']==v['sourceAfter'] and v['sourceAfter']['status']=='';gates={};logs={}\nfor name,x in v['commands'].items():\n assert x['status']=='passed' and x['exitCode']==0 and x['processGroupAbsent'];f=p/x['log'];h=hashlib.sha256(f.read_bytes()).hexdigest();assert h==x['sha256'];logs[str(f.relative_to(r))]=h\n try:os.killpg(x['pgid'],0)\n except ProcessLookupError:pass\n else:raise RuntimeError('Command group remains')\n g={'passed':True,'command':x['command'],'log':str(f.relative_to(r)),'sha256':h}\n if name in ['server','app']:\n  s=re.sub(r'\\x1b\\[[0-9;]*m','',f.read_text())\n  for label,key in [('Test Files','files'),('Tests','tests')]:\n   lines=[line.strip() for line in s.splitlines() if re.match(r'^\\s*'+label+r'\\s+\\d',line)];assert len(lines)==1\n   m=re.fullmatch(label+r'\\s+(\\d+) passed \\((\\d+)\\)',lines[0]);assert m and m[1]==m[2] and int(m[1])>0;g[key]=int(m[1])\n  g['allCollectedPassed']=True;g['incompleteSummaries']=[]\n gates[name]=g\nassert len(gates)==8\nrecord={'status':'All fresh ordinary source gates passed; PG/image/runtime pending','head':v['head'],'tree':v['tree'],'parent':v['parent'],'sourceBefore':v['sourceBefore'],'sourceAfter':v['sourceAfter'],'tools':v['tools'],'sourceRunnerReceiptSha256':hashlib.sha256((p/'receipt.json').read_bytes()).hexdigest(),'gates':gates,'retainedLogHashes':logs,'reviewedAt':datetime.now(timezone.utc).isoformat()};f=p/'source-evidence.json';f.write_text(json.dumps(record,indent=2)+'\\n');f.chmod(0o600);print(json.dumps({'sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'server':gates['server']['tests'],'app':gates['app']['tests'],'head':v['head']}))\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"{\"sha256\": \"9d3b4371e881018a416a3120deaef4f99b8e3f89c7b3c48eca7c6e5cb241fb6c\", \"server\": 1351, \"app\": 802, \"head\": \"3ad029b3b8fd705974bfa438b0e548fe67cf0f45\"}\n","stderr":"","aggregated_output":"{\"sha256\": \"9d3b4371e881018a416a3120deaef4f99b8e3f89c7b3c48eca7c6e5cb241fb6c\", \"server\": 1351, \"app\": 802, \"head\": \"3ad029b3b8fd705974bfa438b0e548fe67cf0f45\"}\n","exit_code":0,"duration":{"secs":0,"nanos":4208},"formatted_output":"{\"sha256\": \"9d3b4371e881018a416a3120deaef4f99b8e3f89c7b3c48eca7c6e5cb241fb6c\", \"server\": 1351, \"app\": 802, \"head\": \"3ad029b3b8fd705974bfa438b0e548fe67cf0f45\"}\n"},"started_at_ms":1788570361130,"completed_at_ms":1788570361131}}

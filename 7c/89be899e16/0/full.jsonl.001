\n                require(cleanup[\"supervisor\"][\"exitCode\"] in (0, -15, 143), \"Runtime cleanup supervisor failed\")\n                require(\"SIGKILL\" not in cleanup[\"supervisor\"][\"signals\"], \"Runtime required forced termination\")\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"supervisor\"))\n        if runtime_log is not None:\n            try:\n                runtime_log.close()\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"runtime-log-close\"))\n            try:\n                receipt.setdefault(\"runtime\", {}).update(sha256=sha(directory / \"runtime.log\"), bytes=(directory / \"runtime.log\").stat().st_size)\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"runtime-log-metadata\"))\n        try:\n            cleanup[\"remainingResources\"] = resources(env, project)\n            if any(cleanup[\"remainingResources\"].values()) and runtime is not None:\n                # One owner-scoped recovery, never a successful gate or a test retry.\n                cleanup[\"errors\"].append({\"phase\": \"supervisor-left-resources\", \"type\": \"RuntimeError\"})\n                cleanup_command = [str(ROOT / \"node_modules/.bin/dotenv\"), \"-c\", \"dev\", \"--\", \"docker\", \"compose\",\n                                   \"--project-name\", project, \"--file\", str(ROOT / \"docker-compose.yml\"),\n                                   \"down\", \"--timeout\", \"60\", \"--remove-orphans\", \"--volumes\"]\n                run_command(\"owned-cleanup-environment\", [\"bun\", \"run\", \"env:runtime\"], env, directory, 30, receipt, save)\n                run_command(\"owned-cleanup-recovery\", cleanup_command, env, directory, 120, receipt, save)\n                cleanup[\"afterRecoveryResources\"] = resources(env, project)\n                require(not any(cleanup[\"afterRecoveryResources\"].values()), \"Owned resource recovery did not complete\")\n            final_resources = cleanup.get(\"afterRecoveryResources\", cleanup[\"remainingResources\"])\n            require(not any(final_resources.values()), \"Owned project cleanup incomplete; manual owner recovery required\")\n            ports_free(entry[\"ports\"])\n            cleanup[\"portsReleased\"] = True\n        except BaseException as error:\n            cleanup[\"errors\"].append(failure(error, \"resources\"))\n        try:\n            receipt[\"sourceAfter\"] = source(env, entry)\n        except BaseException as error:\n            cleanup[\"errors\"].append(failure(error, \"source\"))\n        cleanup[\"completedAt\"] = now()\n        receipt[\"cleanup\"] = cleanup\n        receipt[\"status\"] = \"passed\" if receipt[\"status\"] == \"passed-pending-cleanup\" and not cleanup[\"errors\"] else \"failed\"\n","exit_code":0,"duration":{"secs":0,"nanos":3375},"formatted_output":"            \"project\": project, \"workingDirectory\": labels[\"com.docker.compose.project.working_dir\"], \"readinessStatus\": 204}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--head\", required=True)\n    parser.add_argument(\"--attempt\", default=\"a1\")\n    parser.add_argument(\"--execute\", action=\"store_true\")\n    parser.add_argument(\"--slot-grant\", help=\"Record the actual explicit root slot grant; elapsed time is not a grant\")\n    args = parser.parse_args()\n    plan = json.loads((HERE / \"plan.json\").read_text())\n    matches = [entry for entry in plan[\"entries\"] if entry[\"head\"] == args.head]\n    require(len(matches) == 1 and re.fullmatch(r\"[a-z0-9]{1,8}\", args.attempt), \"Unknown exact head or invalid attempt label\")\n    entry = matches[0]\n    project = \"evorto-prefix-\" + entry[\"layerLabel\"] + \"-\" + args.head[:8] + \"-\" + args.attempt\n    if not args.execute:\n        print(json.dumps({\"status\": \"prepared only\", \"head\": args.head, \"tree\": entry[\"tree\"], \"project\": project,\n                          \"ports\": entry[\"ports\"], \"commands\": COMMANDS, \"explicitSlotGrantRequired\": True}, indent=2))\n        return\n    require(bool(args.slot_grant), \"An explicit root slot grant is required\")\n    os.umask(0o022)  # Git files remain readable in Docker; logs/artifact parents are separately private.\n    env = environment(entry[\"ports\"], project)\n    with (HERE / \"proof-runtime.lock\").open(\"a+\") as lease:\n        os.chmod(lease.name, 0o600)\n        try:\n            fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            execute(plan, entry, args, project, env)\n        except BaseException as error:\n            # Preserve even failures before checkout/runtime ownership was acquired.\n            blocked = HERE / \"blocked\"\n            blocked.mkdir(exist_ok=True, mode=0o700)\n            path = blocked / (entry[\"layerLabel\"] + \"-\" + args.head[:8] + \"-\" + args.attempt + \"-\" + str(time.time_ns()) + \".json\")\n            private_json(path, {\"status\": \"invocation-failed\", \"head\": args.head, \"at\": now(),\n                                \"error\": failure(error, \"invocation\"), \"slotGrant\": args.slot_grant})\n            print(json.dumps({\"status\": \"failed\", \"failureReceipt\": str(path)}))\n            raise\n\n\ndef execute(plan, entry, args, project, env):\n    inventory_path = REVIEW / plan[\"inventory\"][\"path\"]\n    require(plan[\"inventory\"][\"sha256\"] == INVENTORY_SHA and sha(inventory_path) == INVENTORY_SHA, \"Inventory changed\")\n    inventory = json.loads(inventory_path.read_text())\n    identity_keys = (\"layer\", \"branch\", \"head\", \"ordinaryReceipt\", \"receiptSha256\")\n    require(plan[\"historicalOrdinaryEntries\"] == inventory[\"heads\"], \"Historical ordinary receipt bindings changed\")\n    for historical in plan[\"historicalOrdinaryEntries\"]:\n        require(sha(REVIEW / historical[\"ordinaryReceipt\"]) == historical[\"receiptSha256\"], \"A historical ordinary receipt changed\")\n    stack_path = REVIEW / \"current-local-stack.json\"\n    require(sha(stack_path) == plan[\"sourceStackReceiptSha256\"], \"Stack inventory changed; refresh the reviewed plan\")\n    stack = json.loads(stack_path.read_text())\n    ref_keys = (\"layer\", \"branch\", \"head\", \"tree\")\n    expected_refs = [{key: str(row[key]) if key == \"layer\" else row[key] for key in ref_keys} for row in stack[\"layers\"]]\n    require([{key: row[key] for key in ref_keys} for row in plan[\"registeredPrefixes\"]] == expected_refs, \"Plan does not bind every registered prefix\")\n    require(plan[\"commands\"] == COMMANDS, \"Canonical commands changed\")\n    for current in plan[\"registeredPrefixes\"]:\n        require(read(env, \"git\", \"rev-parse\", \"refs/heads/\" + current[\"branch\"]) == current[\"head\"], \"A registered prefix head changed\")\n        require(read(env, \"git\", \"rev-parse\", current[\"head\"] + \"^{tree}\") == current[\"tree\"], \"A registered prefix tree changed\")\n        package = json.loads(read(env, \"git\", \"show\", current[\"head\"] + \":package.json\"))\n        require(all(package[\"scripts\"][key] == value for key, value in current[\"canonicalScripts\"].items()), \"A canonical script binding changed\")\n    require(len({row[\"head\"] for row in plan[\"entries\"]}) == len(plan[\"entries\"]), \"Duplicate runnable head\")\n    for runnable in plan[\"entries\"]:\n        registered = [row for row in plan[\"registeredPrefixes\"] if row[\"head\"] == runnable[\"head\"]]\n        require(len(registered) == 1 and all(runnable[key] == registered[0][key] for key in ref_keys), \"Runnable target is not an exact registered prefix\")\n        receipt_path = REVIEW / runnable[\"ordinaryReceipt\"]\n        require(sha(receipt_path) == runnable[\"receiptSha256\"], \"A runnable ordinary receipt changed\")\n        ordinary = json.loads(receipt_path.read_text())\n        require(ordinary[\"head\"] == runnable[\"head\"] and ordinary[\"tree\"] == runnable[\"tree\"], \"Ordinary proof is not bound to the runnable identity\")\n        approval_path = REVIEW / runnable[\"readinessApproval\"]\n        require(sha(approval_path) == runnable[\"readinessApprovalSha256\"], \"Readiness approval changed\")\n        approval = json.loads(approval_path.read_text())\n        require(approval[\"status\"] == \"approved\" and approval[\"head\"] == runnable[\"head\"] and approval[\"tree\"] == runnable[\"tree\"] and approval[\"ordinaryReceiptSha256\"] == runnable[\"receiptSha256\"], \"Runnable target is not approved with this ordinary proof\")\n    source_before = source(env)\n    require(read(env, \"git\", \"rev-parse\", \"--abbrev-ref\", \"HEAD\") == \"HEAD\", \"Proof checkout must be detached\")\n    require(read(env, \"node\", \"--version\") == \"v24.15.0\" and read(env, \"bun\", \"--version\") == \"1.3.14\", \"Pinned tools unavailable\")\n    require((ROOT / \".env\").is_file() and not (ROOT / \".env\").is_symlink(), \"Existing local credential file required\")\n    require(stat.S_IMODE((ROOT / \".env\").stat().st_mode) & 0o077 == 0, \"Credential file must be private\")\n    for override in (\"docker-compose.override.yml\", \"docker-compose.override.yaml\", \"compose.override.yml\", \"compose.override.yaml\"):\n        require(not (ROOT / override).exists(), \"Unexpected Compose override file\")\n    require(not any(resources(env, project).values()), \"Proposed project already has resources\")\n    ports_free(entry[\"ports\"])\n    directory = HERE / \"runs\" / (entry[\"layerLabel\"] + \"-\" + args.head[:8] + \"-\" + args.attempt)\n    directory.mkdir(parents=True, exist_ok=False, mode=0o700)\n    directory.chmod(0o700)\n    receipt = {\"status\": \"running\", \"startedAt\": now(), \"head\": entry[\"head\"], \"tree\": entry[\"tree\"], \"slotGrant\": args.slot_grant,\n               \"runnerSha256\": sha(Path(__file__)), \"planSha256\": sha(HERE / \"plan.json\"), \"inventorySha256\": INVENTORY_SHA,\n               \"sourceBeforeSelection\": source_before, \"ordinaryReceiptCountValidated\": len(plan[\"entries\"]), \"registeredPrefixCountValidated\": len(plan[\"registeredPrefixes\"]), \"historicalReceiptCountValidated\": len(plan[\"historicalOrdinaryEntries\"]),\n               \"project\": project, \"ports\": entry[\"ports\"], \"commands\": {}, \"artifacts\": {}, \"errors\": []}\n    save = lambda: private_json(directory / \"receipt.json\", receipt)\n    save()\n    runtime = None\n    runtime_log = None\n    try:\n        run_command(\"checkout\", [\"git\", \"switch\", \"--detach\", entry[\"head\"]], env, directory, 60, receipt, save)\n        receipt[\"sourceSelected\"] = source(env, entry)\n        run_command(\"install\", COMMANDS[\"install\"], env, directory, 300, receipt, save)\n        source(env, entry)\n        unreadable = []\n        indexed = read(env, \"git\", \"ls-files\", \"--stage\", \"-z\")\n        for item in indexed.split(\"\\0\"):\n            if not item:\n                continue\n            header, relative = item.split(\"\\t\", 1)\n            mode = header.split(\" \", 1)[0]\n            path = ROOT / relative\n            if mode in (\"100644\", \"100755\") and not path.name.startswith(\".env\"):\n                expected_mode = 0o644 if mode == \"100644\" else 0o755\n                if stat.S_IMODE(path.stat().st_mode) & expected_mode != expected_mode:\n                    unreadable.append(relative)\n        receipt[\"trackedFileReadability\"] = {\"unreadableCount\": len(unreadable), \"paths\": unreadable}\n        require(not unreadable, \"Tracked files are not Docker-readable; no mode repair is automatic\")\n        receipt[\"artifacts\"][\"prior\"] = archive_artifacts(directory, \"prior\")\n        runtime_path = directory / \"runtime.log\"\n        receipt[\"runtime\"] = {\"command\": COMMANDS[\"runtime\"], \"startedAt\": now(), \"log\": runtime_path.name}\n        runtime_log = os.fdopen(os.open(runtime_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), \"w\")\n        runtime = subprocess.Popen(COMMANDS[\"runtime\"], cwd=ROOT, env=env, stdout=runtime_log, stderr=subprocess.STDOUT, start_new_session=True)\n        receipt[\"runtime\"].update(pid=runtime.pid, pgid=runtime.pid)\n        save()\n        deadline = time.monotonic() + 1200\n        while True:\n            require(runtime.poll() is None, \"Runtime exited before readiness\")\n            require(time.monotonic() < deadline, \"Runtime startup exceeded its bound\")\n            try:\n                with urllib.request.urlopen(\"http://localhost:4200/readyz\", timeout=2) as response:\n                    if response.status == 204:\n                        break\n            except (urllib.error.URLError, TimeoutError):\n                pass\n            time.sleep(2)\n        identity = runtime_identity(env, project, entry)\n        receipt[\"runtime\"].update(identity=identity, readyAt=now())\n        save()\n        test_env = dict(env, NO_WEBSERVER=\"true\")\n        for phase in (\"functional\", \"documentation\"):\n            require(runtime.poll() is None and runtime_identity(env, project, entry) == identity, \"Owned runtime changed before suite\")\n            try:\n                run_command(phase, COMMANDS[phase], test_env, directory, 1200, receipt, save)\n            finally:\n                receipt[\"artifacts\"][phase] = archive_artifacts(directory, phase)\n                save()\n            require(runtime.poll() is None and runtime_identity(env, project, entry) == identity, \"Owned runtime changed during suite\")\n        receipt[\"status\"] = \"passed-pending-cleanup\"\n    except BaseException as error:\n        receipt[\"errors\"].append(failure(error, \"execution\"))\n        receipt[\"status\"] = \"failed\"\n    finally:\n        cleanup = {\"startedAt\": now(), \"errors\": []}\n        if runtime is not None:\n            try:\n                cleanup[\"supervisor\"] = stop_owned(runtime, 300)\n                require(cleanup[\"supervisor\"][\"exitCode\"] in (0, -15, 143), \"Runtime cleanup supervisor failed\")\n                require(\"SIGKILL\" not in cleanup[\"supervisor\"][\"signals\"], \"Runtime required forced termination\")\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"supervisor\"))\n        if runtime_log is not None:\n            try:\n                runtime_log.close()\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"runtime-log-close\"))\n            try:\n                receipt.setdefault(\"runtime\", {}).update(sha256=sha(directory / \"runtime.log\"), bytes=(directory / \"runtime.log\").stat().st_size)\n            except BaseException as error:\n                cleanup[\"errors\"].append(failure(error, \"runtime-log-metadata\"))\n        try:\n            cleanup[\"remainingResources\"] = resources(env, project)\n            if any(cleanup[\"remainingResources\"].values()) and runtime is not None:\n                # One owner-scoped recovery, never a successful gate or a test retry.\n                cleanup[\"errors\"].append({\"phase\": \"supervisor-left-resources\", \"type\": \"RuntimeError\"})\n                cleanup_command = [str(ROOT / \"node_modules/.bin/dotenv\"), \"-c\", \"dev\", \"--\", \"docker\", \"compose\",\n                                   \"--project-name\", project, \"--file\", str(ROOT / \"docker-compose.yml\"),\n                                   \"down\", \"--timeout\", \"60\", \"--remove-orphans\", \"--volumes\"]\n                run_command(\"owned-cleanup-environment\", [\"bun\", \"run\", \"env:runtime\"], env, directory, 30, receipt, save)\n                run_command(\"owned-cleanup-recovery\", cleanup_command, env, directory, 120, receipt, save)\n                cleanup[\"afterRecoveryResources\"] = resources(env, project)\n                require(not any(cleanup[\"afterRecoveryResources\"].values()), \"Owned resource recovery did not complete\")\n            final_resources = cleanup.get(\"afterRecoveryResources\", cleanup[\"remainingResources\"])\n            require(not any(final_resources.values()), \"Owned project cleanup incomplete; manual owner recovery required\")\n            ports_free(entry[\"ports\"])\n            cleanup[\"portsReleased\"] = True\n        except BaseException as error:\n            cleanup[\"errors\"].append(failure(error, \"resources\"))\n        try:\n            receipt[\"sourceAfter\"] = source(env, entry)\n        except BaseException as error:\n            cleanup[\"errors\"].append(failure(error, \"source\"))\n        cleanup[\"completedAt\"] = now()\n        receipt[\"cleanup\"] = cleanup\n        receipt[\"status\"] = \"passed\" if receipt[\"status\"] == \"passed-pending-cleanup\" and not cleanup[\"errors\"] else \"failed\"\n"},"started_at_ms":1788569572788,"completed_at_ms":1788569572788}}

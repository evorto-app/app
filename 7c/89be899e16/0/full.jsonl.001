/hedde/.bun/bin:\" + env[\"PATH\"]\n    env.update({key: str(value) for key, value in ports.items()})\n    env[\"COMPOSE_PROJECT_NAME\"] = project\n    env[\"E2E_RUNTIME_MODE\"] = \"playwright\"\n    env[\"E2E_USE_DOCKER_STACK\"] = \"true\"\n    return env\n\n\ndef read(env, *args):\n    # Capture read-only command output; never echo config values or Docker Env.\n    result = subprocess.run(args, cwd=ROOT, env=env, capture_output=True, text=True, timeout=30)\n    require(result.returncode == 0, \"Read-only command failed: \" + args[0])\n    return result.stdout.strip()\n\n\ndef source(env, expected=None):\n    value = {\"head\": read(env, \"git\", \"rev-parse\", \"HEAD\"),\n             \"tree\": read(env, \"git\", \"rev-parse\", \"HEAD^{tree}\"),\n             \"status\": read(env, \"git\", \"status\", \"--porcelain=v1\", \"--untracked-files=all\")}\n    require(not value[\"status\"], \"Proof checkout is not clean\")\n    if expected:\n        require(value[\"head\"] == expected[\"head\"] and value[\"tree\"] == expected[\"tree\"], \"Source head/tree drift\")\n    return value\n\n\ndef resources(env, project):\n    label = \"label=com.docker.compose.project=\" + project\n    return {\n        \"containers\": read(env, \"docker\", \"ps\", \"-aq\", \"--filter\", label).splitlines(),\n        \"networks\": read(env, \"docker\", \"network\", \"ls\", \"-q\", \"--filter\", label).splitlines(),\n        \"volumes\": read(env, \"docker\", \"volume\", \"ls\", \"-q\", \"--filter\", label).splitlines(),\n    }\n\n\ndef ports_free(ports):\n    for port in ports.values():\n        for family, host in ((socket.AF_INET, \"127.0.0.1\"), (socket.AF_INET6, \"::1\")):\n            with socket.socket(family) as sock:\n                sock.settimeout(1)\n                require(sock.connect_ex((host, port)) != 0, \"Required loopback port is occupied: \" + str(port))\n\n\ndef group_exists(proc):\n    try:\n        os.killpg(proc.pid, 0)\n        return True\n    except ProcessLookupError:\n        return False\n\n\ndef stop_owned(proc, seconds):\n    actions = []\n","stderr":"","aggregated_output":"def private_json(path, value):\n    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), \"w\") as handle:\n        json.dump(value, handle, indent=2)\n        handle.write(\"\\n\")\n    path.chmod(0o600)\n\n\ndef failure(error, phase):\n    value = {\"phase\": phase, \"type\": type(error).__name__}\n    if isinstance(error, RuntimeError):\n        value[\"reason\"] = str(error)  # Only our fixed, non-secret validation messages.\n    return value\n\n\ndef environment(ports, project):\n    env = dict(os.environ)\n    for key in list(env):\n        if key.startswith((\"COMPOSE_\", \"PLAYWRIGHT_\", \"PW_\", \"DOCS_\")) or key in {\n            \"CI\", \"NO_WEBSERVER\", \"E2E_SELECTED_PROJECTS\", \"E2E_SHARD\",\n            \"NODE_OPTIONS\", \"BUN_OPTIONS\", \"E2E_RUNTIME_MODE\", \"E2E_USE_DOCKER_STACK\",\n            \"GITHUB_RUN_ID\", \"GITHUB_RUN_ATTEMPT\", \"BASE_URL\", \"SSR_RPC_ORIGIN\",\n            \"DATABASE_URL\", \"POSTGRES_INTEGRATION_DATABASE_URL\", \"EVORTO_PAGES_ROOT\",\n        }:\n            env.pop(key)\n    env[\"PATH\"] = \"/Users/hedde/.nvm/versions/node/v24.15.0/bin:/Users/hedde/.bun/bin:\" + env[\"PATH\"]\n    env.update({key: str(value) for key, value in ports.items()})\n    env[\"COMPOSE_PROJECT_NAME\"] = project\n    env[\"E2E_RUNTIME_MODE\"] = \"playwright\"\n    env[\"E2E_USE_DOCKER_STACK\"] = \"true\"\n    return env\n\n\ndef read(env, *args):\n    # Capture read-only command output; never echo config values or Docker Env.\n    result = subprocess.run(args, cwd=ROOT, env=env, capture_output=True, text=True, timeout=30)\n    require(result.returncode == 0, \"Read-only command failed: \" + args[0])\n    return result.stdout.strip()\n\n\ndef source(env, expected=None):\n    value = {\"head\": read(env, \"git\", \"rev-parse\", \"HEAD\"),\n             \"tree\": read(env, \"git\", \"rev-parse\", \"HEAD^{tree}\"